{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2024-03-07T14:00:13",
      "utterance": "こんにちは。相談員です。",
      "tag": "Greeting"
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:00:32",
      "utterance": "本日はどのようなご相談でしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:01:00",
      "utterance": "消えたい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:02:37",
      "utterance": "消えたくなるくらい、凄く悩まれているのですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:03:05",
      "utterance": "はい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:03:34",
      "utterance": "ちょっとずつでもいいので、お話しすることはできますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:03:46",
      "utterance": "はい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:05:04",
      "utterance": "お聞きしておりますので、お話しください。",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:05:33",
      "utterance": "消えてなくなりたいんですよ",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:06:00",
      "utterance": "そうなのですね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:06:25",
      "utterance": "どうして、消えてなくなってしまいたいのですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:06:57",
      "utterance": "生きることがしんどいからです",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:07:45",
      "utterance": "しんどくなることもありますよね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:08:40",
      "utterance": "そのように思われるようになったのは、何がありました？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:09:59",
      "utterance": "社会から見放されてる",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:10:33",
      "utterance": "そのように感じられているのですね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:11:15",
      "utterance": "社会から見放されていると感じるのは、どのような時に感じますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:12:01",
      "utterance": "今もだし、ずっとです。",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:12:28",
      "utterance": "そうなのですね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:12:38",
      "utterance": "未来に希望もないので死ぬことを選択しようと思います",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:13:15",
      "utterance": "そのように思われているのですね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:14:42",
      "utterance": "そのような中でもご相談にきてくださり、大変うれしく思っております。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:15:36",
      "utterance": "そうですか",
      "distress_level": 3,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:15:55",
      "utterance": "はい。そのように感じたことなど、なんでもいいのでお話していただけると嬉しいです。",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:16:32",
      "utterance": "どうやって死ぬのが一番楽に死ねますか",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:18:08",
      "utterance": "死ぬことを考えてしまう状況なのですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:18:25",
      "utterance": "一応ロープは用意してますが、くるしそうなので",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:19:35",
      "utterance": "それは苦しいかと思いますね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:19:38",
      "utterance": "どうして死にたいと思うようになったのですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:19:58",
      "utterance": "生きていけないからですよ。",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:20:39",
      "utterance": "生きていけないぐらいの状況なのですね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:20:49",
      "utterance": "今はご自宅ですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:20:54",
      "utterance": "はい",
      "distress_level": 3,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:22:08",
      "utterance": "そうなのですね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:22:47",
      "utterance": "今はお一人ですか？ご家族はいらっしゃいますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:22:54",
      "utterance": "1人です",
      "distress_level": 3,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:23:48",
      "utterance": "そうなのですね。今のお気持ちを知っている方はいらっしゃいますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:24:25",
      "utterance": "いません。",
      "distress_level": 3,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:25:36",
      "utterance": "そうなのですね。今のお気持ちを私には教えてくださりありがとうございます。",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:26:12",
      "utterance": "アニキさんのお辛い思いなど、何があったのか私にお話しいただけると嬉しいです。",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:26:56",
      "utterance": "失業保険が3月で切れて、お金もない",
      "distress_level": 3,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:28:06",
      "utterance": "そうだったのですね。今のご自宅は、まだ住み続けることは可能ですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:28:32",
      "utterance": "出ていかないとけない",
      "distress_level": 3,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:29:04",
      "utterance": "いつには出ていかないといけないのですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:29:14",
      "utterance": "わからない、追い出されるまで",
      "distress_level": 3,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:30:09",
      "utterance": "そうなのですね。分からないとなると心配ですよね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:30:31",
      "utterance": "ご飯は食べられていますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:31:07",
      "utterance": "はい",
      "distress_level": 3,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:32:21",
      "utterance": "そうなのですね。ご飯は食べることができているようで安心しました。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:34:50",
      "utterance": "生きると金がかかるから死んだほうがいいでしょ",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:35:54",
      "utterance": "そのように思われているのですね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:36:31",
      "utterance": "お金のことがご心配ですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:37:26",
      "utterance": "お金は心配ですよ",
      "distress_level": 3,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:38:38",
      "utterance": "そうなのですね。今はアルバイトでも、何かお仕事されていますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:38:52",
      "utterance": "してない",
      "distress_level": 3,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:39:52",
      "utterance": "そうなのですね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:40:48",
      "utterance": "お仕事は探されたりしたですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:41:24",
      "utterance": "仕事はできないと思う",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:41:40",
      "utterance": "そう感じられているのですね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:42:04",
      "utterance": "どうしてできないと思われるのか、お話しいただけますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:42:49",
      "utterance": "パニックになったり過呼吸になったりするから",
      "distress_level": 3,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:43:23",
      "utterance": "そうだったのですね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:44:37",
      "utterance": "そのような状態になるのは、どうしてか分かっていらっしゃるのですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:44:48",
      "utterance": "わからない",
      "distress_level": 3,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:45:54",
      "utterance": "そうなのですね。お仕事中に、急にパニックになったりするのですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:46:21",
      "utterance": "はい",
      "distress_level": 3,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:46:37",
      "utterance": "パニックにならずにお仕事ができている時はありますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:47:00",
      "utterance": "最初だけ。いつもだめ",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2024-03-07T14:47:10",
      "utterance": "こんなやつ、生きる価値ないでしょ",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:47:37",
      "utterance": "最初はできているのですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:48:31",
      "utterance": "そのようなことはないですよ。私もお仕事でパニックになることはありますので。",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:48:47",
      "utterance": "私も同じですよ。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:49:20",
      "utterance": "そんなことないですよ。何がわかるんですか",
      "distress_level": 3,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:51:07",
      "utterance": "不快に感じられてしまったのなら申し訳ありません。",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:51:33",
      "utterance": "どれくらいしんどいのか、教えていただけますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:52:39",
      "utterance": "自分は仕事をしても続かない、お金も稼げない、死ぬしかないんです",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:54:01",
      "utterance": "そのように感じられてるのですね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:55:11",
      "utterance": "何でもいいので、これまで長続きしたことはありますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:55:27",
      "utterance": "ないです",
      "distress_level": 3,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:55:32",
      "utterance": "趣味とかでも大丈夫ですよ。",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2024-03-07T14:55:34",
      "utterance": "何もいいことのない人生でした",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:57:00",
      "utterance": "そう感じられているのですね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2024-03-07T14:59:39",
      "utterance": "今の状況を、ご相談できるご家族などはいらっしゃいますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-03-07T15:00:14",
      "utterance": "いません。今日は終わりにしたいです。ありがとうございました。",
      "distress_level": 3,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-03-07T15:01:09",
      "utterance": "いらっしゃらないのですね。承知しました。またいつでもよろしいので、ご相談にきてくださるとうれしいです。",
      "tag": "Suggest"
    },
    {
      "role": "counselor",
      "time": "2024-03-07T15:01:25",
      "utterance": "本日はありがとうございました。",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2024-03-07T15:01:36",
      "utterance": "（お疲れ様でした。）",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2024-03-07T15:02:00",
      "utterance": "（お疲れ様でした。ありがとうございました。）",
      "tag": "Thanking"
    }
