{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2020-12-31T12:01:14",
      "utterance": "こちらは、カウンセラーいじめテーマです。",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:01:27",
      "utterance": "こんにちはよろしくお願いします",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:01:34",
      "utterance": "こんにちはよろしくお願いします",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:02:02",
      "utterance": "こんにちは相談員ですよろしくお願いします",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:02:10",
      "utterance": "よろしくお願いします",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:02:17",
      "utterance": "お越しいただき、ありがとうございます",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:02:36",
      "utterance": "お願いします",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:02:36",
      "utterance": "今日は、どのようなご相談ですか",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:04:26",
      "utterance": "友人がクラスメートに「コロナ罹ったでしょ？」と言われています。実際は罹っていないので事実無根です",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-12-31T12:04:45",
      "utterance": "私は庇いましたが",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-12-31T12:05:02",
      "utterance": "ショックを受けている様子でした",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:05:19",
      "utterance": "そうなんですね・・・それは、不快に思われますよね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:05:35",
      "utterance": "ショックですよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:05:35",
      "utterance": "かわいそうです…",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-12-31T12:05:47",
      "utterance": "私もショックです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:05:54",
      "utterance": "そうですね",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:06:01",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:06:19",
      "utterance": "そのお友達は、仲が良いお友達ですか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:06:38",
      "utterance": "仲が良いです！",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:06:53",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:06:59",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:07:24",
      "utterance": "ちなみに、年齢、性別、何とお呼びしたらよろしいですか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:08:14",
      "utterance": "17歳、男、オオミソカと呼んでください",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:08:49",
      "utterance": "オオミソカさん、教えていただき、ありがとうございます",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:09:01",
      "utterance": "いいえー",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:09:32",
      "utterance": "そのような出来事があったのは、いつ頃ですか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:09:55",
      "utterance": "2週間ですね",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:10:08",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "utterance": "はい",
      "time": "2020-12-31T12:10:16",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:10:29",
      "utterance": "でも、許せない出来事ですよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:10:41",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:10:55",
      "utterance": "学校での出来事ですか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:11:19",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:11:37",
      "utterance": "クラスの中で、起きているのでしょうか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:12:11",
      "utterance": "そうです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:13:04",
      "utterance": "オオミソカさんからみていて、お友達は、毎日お辛い日々をお過ごしなんですね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:13:47",
      "utterance": "表情が暗く見えます",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:14:38",
      "utterance": "そうなんですね・・・それは、お辛そうですねオオミソカさんも、いつもそのお友達と、一緒に過ごしていらっしゃるのですね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:15:43",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:15:52",
      "utterance": "オオミソカさんは、そのような時があった時、どのようにしていらっしゃいますか",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:17:32",
      "utterance": "暴言を吐いた子に「そんなこと言わないで！」と言いましたが、",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:17:42",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:18:00",
      "utterance": "悪びれる様子がなかったことに腹が立ちました",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:18:28",
      "utterance": "そうなんですね・・・苦しかったですよね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:18:41",
      "utterance": "でも、",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:19:24",
      "utterance": "謝れば丸く収まるはずなのに、と思ってしまいます",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:20:22",
      "utterance": "そうですよねお友達がそのようになった時に、一緒にいて、味方になっていただき、そのお友達は、心から救われていらっしゃると思います",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:20:43",
      "utterance": "そうだといいです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:21:27",
      "utterance": "お友達は、心強いですね・・・おつらいでしょうが。",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:22:14",
      "utterance": "お友達は、いじめられている時に、どのような様子ですか",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:23:13",
      "utterance": "間違った噂が広がったので、ショックを受けていました",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:23:36",
      "utterance": "そうなんですね・・・悔しいし、悲しいですよね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:24:01",
      "utterance": "学校の先生は、そのことに、気がついているようですか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:25:08",
      "utterance": "担任は「間違った噂だから気にする必要ないよ！」と言っていますが",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:25:20",
      "utterance": "ええ、",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:25:32",
      "utterance": "「そりゃ気にするでしょ！」と内心思いました",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:25:57",
      "utterance": "そうですよね・・それは、ひどすぎますよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:26:25",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:27:22",
      "utterance": "お友達か、オオミソカさん、どちらか、学校の先生に話は出来ますか担任じゃなくても、養護の先生でも、教科の先生でも、どなたでも構いません",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:28:28",
      "utterance": "僕でしたらできますが",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:28:40",
      "utterance": "はい、よかったです",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:28:53",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:29:03",
      "utterance": "いじめは、絶対にあってはなりません",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:29:14",
      "utterance": "おっしゃる通りです",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:29:23",
      "utterance": "お友達は、全く悪くありません",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:29:41",
      "utterance": "その通りです！",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:30:10",
      "utterance": "オオミソカさんは、おともだちの、そのようなことを、学校の先生に話をしていただけますか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:30:19",
      "utterance": "できます",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:30:35",
      "utterance": "ありがとうございます",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:31:01",
      "utterance": "できることはなんでもしてあげたいです！",
      "distress_level": 0,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:32:25",
      "utterance": "出来ることは、何でもしたいという、オオミソカさんの、お気持ち、とても素晴らしいと思いますほんの少しでも、お友達の心、そして、オオミソカさんの心が、晴れることを応援しています",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:32:51",
      "utterance": "ありがとうございます！",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:33:01",
      "utterance": "そして、お友達のいじめがなくなることを、こころから、応援しています",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:33:31",
      "utterance": "頑張ってくださいね",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:33:31",
      "utterance": "ありがとうございます！他には何かありますか？",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "client",
      "time": "2020-12-31T12:33:56",
      "utterance": "些細なことでもしてあげたいです",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:34:37",
      "utterance": "ダメな場合は、証拠をもって、一緒に、警察の生活安全課に一緒に行ってあげてくださいね",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:34:53",
      "utterance": "分かりました！",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:34:59",
      "utterance": "シャープ９　１１０　です",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:35:11",
      "utterance": "いかがですか",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:35:12",
      "utterance": "ありがとうございます！",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:35:34",
      "utterance": "また、なにかありましたら、いらしてください",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:35:43",
      "utterance": "はい！",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:35:53",
      "utterance": "本日は、ご相談いただき、ありがとうございます",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:35:53",
      "utterance": "今日はありがとうございました！",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:36:02",
      "utterance": "ありがとうございました",
      "tag": "Thanking"
    },
    {
