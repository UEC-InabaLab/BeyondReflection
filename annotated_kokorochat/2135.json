{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2021-07-05T13:51:32",
      "utterance": "こんにちは。本日はよろしくお願い致します。",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2021-07-05T13:53:06",
      "utterance": "(よろしくお願いいたします。設定などでリクエストありますか？)",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-07-05T13:54:22",
      "utterance": "初めてですので、わかりません、、、このままで大丈夫です。",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2021-07-05T13:55:22",
      "utterance": "(はい了解です！)",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-07-05T13:57:03",
      "utterance": "j時間になりましたら、始めさせていただきますね。",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2021-07-05T13:57:45",
      "utterance": "(はいお願いいたします)",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:00:20",
      "utterance": "こんにちは、相談員です。本日はお越しいただきありがとうございます。よろしければ、年齢と性別を教えていただけますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:00:43",
      "utterance": "16歳　女子です",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:01:27",
      "utterance": "ありがとうございます。今日はどのようなご相談ですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:01:48",
      "utterance": "部活やめようか悩んでます",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:02:05",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:02:40",
      "utterance": "部活で何かあったか教えていただけますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:03:16",
      "utterance": "努力してもうまくならなくて辛いです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:03:31",
      "utterance": "そうんんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:04:12",
      "utterance": "因みに何の部活に入っているのでしょう？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:04:21",
      "utterance": "バスケです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:04:56",
      "utterance": "バスケ、激しいスポーツですね",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:05:26",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:05:58",
      "utterance": "具体的に教えていただけますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:06:26",
      "utterance": "例えば、ドリブルとか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:06:36",
      "utterance": "後輩が入ってきたんだけど、みんな上手で、追い抜かされそうです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:06:56",
      "utterance": "なるほど、そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:07:51",
      "utterance": "あなたのことは何と呼んでよいですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:08:08",
      "utterance": "のんです",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:08:16",
      "utterance": "のんさん",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:09:01",
      "utterance": "自分が上手くならないと、不安があるのでしょうか？",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:09:22",
      "utterance": "メンバーに入れないです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:09:36",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:10:16",
      "utterance": "試合のメンバーに入れなくて、悲しかったんですね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:11:00",
      "utterance": "まだメンバーには入ってますが、このままだと落とされる",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:12:05",
      "utterance": "一生懸命に練習しているのに、焦りもありそうですか？",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:12:21",
      "utterance": "焦ってます。すごく",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:12:33",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:12:37",
      "utterance": "でももう無理かも",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:13:41",
      "utterance": "高校二年生？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:13:47",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:14:29",
      "utterance": "じゃあ、来年の今頃までで引退かな？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:14:40",
      "utterance": "そうです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:15:03",
      "utterance": "何とかメンバーに入りたいですね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:15:19",
      "utterance": "はい、落ちたくないです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:15:33",
      "utterance": "せっかく今まで頑張ってきたんですもの",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:16:54",
      "utterance": "自分なりにできるだけのことはしてきたんですが、もうダメかもしれません",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-07-05T14:17:21",
      "utterance": "諦めてやめたほうがいいのかな",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:17:59",
      "utterance": "後輩のほうが上手く思えるのは、どんなことからでしょう？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:19:05",
      "utterance": "思うだけじゃなくて、確実に技術もあるし、優れています",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:19:17",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:20:38",
      "utterance": "今は、部活をやっていて、楽しくプレイできていないんですね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:21:07",
      "utterance": "そうですね。追い込まれてる感じです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-07-05T14:21:24",
      "utterance": "プレッシャーもあるし",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:21:30",
      "utterance": "それは苦しいですね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:21:41",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:22:26",
      "utterance": "先輩になって思うプレッシャーですね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:23:04",
      "utterance": "一年生のころは楽しんでできましたか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:23:44",
      "utterance": "そうですね。先輩に憧れて頑張ってました",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-07-05T14:24:03",
      "utterance": "今より楽しくやってたと思います",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-07-05T14:24:24",
      "utterance": "でも今もバスケは好きなんです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-07-05T14:24:35",
      "utterance": "でももう無理かも",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:25:01",
      "utterance": "二年生になって、後輩が入ると焦りを感じる、",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:25:37",
      "utterance": "二年生は何人くらいいるのですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:25:48",
      "utterance": "15人です",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:26:07",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:27:21",
      "utterance": "このことを、部活の子に相談したことは？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:27:37",
      "utterance": "あります",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:27:58",
      "utterance": "その時はなんて言ってました？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:28:09",
      "utterance": "でも、頑張るしかないよって言われました",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:28:21",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:28:47",
      "utterance": "でも、大好きでとっても頑張っていますよね",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:29:53",
      "utterance": "はい、やれるだけのことはやってるつもりです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:30:58",
      "utterance": "メンバーに入れるか、とても気になると思います",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:31:42",
      "utterance": "そのことで、頭がいっぱいになってしまいますよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:32:05",
      "utterance": "つらいです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:32:43",
      "utterance": "だから、大好きなバスケをやっていても楽しめない",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:33:36",
      "utterance": "いっそのこと、やめてしまおうかと悩んでいる。そんなきもちですかね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:34:26",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:35:08",
      "utterance": "気持ちを教えてくれて、ありがとうございます。",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:35:57",
      "utterance": "楽しくプレイしたいですもんね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:36:48",
      "utterance": "仮の話ですが、他に気になる部活はあるんですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:37:11",
      "utterance": "そうですね...でも頑張ってもダメなものはダメなのかなって、",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-07-05T14:37:38",
      "utterance": "自分はダメだなって思います",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:37:59",
      "utterance": "そんなことはないと思いますよ",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:38:34",
      "utterance": "まだわからないですからね",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:38:34",
      "utterance": "私だけじゃなくて、みんな頑張ってるのに、自分は全然上達しないし",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:38:48",
      "utterance": "ええ",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:39:07",
      "utterance": "もう自分が嫌になります",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:39:18",
      "utterance": "そんな風に感じているんですね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:40:10",
      "utterance": "去年の自分と比べて、プレイはどうですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:40:34",
      "utterance": "あまり上達してないです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:40:49",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:40:59",
      "utterance": "だからダメなんです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:41:28",
      "utterance": "自信がないのですね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:41:35",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:42:05",
      "utterance": "分かります、私も学生時代そうでしたよ",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:42:49",
      "utterance": "上達って、自分ではわかりにくいですよね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:43:32",
      "utterance": "だからずっと変わらないように感じてしまいますよね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:44:55",
      "utterance": "もし、メンバーに入れなかったら、バスケはもうやりたくない？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:46:27",
      "utterance": "屈辱です。バスケ推薦で入ったのに、落ちたらもう無理かも",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-07-05T14:46:40",
      "utterance": "親にも言えない",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:46:50",
      "utterance": "そうだったんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:47:17",
      "utterance": "親は何ていうと思いますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:47:47",
      "utterance": "恥だって言うと思う",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:48:09",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:50:42",
      "utterance": "このことは、ご両親に相談しにくい？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:50:57",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:52:11",
      "utterance": "おそらく、こんなに頑張ってきたことを一番応援しているのは、ごだと思います",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:52:30",
      "utterance": "ご両親ですね",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:53:46",
      "utterance": "メンバーに関係なく応援してくださっているのではないでしょうか？",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2021-07-05T14:54:54",
      "utterance": "応援はしてるけど、頑張るのは当たり前だと思っています。",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:55:12",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-07-05T14:57:15",
      "utterance": "メンバーも気になりますが、楽しくしたいですよね",
