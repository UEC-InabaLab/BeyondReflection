{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2022-06-19T14:00:03",
      "utterance": "こんにちは。相談員です。",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:01:05",
      "utterance": "宜しくお願いします",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:03:01",
      "utterance": "では相談をはじめます。年齢、性別、相談内容を教えてください。",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:03:49",
      "utterance": "40歳、女性です",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-06-19T14:04:14",
      "utterance": "実は、自分の両親と同居しているのですが、",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-06-19T14:04:33",
      "utterance": "父親の事が嫌いで",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-06-19T14:04:45",
      "utterance": "こんな自分も嫌です",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-06-19T14:05:15",
      "utterance": "どうしていったら良いのかなと思いまして",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-06-19T14:05:28",
      "utterance": "宜しくお願いします",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:06:35",
      "utterance": "わかりました。お父様の事が嫌いで、そんなご自身も嫌になっているという事ですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:06:43",
      "utterance": "そうなんです",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2022-06-19T14:07:17",
      "utterance": "父の歳は80歳です",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2022-06-19T14:07:30",
      "utterance": "年の変化が出てきています",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2022-06-19T14:07:56",
      "utterance": "認知は大丈夫ですが、身体の動きが",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2022-06-19T14:08:26",
      "utterance": "若い時と違って、パッパッとは動けないのは承知しています",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:08:32",
      "utterance": "なるほど。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:08:51",
      "utterance": "でも、ご飯をボロボロこぼしたり",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-06-19T14:09:21",
      "utterance": "トイレの蓋が閉まっているのに、そのまま腰掛けて排尿したり",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-06-19T14:09:30",
      "utterance": "ほんとにヤダです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:09:38",
      "utterance": "確かに高齢の方と一緒に暮らすのは、大変な事も多いしそれが原因で嫌になったりしますよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:09:47",
      "utterance": "そうなんです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:10:11",
      "utterance": "もっと、ひどくなるのかと思うと、気持ちがとても沈みます",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:10:20",
      "utterance": "自分の親なのに",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:10:35",
      "utterance": "介護出来るかも、不安です",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:11:16",
      "utterance": "歳だと思って、諦めるしかないのでしょうか？",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:11:53",
      "utterance": "要介護ではないので、施設入所は無理です",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:12:17",
      "utterance": "コロナ禍でもあるので、通所も控えたいです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:12:23",
      "utterance": "なるほど。入所は難しい状況なんですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:12:33",
      "utterance": "そうなんです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:13:45",
      "utterance": "主人も、仕方ないとは言ってくれています",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:14:18",
      "utterance": "もう少し、可愛らしいお爺さんでいたらなと思います。",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:14:32",
      "utterance": "家族の方も現状の理解はあるんですね。",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:14:43",
      "utterance": "そうですね",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:15:27",
      "utterance": "おじい様とは普段の会話・やり取りでも気になる点があるのですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:15:40",
      "utterance": "私が父の事を怒らないようにと、母は先回りして注意しています",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-06-19T14:15:57",
      "utterance": "日本語がヘタです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:16:30",
      "utterance": "大丈夫ですよ。思いついたままの表現でいいですよ。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:17:21",
      "utterance": "ご飯の時に、『おかずここにもあるよ』と伝えると、『お腹一杯、終わった。』と言いながら、食事しています",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-06-19T14:17:39",
      "utterance": "おかしくないですか？",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-06-19T14:18:08",
      "utterance": "こういう風に、返事すると良いよと伝えますがダメですね",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:18:29",
      "utterance": "なるほど。改善されないのですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:18:54",
      "utterance": "長いこと生きてきたから、今更かわらないですよね",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:19:06",
      "utterance": "私が変われば良いのかな",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:19:36",
      "utterance": "目の前で、犬飼いしている姿は見たくないです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:20:30",
      "utterance": "どうして犬食いかというと、食器にかぶさって食べれば、口からこぼれても食器に落ちると…",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:20:58",
      "utterance": "本人なりの理由があるんですよね",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:21:08",
      "utterance": "なるほど。そういう姿は見たくないですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:21:15",
      "utterance": "そうなんです",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-06-19T14:21:59",
      "utterance": "口一杯に頬張るからいけないと思うんです。飲み込む前に、さらに口に入れる",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-06-19T14:22:26",
      "utterance": "口の中のものが落ちないように、啜るわけです",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-06-19T14:22:43",
      "utterance": "カレーを啜るって見たことあります？",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:23:14",
      "utterance": "そうなんですね。見た事ないですね。",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:23:30",
      "utterance": "そうでしょ",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-06-19T14:23:47",
      "utterance": "確かに、啜れば口からは落ちない",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-06-19T14:23:53",
      "utterance": "でもね",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-06-19T14:24:56",
      "utterance": "注意しても、改善しないし",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-06-19T14:25:33",
      "utterance": "父を見ないように、ご飯を食べています",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:25:46",
      "utterance": "一緒に住んでいてそういう姿を見るのはつらいですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:26:45",
      "utterance": "これに、認知が入ったらどうしましょう",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:27:17",
      "utterance": "そうですね。不安ですよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:27:24",
      "utterance": "不安です",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:27:52",
      "utterance": "70歳の母もいますし",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:28:49",
      "utterance": "なるほど。お母さまもそういう事になる可能性はありますよね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:29:03",
      "utterance": "そうなんですよね",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:29:13",
      "utterance": "なってほしくはないけど",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:29:29",
      "utterance": "そうですね。なってほしくないですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:30:29",
      "utterance": "大変さが増すだけでなく、自分の母のそういう姿は見たくないですね",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:31:18",
      "utterance": "ええ、家族のそうなった姿は見てるだけでも辛いですよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:31:34",
      "utterance": "辛いですね",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:31:57",
      "utterance": "親は、いつまでも元気でいて欲しいです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:32:54",
      "utterance": "元気な姿が一番いいですよね。ものすごくご両親思いなんですね。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:33:43",
      "utterance": "そう言われると、こそばゆいです",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:34:15",
      "utterance": "自分が完璧主義なのかな？",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:34:39",
      "utterance": "だから、父の行動が許せないのかもしれない",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:35:00",
      "utterance": "あと、少しの人生、穏やかに暮らして欲しい",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:35:12",
      "utterance": "と、いうか、私が穏やかに暮らしたい",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:35:48",
      "utterance": "そうですね。穏やかに過ごしたいですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:36:12",
      "utterance": "穏やかに",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:36:19",
      "utterance": "どうすれば穏やかな気持ちになれそうですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:37:06",
      "utterance": "相手に感謝の気持ちを持つことかな",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:37:36",
      "utterance": "いくら、嫌でも、ここまで育ててくれた訳だし",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:37:42",
      "utterance": "なるほど。そうですね、大切なご両親ですものね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:38:02",
      "utterance": "自分の気持ちしだいですね",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-06-19T14:38:32",
      "utterance": "父に優しく出来た日は、自分にご褒美をあげようかな",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:38:53",
      "utterance": "そうですね。気持ち・考え次第でもあると思います。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:39:10",
      "utterance": "そうですね",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:39:16",
      "utterance": "ご自身へのご褒美も考えると楽しくなりそうですね。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:39:38",
      "utterance": "ご褒美は、何にしようかな",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:40:11",
      "utterance": "楽しみを考えるのはいいですね。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:40:38",
      "utterance": "楽しみを考えながら、生活してみようかな",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-06-19T14:41:31",
      "utterance": "途中ですか、以上で終了します。お疲れ様でした。ありがとうございました。",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2022-06-19T14:42:09",
      "utterance": "ありがとうございました。聞いてもらって少し楽になりました。",
      "distress_level": 0,
      "disclosure_depth": 2
    }
  ],
