    },
    {
      "role": "client",
      "time": "2023-02-11T10:06:30",
      "utterance": "夜は三時間おきに起きないといけないので、その合間に寝るという感じです。",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2023-02-11T10:07:42",
      "utterance": "そうですよね...授乳にげっぷにリセットする時間がとれないですね...",
