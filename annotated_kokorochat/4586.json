      "role": "client",
      "time": "2023-02-11T10:08:40",
      "utterance": "有り難うございます。",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2023-02-11T10:08:55",
      "utterance": "こちらこそ、そんな時に来てくれてありがとうございます。",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2023-02-11T10:09:18",
      "utterance": "お食事は食べられていますか？",
