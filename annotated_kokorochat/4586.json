    },
    {
      "role": "client",
      "time": "2023-02-11T10:10:21",
      "utterance": "そうですね",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2023-02-11T10:11:06",
      "utterance": "食べたいっていう感覚もあまりないので、それは大丈夫なんですけど",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2023-02-11T10:11:23",
      "utterance": "自分の時間がないのがつらいです。",
