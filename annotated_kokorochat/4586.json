    {
      "role": "client",
      "time": "2023-02-11T10:09:36",
      "utterance": "合間、合間で食べてます。",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2023-02-11T10:09:59",
      "utterance": "そうですか..食べた気がしないですよね..",
