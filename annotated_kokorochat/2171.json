    {
      "role": "client",
      "time": "2021-07-12T10:09:31",
      "utterance": "別に辛くはないけど、、何かみんなでつるんでたり、どうでもいい話で騒いでるのが子供っぽいなあと思う。",
      "distress_level": 1,
      "disclosure_depth": 2
