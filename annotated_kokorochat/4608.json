{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2023-02-16T13:21:42",
      "utterance": "(お時間になったら始めますね。本日はよろしくお願いします）",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:22:25",
      "utterance": "(よろしくお願いします。本日ご希望のケース等はございますでしょうか？)",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:22:56",
      "utterance": "お任せします。",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:23:07",
      "utterance": "かしこまりました。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:23:29",
      "utterance": "（よろしくお願いします）",
      "tag": "Greeting"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:30:14",
      "utterance": "こんにちは。相談員です。よろしかったら、初めに、性別と年齢を教えていただけますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:30:37",
      "utterance": "男、32",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:30:46",
      "utterance": "ありがとうございます。本日はどのようなご相談ですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:32:27",
      "utterance": "精神疾患持ちです。不安が強くて、生きていけません",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:33:02",
      "utterance": "そうなんですね。おつらい状況なんですね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:33:16",
      "utterance": "お話聞かせてくださってありがとうございます。",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:33:44",
      "utterance": "少し詳しくお話うかがえますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:34:08",
      "utterance": "何を話せばいいのかわかりません",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:34:27",
      "utterance": "そうですよね...",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:34:52",
      "utterance": "不安とおっしゃっていましたが",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:35:19",
      "utterance": "どんな場面で不安を感じることが多いですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:35:33",
      "utterance": "ほぼ全て",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:36:03",
      "utterance": "そうなんですね...",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:37:03",
      "utterance": "それはおつらいですよね...",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:37:30",
      "utterance": "今の状況になったのはいつごろからでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:37:44",
      "utterance": "覚えてません",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:38:45",
      "utterance": "そうでしたか..しんどい中、来てくれてありがとうございます",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:39:05",
      "utterance": "体調はいかがですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:39:24",
      "utterance": "普通",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:39:42",
      "utterance": "そうなんですね。睡眠やお食事はとれていますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:39:59",
      "utterance": "眠れてません",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:40:38",
      "utterance": "そうなんですね...。疲れていませんか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:41:23",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:42:16",
      "utterance": "そうですか..。眠れていないということですが、何か思い当たることはありますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:42:23",
      "utterance": "わかりません",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:42:40",
      "utterance": "そうなんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:43:16",
      "utterance": "毎日、どんな風にすごしているのですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:43:47",
      "utterance": "不安を抱えながら過ごしてます",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:44:35",
      "utterance": "そうなんですね。１日のスケジュールはどんな感じですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:45:06",
      "utterance": "なんでそれを知りたいのでしょうか",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:45:37",
      "utterance": "気を悪くしたらごめんなさい。不安を抱えて、とおっしゃっていたので",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:46:16",
      "utterance": "不安を抱えることとスケジュールを聞くこととは何か関係があるのでしょうか",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:46:41",
      "utterance": "はい。あなたのことがもっと知りたいと思いました。",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:46:57",
      "utterance": "ご一緒にかんがえたいな、と",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:47:03",
      "utterance": "何を",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:48:24",
      "utterance": "不安を抱えながら、睡眠もあまりとれていない状況で、どんな場面で困難さがあり、どうしたら少し楽なお気持ちになれるか",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:48:37",
      "utterance": "ご一緒に考えたいと思いました",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:48:53",
      "utterance": "私事ですが",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:49:00",
      "utterance": "考えたらどうにかなるものなの",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:49:54",
      "utterance": "そうですね...あなたはどう思いますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:50:39",
      "utterance": "わからないから聞いてます",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:50:54",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:51:24",
      "utterance": "楽になる方法はご一緒に考えられるかもしれない、と思っています",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:51:52",
      "utterance": "実は私も同じような経験がありまして",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:52:30",
      "utterance": "今かろうじて、以前よりは楽に考えられるようになりました",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:53:52",
      "utterance": "だからどうしましたか自分にはできたから、他の人にもできるだろうと思っているのですか",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2023-02-16T13:54:03",
      "utterance": "状況も知らないのに",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:54:20",
      "utterance": "そうですよね...もっともだと思います",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:54:47",
      "utterance": "知ったかぶりに聞こえたらごめんなさい",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:55:00",
      "utterance": "最初におっしゃっていたように",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:56:04",
      "utterance": "不安が強いことで、どれほどしんどいかと..",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:56:54",
      "utterance": "せめて１日のうちで、少しでもホッとできる時間が増えないか",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:57:14",
      "utterance": "模索できたらなと思いました",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:57:28",
      "utterance": "いかがでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:57:32",
      "utterance": "できません",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:57:44",
      "utterance": "そうなんですね..",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:58:12",
      "utterance": "あなたは、どうしたいと思いますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:58:23",
      "utterance": "考えられません",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:58:59",
      "utterance": "そうですよね...それどころではないですよね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T13:59:32",
      "utterance": "今どちらか、通われていますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T13:59:49",
      "utterance": "どういう意味ですか",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:00:04",
      "utterance": "相談窓口だったり",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:00:40",
      "utterance": "あるいは、疾患とおっしゃっていたのでクリニックなど、",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2023-02-16T14:00:57",
      "utterance": "病院",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:01:12",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:01:43",
      "utterance": "そちらの病院は、なんとおっしゃっていますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T14:01:55",
      "utterance": "何についてですか",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:02:11",
      "utterance": "症状について、です",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2023-02-16T14:02:23",
      "utterance": "何の",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:02:47",
      "utterance": "不安について、何か提案はありますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T14:03:07",
      "utterance": "薬をもらったぐらいしかありません",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:03:16",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:03:40",
      "utterance": "あまりじっくりお話する感じではないのでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T14:03:52",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:04:16",
      "utterance": "それはもどかしい感じがします..",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:05:26",
      "utterance": "少しお伺いしたいのですが",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:05:54",
      "utterance": "今の不安について、ご自身で試してみたことなどありますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T14:06:27",
      "utterance": "ありません",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:06:34",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:07:01",
      "utterance": "不安を感じるようになったきっかけはありますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T14:07:39",
      "utterance": "わかりません",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:08:16",
      "utterance": "そうなんですね...では、例えばですが..",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:09:03",
      "utterance": "何をしている時が、一番楽ですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T14:09:17",
      "utterance": "わかりません",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:09:35",
      "utterance": "そうなんですね..",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:10:44",
      "utterance": "今、どなたとお住まいなのですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T14:10:53",
      "utterance": "いません",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:11:03",
      "utterance": "おひとりなんですね",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:11:29",
      "utterance": "いつごろからおひとり暮らしですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T14:11:59",
      "utterance": "大学入学してから",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:12:08",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:12:28",
      "utterance": "お食事は自炊ですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T14:12:43",
      "utterance": "何か関係があるのですか",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:12:56",
      "utterance": "気を悪くしたらごめんなさい",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:13:09",
      "utterance": "しんどい中",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:14:00",
      "utterance": "一人暮らしで自炊されているとしたら...",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:14:23",
      "utterance": "大変な労力だろうなと思いました",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:14:50",
      "utterance": "日々の生活で、",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2023-02-16T14:15:02",
      "utterance": "はぁ",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:15:06",
      "utterance": "一番困っていることは何ですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T14:15:38",
      "utterance": "不安が常にいること",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:15:46",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:16:26",
      "utterance": "日常生活で、手を付けられなくなっていることなど、ありますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T14:16:36",
      "utterance": "あります",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2023-02-16T14:16:45",
      "utterance": "どんなことですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2023-02-16T14:17:13",
      "utterance": "掃除",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "client",
