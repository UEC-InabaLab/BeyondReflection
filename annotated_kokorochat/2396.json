{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2021-08-26T19:54:05",
      "utterance": "（よろしくお願いします）",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2021-08-26T19:54:27",
      "utterance": "(よろしくお願いいたします)",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:00:02",
      "utterance": "こんばんは、相談員です。本日は相談にきてくれて、ありがとうございます。",
      "tag": "Greeting"
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:00:19",
      "utterance": "はじめに、年代と性別をお聞きしてもよろしいですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:00:50",
      "utterance": "はい高3 女です",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:01:00",
      "utterance": "はい、お答えいただきありがとうございます。本日はどのようなご相談でしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:01:39",
      "utterance": "夏休みが無駄になってしまいました",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:02:12",
      "utterance": "夏休みですね、どんな風にでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:02:52",
      "utterance": "いっぱい計画を立ててたのですが、ぜんぜんダメでした",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:03:28",
      "utterance": "そうなんですね、せっかくの夏休み、残念な思いをしてるんですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:03:46",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:03:57",
      "utterance": "どんな計画があったのですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:04:21",
      "utterance": "受験生なので、勉強の計画を立ててました",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:05:00",
      "utterance": "そうなんですね、いま高校３年生ですから、受験ですよね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:05:07",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:05:52",
      "utterance": "その計画は、例えばどんな勉強の計画だったのですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:06:48",
      "utterance": "どんな？受験科目の勉強です",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:08:21",
      "utterance": "なるほど、科目ですね。ぜんぜんダメとは、どんな理由とだったのですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:09:41",
      "utterance": "ぜんぜん計画通りに進まなかったです。時間はたっぷりあったのに…",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:10:58",
      "utterance": "そうなんですね、計画的に進まなかったんですね。なにか他に気持ちが行ってた感じですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:11:38",
      "utterance": "別にそんなこともなかったです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-08-26T20:12:02",
      "utterance": "ただ、ただ、ぼーっとしているうちに時間が経った感じです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:13:01",
      "utterance": "なるほど、そうなんですね。気持ちが入らなかった感じでしょうか。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:13:21",
      "utterance": "やろうとは思ってるんですが",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-08-26T20:13:26",
      "utterance": "今も",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:13:32",
      "utterance": "ええ",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:14:10",
      "utterance": "でも、無性にイライラしたり、もーいいかとかになってしまうんです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:15:20",
      "utterance": "イライラですか、、つらいですね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:15:34",
      "utterance": "今の状態になったのは、夏休みからですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:15:46",
      "utterance": "いえ",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:16:11",
      "utterance": "いつごろからですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:16:32",
      "utterance": "いつ頃…",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-08-26T20:16:42",
      "utterance": "最初は頑張ってたんですよ",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:17:02",
      "utterance": "はい、そうなんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:17:27",
      "utterance": "で、失速して夏休みは頑張ろうと思ってたんです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:17:28",
      "utterance": "何かありましたか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:17:46",
      "utterance": "わからないです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-08-26T20:17:52",
      "utterance": "なんとなく？",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:18:32",
      "utterance": "そうですか、気が付いたら、イライラしたり、勉強が手につかなくなった感じでしょうか？",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:19:01",
      "utterance": "ええ",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-08-26T20:19:25",
      "utterance": "しないととは、思ってるですよ",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-08-26T20:19:35",
      "utterance": "毎日、いつでも",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:21:04",
      "utterance": "そうなんですね、計画をしっかり立ててらっしゃるから、勉強を真剣にしたい気持ちは強いことは伝わってきます。",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:22:00",
      "utterance": "でも、勉強が手につかない・・・",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:22:13",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:22:21",
      "utterance": "悩んじゃいますね・・・",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:22:27",
      "utterance": "どうしたら出来ますか？",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:22:57",
      "utterance": "そうですね、どうしたらできるか一緒に考えてみましょう。",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:22:58",
      "utterance": "って言っても、夏休み終わってしまったし",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-08-26T20:23:12",
      "utterance": "無駄にしただけでしたね",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:23:44",
      "utterance": "夏休みは終わっちゃいましたが、目標の受験はいつですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:24:01",
      "utterance": "10月です",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:24:22",
      "utterance": "あと、２か月はあるんですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2021-08-26T20:24:38",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-26T20:24:56",
      "utterance": "志望校とかは、決まってるのですか？",
