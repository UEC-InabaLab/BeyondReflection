{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2024-05-23T20:53:43",
      "utterance": "（こんばんは、本日はよろしくお願いいたします。）",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2024-05-23T20:58:48",
      "utterance": "(よろしくお願いします)",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:00:04",
      "utterance": "こんばんは、相談員です。よろしくお願いします。はじめに年齢、性別、相談内容を教えてください。",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:01:33",
      "utterance": "話しやすいところからで、大丈夫ですよ。",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:01:58",
      "utterance": "はい…",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2024-05-23T21:03:02",
      "utterance": "家が怖いんです",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:03:36",
      "utterance": "そうなんですね、、、家が怖い、、何があったのでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:04:40",
      "utterance": "今、とてもお辛い気持ちですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:04:55",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:05:38",
      "utterance": "そうなんですね。今、どこからお話ししてくれていますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:05:56",
      "utterance": "公園にいます",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:06:28",
      "utterance": "公園、、、暑かったり寒かったりしていないですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:06:45",
      "utterance": "大丈夫です",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:07:02",
      "utterance": "そうなんですね、少し安心しました。",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:07:18",
      "utterance": "もし、喉が渇いたりしたら、",
      "tag": "Suggest"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:07:34",
      "utterance": "飲み物など飲んでくださいね。",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:08:00",
      "utterance": "はい　水道もトイレもあるから、大丈夫です",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:08:28",
      "utterance": "はい、よかったです。体調はいかがですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:08:52",
      "utterance": "大丈夫です",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:09:16",
      "utterance": "教えてくれてありがとうございます。",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:10:13",
      "utterance": "怖いというのは、泥棒と遭遇などしたのでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:10:45",
      "utterance": "兄が怖いんです",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:11:26",
      "utterance": "そうだったんですね。ちなみにあなたの年齢を教えてくれますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:11:43",
      "utterance": "13",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:12:07",
      "utterance": "中学校１年生ですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:12:19",
      "utterance": "そうです",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:12:32",
      "utterance": "教えてくれてありがとう。",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:12:46",
      "utterance": "ちなみに男性？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:12:56",
      "utterance": "女です",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:13:32",
      "utterance": "お返事ありがとう。お兄さんに何かされたの？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:13:41",
      "utterance": "そう",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:13:55",
      "utterance": "そうだったんだね。怖かったね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:14:06",
      "utterance": "叩かれたのかな？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:14:07",
      "utterance": "うん",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2024-05-23T21:14:16",
      "utterance": "触ってくる",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:14:46",
      "utterance": "そうだったのね、、、いつからそんなふうにされてるの？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:15:03",
      "utterance": "小学生の頃から",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:15:23",
      "utterance": "そんなに前から、、、。辛かったね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:15:35",
      "utterance": "うん",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:16:05",
      "utterance": "お兄さんは、実のお兄さん？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:16:13",
      "utterance": "そう",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:16:31",
      "utterance": "そうなんだね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:16:41",
      "utterance": "お兄さんは、何歳？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:16:52",
      "utterance": "二つ上",
      "distress_level": 3,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:17:10",
      "utterance": "中学３年生なのかな。",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:17:20",
      "utterance": "そう",
      "distress_level": 3,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:17:59",
      "utterance": "そっか、、、。ちなみに家族構成を教えてくれるかな。",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:18:25",
      "utterance": "両親と兄と弟",
      "distress_level": 3,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:18:43",
      "utterance": "教えてくれて、ありがとう。",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:19:14",
      "utterance": "このことは、親御さんには伝えられてるのかな？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:19:28",
      "utterance": "言えない",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:20:05",
      "utterance": "そっか、、、そうだよね。恥ずかしい？それとも、怒られると思うからかな？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:20:33",
      "utterance": "言いたくないから",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:21:24",
      "utterance": "そうなんだね、言いたくないんでね。それは、どうしてかお話しできるかな。",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:22:46",
      "utterance": "信じてもらえなさそう？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:22:55",
      "utterance": "がっかりされたくない",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:23:11",
      "utterance": "がっかり、、？",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:23:59",
      "utterance": "いいことじゃないでしょう",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:24:26",
      "utterance": "そうなんだね、、、。一人で胸を痛めていたんだね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:24:55",
      "utterance": "でもね、あなたが我慢することじゃないんだよ。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:25:24",
      "utterance": "なんで？",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:26:18",
      "utterance": "あなたが、傷つくことは絶対、何があってもあってはいけないことだから。",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:26:59",
      "utterance": "ちなみに、お兄さんに暴力はされてない？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:27:12",
      "utterance": "叩かれたり、していない？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:27:36",
      "utterance": "叩かれないよ",
      "distress_level": 3,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:27:48",
      "utterance": "そうなんだね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:27:59",
      "utterance": "触られるだけなのかな？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:28:31",
      "utterance": "もっと嫌なことをされていないか、相談員は心配です。",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:29:15",
      "utterance": "ごめんね、、、、辛いよね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:29:54",
      "utterance": "誰かに、相談してみようと思ったことはあるかな？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:30:12",
      "utterance": "ない",
      "distress_level": 3,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:30:38",
      "utterance": "そうだったんだね、一人で抱えて耐えてきたんだね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:31:22",
      "utterance": "辛いよね。でも、もうこういうの嫌だよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:31:43",
      "utterance": "うん",
      "distress_level": 3,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:31:52",
      "utterance": "そうだよね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:32:40",
      "utterance": "どうなったら、あなたが楽になれるか一緒に考えさせてね。",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:32:53",
      "utterance": "うん",
      "distress_level": 3,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:33:00",
      "utterance": "ありがとう。",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:33:56",
      "utterance": "あなたの悩みは大人の助けが必要なお悩みです。。",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:34:29",
      "utterance": "どうかな、、、伝えられそうな人いるかな。",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:34:44",
      "utterance": "いないかな",
      "distress_level": 3,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:34:55",
      "utterance": "そっか、、、。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:35:05",
      "utterance": "例えばなんだけど、",
      "tag": "Suggest"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:35:36",
      "utterance": "保健室の先生とか、スクールカウンセラーさんとかはどうかな？",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:36:57",
      "utterance": "保健の先生は学校にいるから話しづらいカウンセラーの人は、たまにしか来ないから、どうやって話せばいいのかわからない",
      "distress_level": 3,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:37:18",
      "utterance": "そうなんだね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:37:46",
      "utterance": "カウンセラーさんには、",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:38:40",
      "utterance": "先生に伝えて、予約が必要になるから、、、。タイムラグがあるの。",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:39:22",
      "utterance": "できそう？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:39:24",
      "utterance": "そうなんだ",
      "distress_level": 3,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2024-05-23T21:39:39",
      "utterance": "先生に理由聞かれたくない",
      "distress_level": 3,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:40:07",
      "utterance": "そうだよね。バレたくないよね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:40:36",
      "utterance": "もし、できたら、",
      "tag": "Suggest"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:41:49",
      "utterance": "交番のお巡りさんに伝えることはできそう？",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:42:23",
      "utterance": "なんで？",
      "distress_level": 3,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:43:12",
      "utterance": "また、お兄さんに嫌なことをされた時にそこへ逃げてほしいから。",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:43:43",
      "utterance": "交番は近いよ",
      "distress_level": 3,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:43:52",
      "utterance": "そうなんだね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:44:25",
      "utterance": "どうかな、、、。行けそうかな。それに",
      "tag": "ClosedQuestion"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:45:14",
      "utterance": "児童相談所の人にも助けてもらいたいと思うのだけれど、、どうかな？",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:45:37",
      "utterance": "児童相談所ってなに？",
      "distress_level": 3,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:46:11",
      "utterance": "17歳までの子供を助けてくれる場所。",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:46:38",
      "utterance": "ふうん",
      "distress_level": 3,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:46:48",
      "utterance": "本当は、お父さんやお母さんに助けてもらいたいのだけれど。",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:47:22",
      "utterance": "伝えられないよね、、、。どうかな？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:47:47",
      "utterance": "どうかなって？",
      "distress_level": 3,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:48:05",
      "utterance": "お母さんだけでも伝えられそう？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-23T21:48:33",
      "utterance": "わかんない",
      "distress_level": 3,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:49:54",
      "utterance": "そっか。もし勇気が出なかったら、お母さんと一緒にこの窓口に来てくれたら、相談員から伝えることもできるよ。",
      "tag": "Suggest"
    },
    {
      "role": "counselor",
      "time": "2024-05-23T21:50:18",
      "utterance": "できそうかな？",
      "tag": "ClosedQuestion"
    },
    {
