    },
    {
      "role": "client",
      "time": "2020-08-04T21:16:21",
      "utterance": "基本的には変わっていないんだと思います",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:16:34",
      "utterance": "なるほど、、そうなんですね、、",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:17:02",
      "utterance": "そうしますと、、今このような相談をされたきっかけとか、、ございますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-04T21:17:09",
      "utterance": "結婚してから、私が更に「ちゃんとしなきゃ！」と思ったのかもしれません",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-08-04T21:17:35",
      "utterance": "家にいる時間が増えて、ちょっと追い込まれた感じがしていて",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-08-04T21:17:39",
      "utterance": "息苦しいです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:17:43",
      "utterance": "なるほど、、そういう状況なのですね",
