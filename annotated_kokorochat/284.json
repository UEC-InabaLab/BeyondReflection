    },
    {
      "role": "client",
      "time": "2020-08-04T21:22:35",
      "utterance": "うーん",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:22:36",
      "utterance": "何故だとお考えですか？",
