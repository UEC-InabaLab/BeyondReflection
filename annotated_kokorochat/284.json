    },
    {
      "role": "client",
      "time": "2020-08-04T21:26:35",
      "utterance": "みんなに、良い旦那さんだねと言われますが、家では全然",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:27:02",
      "utterance": "そうですか、、ソトヅラいい感じなのですね",
