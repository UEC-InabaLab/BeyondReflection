    },
    {
      "role": "client",
      "time": "2020-08-04T21:21:22",
      "utterance": "言い返すと、更にエスカレートするのはわかってるので、私は黙ってます",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:21:42",
      "utterance": "なるほど・・・辛いですね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-08-04T21:21:59",
      "utterance": "はい…",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:22:22",
      "utterance": "なぜ、、そのことで怒鳴るのでしょうね・・・",
