{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2020-08-04T20:59:08",
      "utterance": "こんばんわ相談員です。宜しくお願いします。",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2020-08-04T20:59:18",
      "utterance": "こんばんは、よろしくお願いいたします。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-08-04T20:59:34",
      "utterance": "今日はどのようなご相談でしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-04T20:59:51",
      "utterance": "最近、家にいるととても疲れてしまいます",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:00:15",
      "utterance": "そうなんですね、どんな事で疲れるのでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-04T21:00:36",
      "utterance": "夫の顔色を見ている自分に、疲れている感じです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:01:11",
      "utterance": "なるほど、、ご家庭の中で休まらないのは、少し深刻ですね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:01:23",
      "utterance": "旦那さんの、、",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:01:37",
      "utterance": "顔色を伺うとは、、",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:01:57",
      "utterance": "もう少し具体的にお聞かせ頂いてもよろしいですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-04T21:02:02",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-08-04T21:02:26",
      "utterance": "機嫌が悪くなると、小言が多くなります",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:02:40",
      "utterance": "なるほど",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-08-04T21:02:53",
      "utterance": "なので、間違えないように、間違えないように、といつも思っていますね",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:03:11",
      "utterance": "なるほど、、それは疲れちゃいますね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:03:50",
      "utterance": "なにか間違えると小言が多くなる感じですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-04T21:04:16",
      "utterance": "自分が気に入らない事があると、機嫌が悪くなってしまうので",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:04:27",
      "utterance": "そうなんですね、、",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-08-04T21:04:55",
      "utterance": "小言言われるのも、嫌なんです…",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:05:22",
      "utterance": "そうですよね、小言とか言われるとがっかりしちゃいますよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-08-04T21:05:35",
      "utterance": "とても疲れますね",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:05:37",
      "utterance": "気分の↓↓ですし",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:05:44",
      "utterance": "ですよね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:06:15",
      "utterance": "それは毎日とかですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-04T21:06:31",
      "utterance": "毎日というか、やはり機嫌によりますね",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-08-04T21:06:46",
      "utterance": "上手くいく時は、数日平和です",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-08-04T21:06:56",
      "utterance": "ダメな日は、本当に噛み合いません",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:07:01",
      "utterance": "そうですか、、それでも平日なのですね・・・",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:07:15",
      "utterance": "お疲れになりますね・・・",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:07:19",
      "utterance": "ちなみに、、",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:07:51",
      "utterance": "アリィさんとお呼びしてもよろしいですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-04T21:07:58",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:08:05",
      "utterance": "はい、、",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:08:23",
      "utterance": "アリィさんは夜ちゃんと寝れてますか？",
