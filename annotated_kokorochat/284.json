      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:28:14",
      "utterance": "そうですよね、、わかります",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:28:23",
      "utterance": "ちなみにですが、、",
