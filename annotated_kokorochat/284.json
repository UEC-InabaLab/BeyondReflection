    },
    {
      "role": "client",
      "time": "2020-08-04T21:15:08",
      "utterance": "そうですね、本当に",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:15:48",
      "utterance": "そうしますと、、付き合ってるころから、変わって点とかは、いかがですか？",
