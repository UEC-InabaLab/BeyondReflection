      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:24:28",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-08-04T21:25:15",
      "utterance": "夫の本音のところは、私にもわかりません",
