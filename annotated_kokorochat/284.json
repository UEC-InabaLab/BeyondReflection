    },
    {
      "role": "client",
      "time": "2020-08-04T21:22:59",
      "utterance": "なぜか",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-08-04T21:23:13",
      "utterance": "気に入らないんだろうな、というところですかね",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-08-04T21:23:37",
      "utterance": "多分、夫も仕事などで疲れてるんだろうなというのは、わかってます",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:23:55",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-08-04T21:24:22",
      "utterance": "でも、私も仕事もしてますしね",
