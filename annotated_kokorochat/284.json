    },
    {
      "role": "client",
      "time": "2020-08-04T21:18:24",
      "utterance": "ありがとうございます",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:18:34",
      "utterance": "今のお言葉、",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:18:57",
      "utterance": "息苦しい、、追い込まれた、、",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:19:05",
      "utterance": "ちょっと気になるので、",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:19:17",
      "utterance": "もう少し教えてください。",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-04T21:19:25",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:19:35",
      "utterance": "どんな会話とか、状況のとき",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:19:46",
      "utterance": "追い込まれたと感じますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-04T21:19:57",
      "utterance": "言い方がきついんです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-04T21:20:12",
      "utterance": "なるほど、、具体的に聞いてもいいですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-04T21:20:34",
      "utterance": "例えば家事などで、ちゃんとできてなかった事などあると",
