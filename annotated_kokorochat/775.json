{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2020-11-26T11:23:42",
      "utterance": "こんにちは。",
      "tag": "Greeting"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:23:55",
      "utterance": "今日はよろしくお願いいたします。",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:24:09",
      "utterance": "こんにちは。よろしくお願いします。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:25:28",
      "utterance": "準備が整い次第はじめてもよろしいでしょうか？もちろん、:30からでもかまいません。いかがですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:27:06",
      "utterance": "はい、始めて大丈夫です。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:27:28",
      "utterance": "はい、ありがとうございます。では、始めますね。",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:27:48",
      "utterance": "お願いします。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:27:52",
      "utterance": "こんにちは。相談員です。",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:28:02",
      "utterance": "こんにちは。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:28:12",
      "utterance": "今日はどんなご相談ですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:28:25",
      "utterance": "父親が、うざいです。",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:29:13",
      "utterance": "そうなんですね。それは、嫌になってしまいますよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:29:28",
      "utterance": "昔から口うるさいんですけど、勉強しろってずっと言ってて。部活で疲れて帰っても、勉強しろばっかで、",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:29:43",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:29:47",
      "utterance": "ほんと、うざいです。",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:30:21",
      "utterance": "煩わしいですよね、疲れて帰っているのに…",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:30:39",
      "utterance": "ところで、",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:30:50",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:31:32",
      "utterance": "あなたは、何年生でいらっしゃいますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:31:39",
      "utterance": "高1です。",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:32:17",
      "utterance": "高1で、どんな部活を頑張っておられるのですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:32:42",
      "utterance": "バレーボールです。始めたばっかで、",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-11-26T11:33:15",
      "utterance": "まだ全然だめだけど！",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:33:46",
      "utterance": "でも、頑張ってるんですね。高校生から始めて、取り組んでいるのですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:33:54",
      "utterance": "そうです。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:34:49",
      "utterance": "はじめての挑戦！！うまくいかないって思うこともありますよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:35:10",
      "utterance": "ええ、まあ",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:35:55",
      "utterance": "それなのに、帰っていきなり口うるさく言われるのは",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:36:16",
      "utterance": "ホント、ますます疲れますよね！",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:36:29",
      "utterance": "そうなんです！",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-11-26T11:37:07",
      "utterance": "何しろ上から頭ごなしに怒鳴るから、頭に来る。",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:37:39",
      "utterance": "うんうん、ホント、そう思いますよね、頭に来ますよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:38:02",
      "utterance": "お前のためとか言って、自分がイライラするから言ってるだけ。",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:38:28",
      "utterance": "うんうん、そう思っちゃいますよね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:39:05",
      "utterance": "大変な立場もわかってほしいって、思いますよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:39:19",
      "utterance": "そう。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:39:19",
      "utterance": "ところで、",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:40:48",
      "utterance": "あなたは今、始めたばかりの部活を頑張ってられるかと思いますが、",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:41:02",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:41:58",
      "utterance": "そんな中、勉強も大変だと思うけど、今はどんな風に頑張っていきたいと思いますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:42:22",
      "utterance": "部活と両立は大変だよね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:43:50",
      "utterance": "（質問が難しかったら、遠慮なくいってくださいね）",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:43:50",
      "utterance": "うーん。自分は結構頑張って受験して、今の高校にはいったところだから、",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:44:04",
      "utterance": "そうなんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:44:12",
      "utterance": "勉強もやる気は無いわけじゃない",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-11-26T11:44:29",
      "utterance": "けど、部活から帰って、",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:44:44",
      "utterance": "ええ、",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:45:10",
      "utterance": "ちょっと友だとラインしてたら、いつまでスマホしてるんだって。早く勉強しろって、怒られました。",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:46:00",
      "utterance": "そっか、頑張ってるんだから、息抜きぐらいしたいよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:46:16",
      "utterance": "そんなに長くしてなかったし・・",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:46:32",
      "utterance": "うんうん、優しい声くらいかけてほしいよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:47:11",
      "utterance": "まぁ、そうですよね。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:47:42",
      "utterance": "受験も頑張ったし、今も、部活にもがんがってるんだものね。",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:47:49",
      "utterance": "ところで、",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:48:14",
      "utterance": "高校は、志望校だったの？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:48:29",
      "utterance": "ええ、まぁ。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:49:24",
      "utterance": "どんな専門科なんですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:51:33",
      "utterance": "普通の高校です。",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:51:51",
      "utterance": "そうなんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:52:54",
      "utterance": "お父さんは、口うるさく言ってくるけど、",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:53:27",
      "utterance": "あんたたは本当は、そんな時、どんなことが頭に浮かんでいますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:54:35",
      "utterance": "ええと、そろそろやろうと思っていたのに！って",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-11-26T11:55:09",
      "utterance": "うるさいなーって。",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:55:21",
      "utterance": "そうだよねやろうと思ってるのに言われるのは、本当に頭にくるよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:55:44",
      "utterance": "そうなんですよ。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:56:23",
      "utterance": "ほかの例えば、家族、お母さんとは、どんな会話がありますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-11-26T11:56:57",
      "utterance": "お母さんは、まぁ、普通に話します。友達の話とか。",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-11-26T11:57:12",
      "utterance": "一人っ子です。",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:57:52",
      "utterance": "そうなんだね。お母さんと話せるのは、ほっとするね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:58:05",
      "utterance": "あなたは",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:59:23",
      "utterance": "頑張って志望校に入って、勉強も部活も頑張ってるけど、将来はどんなことをしたいと思ってるのかな、",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T11:59:35",
      "utterance": "良かったら教えてくださいね",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-11-26T12:00:00",
      "utterance": "将来・・まだあまり考えてないかな。",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:01:09",
      "utterance": "うんうん、そうなんだね。今は、部活に力を入れたいかんっじですか？それとも、どんなふうにしていきたい？",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:01:52",
      "utterance": "↑　どんな感じですか",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-11-26T12:02:12",
      "utterance": "部活も勉強も、それなりにやってるのに、父親が、うるさすぎきて、うっとうしいなって。",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:02:58",
      "utterance": "そうなんだね、そのことが一番何とかしたいことなのかな？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-11-26T12:03:29",
      "utterance": "そうです。でも、どうしようもないのかな",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:03:59",
      "utterance": "いつものことだと、本当に頭にくるよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-11-26T12:04:14",
      "utterance": "うん。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:04:17",
      "utterance": "楽になれるように一緒に考えようね",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2020-11-26T12:04:26",
      "utterance": "はい。お願いします。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:05:01",
      "utterance": "高校だって、頑張って志望校に入って、",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:05:52",
      "utterance": "はじめての部活で慣れない事なのに、文武両道で、続けているあなたは、",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:06:04",
      "utterance": "本当に頑張り屋さんです",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2020-11-26T12:06:38",
      "utterance": "照れますね・・😅",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:07:25",
      "utterance": "だって、ほんとのことですよ。疲れて帰って来たって、ちゃんと、勉強だってやろうって、しっかり取り組もうと決めてるんだよね",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2020-11-26T12:08:11",
      "utterance": "ええ、まぁ、そうです。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:08:13",
      "utterance": "だけど、わかりきってるやろうと思ってりっこっとを言われるのは、",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:08:55",
      "utterance": "だれだって疲れてれば、うまくいかないっことだってあるものなんです",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-11-26T12:09:24",
      "utterance": "そうなんです。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:09:45",
      "utterance": "だから、あなたが、うざいっておもってしまうことは、無理もないことだと思います。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-11-26T12:10:15",
      "utterance": "うん。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:12:19",
      "utterance": "だから、あなたが少しでも前向きになれるためには、どんなふうどんなふうにしたらいいか考えたいんだけど、そんな時あなたの腹立たしさがなんとかできると",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:12:32",
      "utterance": "楽になれるのかなって思いますが、",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:12:50",
      "utterance": "ご自身では、どう思いますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-11-26T12:13:22",
      "utterance": "頭にくるのをなんとかできるなら、そうなりたいです。",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:14:24",
      "utterance": "そうだよね。そしたら、ちゃんと考えておるんだもの、勉強にだって向き合えるようになれるんだよね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:14:43",
      "utterance": "ちゃんと考えてるんだもんね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:15:24",
      "utterance": "では",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:16:05",
      "utterance": "お伝えしたいことがありますので、お話させてくださいね",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2020-11-26T12:16:11",
      "utterance": "はい。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:18:10",
      "utterance": "いつも言われちゃうってことは、ほんとにうざいけど、あ、また、同じことだな。ってて、分かりやすいってことでもあるよね",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:18:19",
      "utterance": "だから",
      "tag": "Suggest"
    },
    {
      "role": "counselor",
      "time": "2020-11-26T12:18:55",
