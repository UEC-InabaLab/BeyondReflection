    },
    {
      "role": "client",
      "time": "2022-12-03T11:00:27",
      "utterance": "また今度来ますので、続きの相談させてください。",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-12-03T11:00:35",
      "utterance": "今日はこちらに起こしいただきありがとうございます。またお話し聴かせて下さい。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2022-12-03T11:00:46",
      "utterance": "はい、ありがとうございました。",
      "distress_level": 2,
      "disclosure_depth": 0
