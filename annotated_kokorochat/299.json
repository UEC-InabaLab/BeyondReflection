    },
    {
      "role": "client",
      "time": "2020-08-08T18:57:16",
      "utterance": "まあ付き合いは長いので",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-08-08T18:58:20",
      "utterance": "お互い信頼されているのですね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-08-08T18:58:41",
      "utterance": "だと思っているのですが",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-08-08T18:58:58",
      "utterance": "こんなことははじめてで",
