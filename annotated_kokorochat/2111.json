{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2021-06-29T20:20:59",
      "utterance": "こんばんは。本日はよろしくお願い致します。",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:27:44",
      "utterance": "よろしくおねがいします",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:27:52",
      "utterance": "時間になりましたら始めさせていただきますね。",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:28:05",
      "utterance": "了解しました",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "client",
      "time": "2021-06-29T20:28:24",
      "utterance": "何かやってみたいテーマはありますか?",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:29:04",
      "utterance": "特に考えていませんでした",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:29:49",
      "utterance": "そうなんですね。いじめか引きこもりで設定していいですか?",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:30:12",
      "utterance": "はい。やってみましょう",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:30:21",
      "utterance": "ではよろしくおねがいします",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:30:48",
      "utterance": "こんばんは。相談員です。差し支えなければ年齢と性別を教えてください",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:31:35",
      "utterance": "中1女子",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:32:12",
      "utterance": "教えていただきありがとうございます。今日はどの様なご相談ですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:32:44",
      "utterance": "学校に行きたくない",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-06-29T20:32:55",
      "utterance": "どうしたらいい?",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-06-29T20:33:05",
      "utterance": "教えて欲しい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:33:17",
      "utterance": "そうなのですね。一緒に考えて行きましょう",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:33:36",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:34:40",
      "utterance": "学校に行きたくないとのことだけど、何かきっかけになることがあったのかな？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:34:58",
      "utterance": "給食の時間が嫌",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-06-29T20:35:12",
      "utterance": "嫌いなものが多い",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:35:32",
      "utterance": "そうだったのですね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:36:00",
      "utterance": "先生が残すのはダメって言うから食べているけど、本当は残したい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:36:41",
      "utterance": "うんうん。頑張ってたべているんだね。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:37:04",
      "utterance": "それは体のため",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:37:29",
      "utterance": "そう考えているのですね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:37:29",
      "utterance": "お母さんもいつも同じ事をいうから",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-06-29T20:37:41",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:37:59",
      "utterance": "給食は毎日の事だから憂うつになるよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:38:15",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:39:04",
      "utterance": "でも、お母さんや先生がちゃんと食べないといけないというから、残さず食べようと",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:39:13",
      "utterance": "うん",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:39:19",
      "utterance": "努力しているのだね",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:39:47",
      "utterance": "でも、そのせいで遅くなる",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:39:59",
      "utterance": "うんうん。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:40:22",
      "utterance": "食べ終わるのが一番最後になる",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:40:58",
      "utterance": "そうなんだね。遅くなったら何か言ってくる人がいたりするのかな？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:41:36",
      "utterance": "一部の男子何人かが言う",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:42:20",
      "utterance": "そうなんだね。一生懸命たべているのに嫌な思いになってしまうよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:42:34",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:43:02",
      "utterance": "その男子には何をいわれるのかな？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:44:01",
      "utterance": "「とろい」「ダサい」「明日から給食無しでいいと思います」",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:44:51",
      "utterance": "えーそんなことを言ってくるんだ",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:45:04",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:45:27",
      "utterance": "それを言われてどんな気持ちになるの？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:45:54",
      "utterance": "嫌な気持ちになる",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:47:05",
      "utterance": "そうだよね。一生懸命嫌いなものも食べているのにそんな事を言われるなんて",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:47:14",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:47:26",
      "utterance": "嫌な気持ちになって当たり前だと思うよ",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:47:38",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:48:08",
      "utterance": "何か言い返したりしたの？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:48:18",
      "utterance": "何も言わないよ",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-06-29T20:48:49",
      "utterance": "だって先生も他の子も笑ってるし",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:49:26",
      "utterance": "そうなんだね。嫌な思いになったけど、何もいわなかったんだね。苦しいね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:49:41",
      "utterance": "仕方ないから、一緒に私も笑ってる",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:50:15",
      "utterance": "先生も他の子も笑ってるなんて…",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:50:28",
      "utterance": "人気ある子達だし、先生も気にいってるから",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:50:28",
      "utterance": "ひどいね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:50:35",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-06-29T20:50:55",
      "utterance": "言われるのはそんな感じ",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:51:54",
      "utterance": "そうなんだね。すごく悲しい気持ちになるね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:52:10",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:53:03",
      "utterance": "あなたの事をなんてお呼びしたらいいですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:53:19",
      "utterance": "なみです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:53:33",
      "utterance": "ありがとうございます。",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:54:05",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:54:22",
      "utterance": "なみさんはこのことをおうちの人にお話しましたか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:54:44",
      "utterance": "話さない",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-06-29T20:54:58",
      "utterance": "お母さんに知られたくない",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:55:50",
      "utterance": "うんうん。じゃあ一人で悲しい気持ちを抱えているんだね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:56:00",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:56:23",
      "utterance": "今日は話してもらってありがとう",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:56:36",
      "utterance": "いえ",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:57:13",
      "utterance": "勇気をだしてくれたんだね",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:57:29",
      "utterance": "うん…",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-06-29T20:58:32",
      "utterance": "さっきお母さんには知られたくない　ていってたけど、何か理由なあるのかな？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-06-29T20:59:42",
      "utterance": "私が心配かけるような事を言うと、すぐ学校に連絡してしまう",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-06-29T21:01:09",
      "utterance": "そうだったんだね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-06-29T21:01:22",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-06-29T21:01:50",
      "utterance": "この給食時間の出来事はいつ頃からなの？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-06-29T21:02:26",
      "utterance": "連休明け位",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-06-29T21:02:59",
      "utterance": "そっか。毎日のように言ってくるの？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-06-29T21:03:23",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-06-29T21:04:34",
      "utterance": "後、時々けられる",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-06-29T21:04:58",
      "utterance": "そんなことまで…",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-06-29T21:05:15",
      "utterance": "ひどいよ",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-06-29T21:05:29",
      "utterance": "蹴られるのは毎日じゃないから…",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-06-29T21:06:14",
      "utterance": "一回でも蹴るなんて絶対にしてはいけないことだよ",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-06-29T21:06:34",
      "utterance": "しかも男子が女子に",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-06-29T21:07:16",
      "utterance": "でもやめてとか言ったらもっとひどくなりそうで怖い",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-06-29T21:07:46",
      "utterance": "それに笑いながらけってくるから、冗談かも",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-06-29T21:08:05",
      "utterance": "そう思っているんだね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-06-29T21:08:06",
      "utterance": "その時は先生はいないけど",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-06-29T21:08:14",
      "utterance": "うんうん",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-06-29T21:09:37",
      "utterance": "見てる人はいるけど、その男子達には何も言えない",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-06-29T21:09:45",
      "utterance": "じゃあ、先生は蹴っていることはしらないかもね",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2021-06-29T21:09:49",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-06-29T21:11:20",
      "utterance": "その男子に周りの人は言えないのは理由がありそうかな？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-06-29T21:11:55",
      "utterance": "人気ある子達だからじゃないかな?",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-06-29T21:12:14",
      "utterance": "先生にも気にいられてるし",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-06-29T21:12:37",
      "utterance": "そっか。そう感じているんだね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-06-29T21:12:55",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-06-29T21:13:24",
      "utterance": "私から言わせれば人間として間違っているけどね…",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-06-29T21:13:36",
      "utterance": "そんなひどいことをするなんて",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-06-29T21:14:45",
      "utterance": "今までのお話をまとめてみますね",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2021-06-29T21:14:52",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-06-29T21:16:11",
      "utterance": "なおさんは今学校に行きたくないと思っています。それば給食にきらいなものが出てきて食べるのが遅くなってしまって",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2021-06-29T21:16:53",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-06-29T21:17:25",
      "utterance": "クラスの男子に笑われたりひどいことを言われたして、時には蹴られることもあったり",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
