{
  "dialogue": [
    {
      "role": "client",
      "time": "2020-12-31T11:02:19",
      "utterance": "よろしくお願いします",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:51:52",
      "utterance": "よろしくお願い致します。",
      "tag": "Greeting"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:01:21",
      "utterance": "こんにちは。メンタルトレーナーです。本日のテーマは受験のメンタルトレーニングです。",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:03:32",
      "utterance": "よろしくお願いします",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:04:03",
      "utterance": "ありがとうございます。よろしくお願い致します。",
      "tag": "Greeting"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:04:14",
      "utterance": "本日はどのようなご相談でしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:05:40",
      "utterance": "来春受験なんだけど、受かりそうもなくて",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:06:10",
      "utterance": "ご相談頂きありがとうございます。",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:06:30",
      "utterance": "そうなんですね。受験に不安を感じていらっしゃるんですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:06:40",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:06:58",
      "utterance": "差し支えなければ、どのような受験か教えて頂くことはできますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:07:48",
      "utterance": "大学受験です",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-12-31T12:08:18",
      "utterance": "医学部を目指しています",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:08:24",
      "utterance": "なるほど、なるほど。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:08:30",
      "utterance": "医学部を！",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:08:40",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:08:46",
      "utterance": "高いレベルを目指しておられるのですね。",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:09:00",
      "utterance": "どのようなところに不安を感じていらっしゃいますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:10:35",
      "utterance": "今の偏差値ではちょっと無理そうなんです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:11:05",
      "utterance": "そうだったんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:11:16",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:11:24",
      "utterance": "心配に思うのも無理はないですよね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:11:56",
      "utterance": "もし差し支えなければ",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:12:30",
      "utterance": "目指しておられる偏差値に対してどのくらい足りていないのか",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:12:44",
      "utterance": "教えて頂くことはできますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:14:28",
      "utterance": "あと10くらい上げないと合格圏にはいれません",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:14:48",
      "utterance": "そうなんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:15:32",
      "utterance": "そこをクリアできれば合格に近づく感じなんですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:16:29",
      "utterance": "それができればいいんだけど",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:17:23",
      "utterance": "そうですよね。クリアできればいいと感じますよね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:17:35",
      "utterance": "偏差値をあと10上げる以外に",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:17:55",
      "utterance": "合格に向けてクリアしたいことはありますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:18:30",
      "utterance": "このところドスランプにはまっていて",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:19:20",
      "utterance": "そうなんですね。少ししんどい感じですかね？",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:19:28",
      "utterance": "頑張らなくちゃいけないってわかってはいるんだかけど",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:19:41",
      "utterance": "うんうん",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:20:40",
      "utterance": "気晴らしにゲームをやると止まらなくなっちゃうんです",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:20:53",
      "utterance": "なるほどなるほど。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:21:08",
      "utterance": "ゲームいい気晴らしになりますよね。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:21:17",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:21:25",
      "utterance": "ドスランプということを話しておられましが、",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:21:38",
      "utterance": "どういったところにスランプを感じていらっしゃいますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:23:40",
      "utterance": "やろうと思ってたことをやらなかったりして、落ち込んでしまいます",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:24:02",
      "utterance": "なるほど、なるほど。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:24:14",
      "utterance": "やらなくてはいけないと思っていても",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:24:25",
      "utterance": "やれない自分がいると",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:24:32",
      "utterance": "落ち込みますよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:24:32",
      "utterance": "どうしてこんなに意志が弱いんだろう",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:24:54",
      "utterance": "うんうん",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:25:03",
      "utterance": "そう感じていらっしゃるのですね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:25:37",
      "utterance": "今医学部に合格するために、",
      "tag": "ClosedQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:25:54",
      "utterance": "取り組む勉強の全体像は",
      "tag": "ClosedQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:26:02",
      "utterance": "明確になっていますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:27:24",
      "utterance": "課題があまりにもいっぱいあって、どれからやったらいいのかわからなくなっています",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:27:40",
      "utterance": "なるほど、なるほど。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:27:50",
      "utterance": "やることが多すぎて",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:28:08",
      "utterance": "手がつけにくい感じなんですね",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:28:17",
      "utterance": "どう考えても間に合いそうもない",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-12-31T12:28:34",
      "utterance": "どうしたらいいんだろう",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:28:40",
      "utterance": "そうなんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:29:00",
      "utterance": "それは困惑するのも無理はないですよね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:29:42",
      "utterance": "受験までにかかる取り組みの全体像がクリアになれば、",
      "tag": "ClosedQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:29:54",
      "utterance": "スッキリしそうな感じですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:31:02",
      "utterance": "全体像ですか",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:31:18",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:31:23",
      "utterance": "さきほど",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:31:47",
      "utterance": "ゲームをしたら止まらなくて",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:31:59",
      "utterance": "意志が弱いのではと話しておられましたが",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:32:12",
      "utterance": "私はお話しを聴かせて頂いていて、",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:32:31",
      "utterance": "あなたは意志が弱いということはないように感じます。",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:32:40",
      "utterance": "真剣に向き合っているからこそ",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:32:53",
      "utterance": "現実とのギャップに",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:33:09",
      "utterance": "そうなんですか？",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:33:13",
      "utterance": "困っておられるのではないかと感じたのですが",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:33:20",
      "utterance": "いかがですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T12:34:22",
      "utterance": "でも逃げてるような気もします",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:34:44",
      "utterance": "なるほどなるほど。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:34:53",
      "utterance": "そう感じると思いますが、",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:35:08",
      "utterance": "よく受験勉強をされている方で",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:35:22",
      "utterance": "真剣に向き合っている人には",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:35:31",
      "utterance": "ある行動ですよ",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:35:55",
      "utterance": "ありがとうございました。",
      "tag": "Thanking"
    }
