{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2021-11-11T16:20:45",
      "utterance": "（諸々申し訳ありませんでした！よろしくお願いします）",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:20:59",
      "utterance": "(よろしくお願いいたします。すいません、子供の迎えがあり、17時半頃まででお願いできればと思います。)",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:21:22",
      "utterance": "こんにちは。相談員です。（了解しました！）",
      "tag": "Greeting"
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:21:57",
      "utterance": "本日はお話に来ていただいて、ありがとうございます。",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:22:05",
      "utterance": "よろしくお願いします。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:22:42",
      "utterance": "こちらこそお願いします。初めに、お年と性別をお聞かせいただけますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:23:02",
      "utterance": "14歳女です",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:23:44",
      "utterance": "ありがとうございます。本日はどのようなご相談でお越しいただきましたか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:24:05",
      "utterance": "ここでの話は親に伝わりますか?警察に行きますか?ログとかのこりますか？",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:24:54",
      "utterance": "大丈夫ですよ。ここでお話ししたことは、誰にも話さないので、安心してお話ししてくださいね。",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:25:12",
      "utterance": "なにから話せばいいかわかりません",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:25:22",
      "utterance": "消えたいんです",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:26:07",
      "utterance": "そうなんですね。それはお辛いですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:26:20",
      "utterance": "はい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:26:40",
      "utterance": "わざわざお辛い気持ちを聞かせに来てくれて、ありがとうございます。",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:26:48",
      "utterance": "はい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:27:17",
      "utterance": "触らせてって言われて、多分写真も撮られて",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:27:29",
      "utterance": "誰にもいえない",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:27:56",
      "utterance": "そうなんですね。それは言えないですよね。とっても苦しいお気持ちなんですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:28:10",
      "utterance": "はい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:28:56",
      "utterance": "デリケートなお話しだと思うので、お話しできることでいいので、少し詳しくお伺いしてもいいですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:29:54",
      "utterance": "はい…でもどうしたらいいか",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:30:20",
      "utterance": "知らない人で",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:30:44",
      "utterance": "電車に乗ってて一度会って",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:30:56",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:30:56",
      "utterance": "塾の帰りで",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:31:15",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:31:16",
      "utterance": "それで",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:31:27",
      "utterance": "それで、",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:31:46",
      "utterance": "大丈夫ですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:31:57",
      "utterance": "つらいです",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:32:27",
      "utterance": "お辛いお気持ちお話しさせてしまって、ごめんなさいね",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:32:46",
      "utterance": "混乱してしまいますよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:32:59",
      "utterance": "誰かにたすけてほしいんですでもいえなくてまたされたら、って",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:33:26",
      "utterance": "そうですよね。知らない人なら尚更怖いですよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:33:40",
      "utterance": "誰かに言ったら殺すって言われて",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:33:50",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:34:11",
      "utterance": "写真とか動画もとられてて",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:34:55",
      "utterance": "誰もしられたくないんです",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:35:05",
      "utterance": "そうですか．．．それはさぞかし悩んでいらっしゃいましたよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:35:11",
      "utterance": "はい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:35:34",
      "utterance": "夜になると怖いんです",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:36:11",
      "utterance": "そうですよね...怖いのはもっともですよ。そのことがあったのは、いつ頃ですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:36:34",
      "utterance": "先週です",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:37:23",
      "utterance": "そうですか...では眠ることもあまりできていないのかと思いますが、体調は崩していませんか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:37:39",
      "utterance": "夢をみます、くりかえし",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:38:01",
      "utterance": "泣いて起きて、その繰り返しで",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:38:24",
      "utterance": "そうなんですね...それは苦しいですね...",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:38:47",
      "utterance": "病院にも行かなきゃいけないのかもしれないけど、いけていません",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:39:05",
      "utterance": "そうなんですね...学校は行っているんですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:39:06",
      "utterance": "産婦人科とか、行かなきゃだけど",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:39:22",
      "utterance": "はい、親にバレたら困るので",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:39:36",
      "utterance": "塾は２日休みました",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:39:51",
      "utterance": "でもこれから行かなければならなくて…",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:40:38",
      "utterance": "..つらいですね...",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:40:47",
      "utterance": "はい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:41:08",
      "utterance": "もう、消えてしまいたいです",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:41:48",
      "utterance": "そうですよね...そう思ってしまいますよね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:42:06",
      "utterance": "一つお話ししてもいいですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:42:10",
      "utterance": "はい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:43:16",
      "utterance": "中学生のあなたが、こんなことを一人で抱えるって、本当に過酷で、辛いと思うんです。もちろん、誰にも言えないと思うのも、当然です。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:43:37",
      "utterance": "はい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:44:12",
      "utterance": "なので、消えてしまいたいと思うお気持ちも、仕方ないと思います。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:44:30",
      "utterance": "はい…",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:45:18",
      "utterance": "でも、とにかく、毎日、この相談に話に来てくれることだけ、約束して欲しいんです。",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:45:55",
      "utterance": "毎日、来てもいいんですか？",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:46:12",
      "utterance": "大丈夫ですよ。",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:46:21",
      "utterance": "はい、わかりました",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:47:08",
      "utterance": "ありがとうございます。私は、少しでも、あなたのことを理解したいと思うし、味方になりたいと思っています。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:48:16",
      "utterance": "ありがとうございます病院には、、行ったほうがいいんでしょうか？産婦人科？婦人科？はいったことなくて、何をされるのかもわからなくて",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:48:43",
      "utterance": "親に病院いったらバレますか？保険証とかで",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:49:20",
      "utterance": "されたこと、病院ではなしたくないな、、、",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:49:45",
      "utterance": "そうですよね、もっともだと思います",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:52:24",
      "utterance": "まずは、病院に行く前に、地域の保健所に連絡することがいいと思うのですが、自分で連絡できますか？",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:52:43",
      "utterance": "保健所？ですか？",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:52:52",
      "utterance": "警察にかかわりますか？",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:53:49",
      "utterance": "いえいえ、全く別の機関なので、あなたが誰にも言わないで欲しいことを伝えれば、大丈夫sですよ",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:54:02",
      "utterance": "そうなんですね…",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:54:25",
      "utterance": "病院、よりそっちがいいのはなぜですか？",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:55:14",
      "utterance": "あなたが未成年なので、保健所には、保健師さんがいて、産婦人科に行く時に付き添ってくれたり、橋渡しをしてくれると思います。",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:55:38",
      "utterance": "保健師さんは女性ですか？",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:56:47",
      "utterance": "そうです。そして、病院から親御さんに連絡されないためにも、保健師に同行してもらったほうがいいのではないかとおもいます。",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:57:32",
      "utterance": "そうなんですか…",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:57:54",
      "utterance": "あの",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:58:02",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:58:07",
      "utterance": "聞きにくいんですが…",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:58:20",
      "utterance": "もし",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:58:25",
      "utterance": "大丈夫ですよ。なんでも話してくださいね",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2021-11-11T16:58:40",
      "utterance": "妊娠していたら、どうなりますか？",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:59:34",
      "utterance": "いつまでに病院にいけばいいのかな、って、、",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T16:59:48",
      "utterance": "まだ話せない気がして",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T16:59:53",
      "utterance": "そうですね。心配ですよね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-11-11T17:00:13",
      "utterance": "話せない、とおっしゃるのは、親御さんにですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-11T17:00:15",
      "utterance": "学校も休めないし、親になんていおうか",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T17:00:27",
      "utterance": "保健師さんです",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T17:01:06",
      "utterance": "説明するのがつらくて",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T17:01:26",
      "utterance": "そうですよね。すぐにお話しするのはは難しいと思います。生理の予定日はいつですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-11T17:01:51",
      "utterance": "あと10日？とかあとです",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T17:02:13",
      "utterance": "多分…あまり気にしたことがなくて、すいません",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T17:02:37",
      "utterance": "そうなんですね。普段は気にしないですもんね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-11-11T17:02:44",
      "utterance": "はい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T17:04:39",
      "utterance": "それが正確なら、ですけど、もしかすると、危険日に近かったかもしれないので、できることなら、早めに受診はした方がいいのですが、保健士さんが同行しないとして、一人で行くことはできますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-11T17:05:21",
      "utterance": "いきたくないです",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T17:05:45",
      "utterance": "そうですよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-11-11T17:06:15",
      "utterance": "妊娠している可能性がたかいんですね",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T17:07:35",
      "utterance": "妊娠する可能性はもちろんゼロではありませんが、逆にいうと、妊娠って、簡単にできるものでもないので、確率で言うと、している方がずっと低いです",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2021-11-11T17:07:54",
      "utterance": "そうなんですか、、",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T17:08:51",
      "utterance": "はい。危険日でもできない方がずっと高いのですが、今なら妊娠を成立させない方法もあると思います",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2021-11-11T17:09:12",
      "utterance": "病院にいけばなんてかなりますか？",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T17:09:47",
      "utterance": "そうですね。今なら大丈夫だと思います",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2021-11-11T17:10:18",
      "utterance": "ただ、あなたが、周りの大人に話せないお気持ちもすごくよくわかるんです",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-11-11T17:10:32",
      "utterance": "わかりました、保健所に相談してみて、病院にいけそうか考えてみます",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T17:11:02",
      "utterance": "きいてもらえて、良かったです",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T17:12:03",
      "utterance": "こちらこそ私の提案を聞いてくれてありがとうございます。",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2021-11-11T17:12:17",
      "utterance": "はい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T17:12:34",
      "utterance": "とってもお話ししづらいことだったのに、本当に来てくれて嬉しいです",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2021-11-11T17:13:01",
      "utterance": "ありがとうございます、そんな風に言ってくれて",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-11-11T17:13:10",
      "utterance": "がんばります",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T17:13:51",
      "utterance": "ありがとうございます。保健師さんは、あなたを守ることが仕事なので、信頼してお話ししてくれればいいと思うのですが、苦しくなったら、いつでも来てくださいね",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2021-11-11T17:14:08",
      "utterance": "はい、そうします",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T17:14:36",
      "utterance": "私は、いつでもここにいるので、どうか、報告に来てくれれば嬉しいです。",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2021-11-11T17:14:57",
      "utterance": "今日はありがとうございました。またきます。",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-11T17:15:39",
      "utterance": "こちらこそ、ありがとうございました。またお話しできるのを待っていますね。今日はこれで終了しても大丈夫ですか？",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2021-11-11T17:15:48",
      "utterance": "はい、大丈夫です",
