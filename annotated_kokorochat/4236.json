{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2022-11-16T20:51:19",
      "utterance": "(こんばんは。本日はよろしくお願いいたします。お時間になりましたら始めさせていただきます。）",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2022-11-16T20:58:40",
      "utterance": "(こんばんは。よろしくお願いします。)",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:00:05",
      "utterance": "こんばんは。相談員です。本日はお越しくださり、ありがとうございます。はじめにご年齢、性別、相談内容を教えていただけますでしょうか。",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:00:46",
      "utterance": "32歳、女",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-11-16T21:00:57",
      "utterance": "生きるのに疲れました",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:01:46",
      "utterance": "ご相談にお越しくださり、ありがとうございます。",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:02:30",
      "utterance": "お話しできるところからで構いませんが、どのようなことでお困りなのでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:03:14",
      "utterance": "死にたい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:03:49",
      "utterance": "ええ、そのように感じておられるのですね。ちなみに今はどちらにおられますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:03:58",
      "utterance": "家です",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:05:01",
      "utterance": "そうなんですね。よくお話に来てくださいました。",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:06:05",
      "utterance": "いつ頃からそのように感じておられるのでしょうか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:06:16",
      "utterance": "覚えてません",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:07:26",
      "utterance": "そうだったのですね。死にたいくらい何か嫌な思いをされたのでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:08:01",
      "utterance": "いろいろ",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:08:44",
      "utterance": "そうだったのですね。例えば、どんなことがあったかお話できそうでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:10:03",
      "utterance": "仕事や家とか嫌な思いはそれなりにしてきました",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:11:13",
      "utterance": "ええ、そうだったのですね。その中でもあなたのなかで強い出来事がおありだったのですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:12:17",
      "utterance": "たぶん",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:13:48",
      "utterance": "ええ、そのことに関してこちらで聞かせていただけますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:15:08",
      "utterance": "なんかもう全部しんどいです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-11-16T21:15:25",
      "utterance": "絶対言わなきゃいけないんですか？",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:16:03",
      "utterance": "いえ、そういうわけではありませんよ。あなたがお話したいことだけで構いません",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:17:17",
      "utterance": "もう疲れちゃいました",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:18:24",
      "utterance": "ええ、色々なことが重なり、苦しんでおられるのですね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:19:36",
      "utterance": "最近はどのように過ごされているのですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:20:31",
      "utterance": "いろいろ",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:21:02",
      "utterance": "例えば、お仕事はいかがでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:21:14",
      "utterance": "してないです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:22:10",
      "utterance": "そうなのですね。では、おうちではいかがでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:22:39",
      "utterance": "家事とかしてます",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:23:23",
      "utterance": "そうなのですね。ご家族とお住まいなのでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:23:35",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:24:21",
      "utterance": "どなたと一緒にお住まいなのですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:24:38",
      "utterance": "子供1人です",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:25:03",
      "utterance": "ええ、お子様とお二人暮らしなのですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:27:24",
      "utterance": "先ほど、もう疲れたとおっしゃっていましたが、おうちのなかでなにかご苦労がおありだったのでしょうか",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:27:55",
      "utterance": "いろいろ",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-11-16T21:28:02",
      "utterance": "子育てとか",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:29:36",
      "utterance": "ええ、子育てにもお疲れなのですね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:33:00",
      "utterance": "例えば、子育てではどんなことが疲れるのでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:33:22",
      "utterance": "全部",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:34:13",
      "utterance": "あなたのなかで、いま全てが嫌になっておられるのですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:34:33",
      "utterance": "そうですね",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-11-16T21:34:57",
      "utterance": "終わりにしたい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:35:28",
      "utterance": "ええ、こんな気持ちになるなら終わりにしたいという感じでしょうか",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:35:54",
      "utterance": "はい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:39:05",
      "utterance": "そうなのですね。全部が嫌になると苦しいですよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:39:26",
      "utterance": "はい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-11-16T21:39:55",
      "utterance": "もう苦しみたくない",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-11-16T21:40:04",
      "utterance": "だから死にたい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:40:33",
      "utterance": "ええ、すべて手放して楽になりたいお気持ちなのですね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:40:43",
      "utterance": "はい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-11-16T21:40:58",
      "utterance": "もう死んでいいですか",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:42:10",
      "utterance": "それくらい今の状況を終わりにしたいのですね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:42:44",
      "utterance": "はい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:44:15",
      "utterance": "ええ、でもそのようなお気持ちがおありの中、本日このようにお話に来てくださったのですよね",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:45:27",
      "utterance": "最後に何か言ってこうかなと思って。",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:46:36",
      "utterance": "言いたいことや、吐き出したいこと他にもありますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:47:35",
      "utterance": "何だろ",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-11-16T21:48:10",
      "utterance": "もう別にいいかな",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-11-16T21:48:27",
      "utterance": "死んだら特に意味ないですし。",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:50:06",
      "utterance": "そのように考えておられるのですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:52:00",
      "utterance": "死ぬことはご自身のなかでもう決めてらっしゃるのですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:52:44",
      "utterance": "いずれはと思ってます",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:54:32",
      "utterance": "そうなのですね。今すぐではないのは何かあなたに思うところがあるのでしょうか",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:55:04",
      "utterance": "死ぬ方法を探し中です",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:56:05",
      "utterance": "そうだったのですね。探してみてどんなお気持ちなのでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:56:52",
      "utterance": "どれがマシな死に方かなと思ってます",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:58:20",
      "utterance": "苦しまない方法という感じでしょうか？",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:58:38",
      "utterance": "そんな感じですかね",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-16T21:59:38",
      "utterance": "そうなのですね。おひとりで死のうと考えていらっしゃるのでしょうか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:59:47",
      "utterance": "はい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-16T22:00:50",
      "utterance": "（すみません。時間配分が全くできておらず、終了時間がきてしまいました）",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2022-11-16T22:01:25",
      "utterance": "(承知しました。)",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-11-16T22:01:48",
      "utterance": "（途中となってしまいましたが、一旦終了の挨拶をさせていただきます。）",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2022-11-16T22:02:03",
      "utterance": "(お疲れ様でした。ありがとうございました。)",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-11-16T22:02:29",
      "utterance": "お話の途中となってしまいましたが、そろそろ終了の時間となってしまいました。本日はお越しくださり、ありがとうございました。",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2022-11-16T22:02:54",
      "utterance": "ありがとうございました。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-11-16T22:02:57",
      "utterance": "（ロープレありがとうございました。）",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2022-11-16T22:03:28",
      "utterance": "(こちらこそありがとうございました。)",
      "distress_level": 0,
      "disclosure_depth": 0
    }
  ],
