{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2021-07-06T09:52:20",
      "utterance": "こんにちは。本日は宜しくお願い致します。",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2021-07-06T09:53:25",
      "utterance": "(よろしくお願いいたします。何かリクエストとかありますか？)",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-07-06T09:54:25",
      "utterance": "すみません、リクエストとは、クライエントのリクエストのことでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T09:56:38",
      "utterance": "(はい、相談内容や年齢層などのご希望ありましたら伺います)",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-07-06T09:57:53",
      "utterance": "（やはりそうなんですね、すべてが勉強ですので、何でも頑張ってみます。ありがとうございます）",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2021-07-06T09:58:10",
      "utterance": "(はい、承知しました)",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-07-06T09:59:00",
      "utterance": "（時間になりましたら、始めさせていただきますね。）",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:00:44",
      "utterance": "こんにちは、相談員です。本日はお越しいただき、ありがとうございます。初めに、年齢と性別を教えていただけますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:01:21",
      "utterance": "14歳　女子です",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:01:54",
      "utterance": "ありがとうございます。今日は、どのような相談でしょう？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:02:11",
      "utterance": "友だちのことです",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:02:47",
      "utterance": "友達とは、学校の友達ですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:02:52",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:03:34",
      "utterance": "何かあったのか、言える範囲で教えていただけますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:03:56",
      "utterance": "3人で仲良くしてたんだけど",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:04:07",
      "utterance": "ええ",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:04:14",
      "utterance": "最近わたしだけハブられてる",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:04:36",
      "utterance": "それは悲しいですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:04:52",
      "utterance": "音楽教室から帰る時、置いて行かれたり",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:05:04",
      "utterance": "ええ",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:05:21",
      "utterance": "ほかにもあります？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:05:40",
      "utterance": "家庭科の授業中、2人だけで楽しそうにしてたり",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:06:02",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:06:05",
      "utterance": "嫌になって",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-07-06T10:06:10",
      "utterance": "離れました",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:06:31",
      "utterance": "とても悲しいことがあったんですね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:07:08",
      "utterance": "最近とはいつ頃からですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:07:24",
      "utterance": "2週間くらいかな",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:07:51",
      "utterance": "ほんとに最近まで、仲良くしてたんですね",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:08:01",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:09:43",
      "utterance": "なのに、そんなことになって、悲しいですね。二週間前に、何かきっかけのようなものは、あったんですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:10:00",
      "utterance": "わかんないです",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:10:41",
      "utterance": "急にそんなことになったんですね。それはもやもやしますよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:11:09",
      "utterance": "そうなんです",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:11:33",
      "utterance": "その子たちに、何か聞いたりしたことはありますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:12:37",
      "utterance": "先生に話して、1人の子と話したら、寝たら忘れるって言われてムカつきました",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:14:07",
      "utterance": "それはひどいですね。ちゃんと話をしたかったですよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:14:15",
      "utterance": "ひどいですよね",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:14:55",
      "utterance": "ひどいと思いますよ。傷つきますよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:15:16",
      "utterance": "そーなんです",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:15:31",
      "utterance": "では、その時は何も進展なかったのですね",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:16:29",
      "utterance": "はい、それで、もう1人の子と話そうか迷ってて、、",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-07-06T10:16:45",
      "utterance": "どうしたらいいと思いますか？",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:17:34",
      "utterance": "迷っているんですね？因みに、何と呼んで良いでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:17:48",
      "utterance": "みくです",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:18:28",
      "utterance": "みくさん、もう一人の子とは、話せそうです？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:18:58",
      "utterance": "うーん、それがどうしたらいいかわかんなくて",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-07-06T10:19:22",
      "utterance": "どうやってはなしたらいいかわかんない",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:19:47",
      "utterance": "話しかけるきっかけが？",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:19:58",
      "utterance": "それも不安",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:20:21",
      "utterance": "ええ、不安ですよね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:20:51",
      "utterance": "他にも心配なことあります？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:21:15",
      "utterance": "えー、他にも？そう言われるといっぱいある気がする",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-07-06T10:21:34",
      "utterance": "勉強もできないしね",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:21:40",
      "utterance": "うんうん、たくさんありすぎて、",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:21:52",
      "utterance": "お金もないし",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-07-06T10:21:56",
      "utterance": "遊べない",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:22:07",
      "utterance": "何も手につかなくなりそうですね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:22:13",
      "utterance": "親もうるさいし",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-07-06T10:22:24",
      "utterance": "だるー",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:22:26",
      "utterance": "そうなんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:23:08",
      "utterance": "もう一人の子とは、話したいですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:23:25",
      "utterance": "そうですね。。",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:23:53",
      "utterance": "聞きたいですよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:24:54",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:25:11",
      "utterance": "何か話せる雰囲気になれると良いですが、そんな時はありそう？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:25:35",
      "utterance": "それがどうしたらいいかわかんない",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:26:03",
      "utterance": "うんうん、難しいですね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:26:44",
      "utterance": "お家は遠いですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:27:22",
      "utterance": "その子と美玖さんのお家",
      "tag": "ClosedQuestion"
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:27:46",
      "utterance": "みくさんですね",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:27:54",
      "utterance": "30ぷん暗い",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-07-06T10:27:56",
      "utterance": "くらい",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-07-06T10:28:05",
      "utterance": "かな",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:28:51",
      "utterance": "じゃあ、登下校中とかは難しそうかな？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:29:26",
      "utterance": "でも、なんて言っていいかわかんない",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:30:33",
      "utterance": "そうですよね、直接はわからなくなりそうですね。緊張もしちゃいますよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:31:06",
      "utterance": "そうなんです",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:31:25",
      "utterance": "このことは、他の友達に話したことあります？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:31:41",
      "utterance": "ないです",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:32:29",
      "utterance": "誰か話せそうな人はいる？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:32:41",
      "utterance": "いない",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-07-06T10:33:02",
      "utterance": "他に仲良い友達もいないし",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:33:53",
      "utterance": "今までの友達が、大好きだったんだね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:34:48",
      "utterance": "なのに、こんなことになって、本当に悲しいよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:34:56",
      "utterance": "うーん、大好きっていうか中学入ってからずっと仲良かったし、ふつうに一緒にいた感じだから",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:35:13",
      "utterance": "うんうん",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:36:19",
      "utterance": "だから今は学校もうざい",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:36:49",
      "utterance": "そうだよね、そうなっちゃうよね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:37:33",
      "utterance": "例えば、前に同じような経験はある？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:37:52",
      "utterance": "ないです",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:37:55",
      "utterance": "小学校のときとか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:38:08",
      "utterance": "ないんだね",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:38:53",
      "utterance": "学校では、今一人でいる感じかな？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:39:09",
      "utterance": "そう、だからつまんない",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:39:36",
      "utterance": "つまんないよね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:40:52",
      "utterance": "さっき言ってた先生は、話聞いてくれるかな？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:41:16",
      "utterance": "どうかな、、わかんない",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:42:25",
      "utterance": "もう一度相談したら、何ていうかな",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:42:57",
      "utterance": "またか、っていうかもと思うと言いづらい",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:43:30",
      "utterance": "ほんとだね、言いづらいよね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:44:44",
      "utterance": "みくさんの気持ちは、もう一度仲良くしたいのかな？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:45:42",
      "utterance": "うん、やっぱり前みたいに3人で仲良くできたらなって思うけど、あっちはどう思ってるかわかんない",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-07-06T10:45:58",
      "utterance": "もう私なんていらないと思ってるんじゃないかな",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:47:05",
      "utterance": "仲良くしたいんだね。でも、みくさんのことどう思ってるかわからないから、聞くのが怖いんだね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:47:25",
      "utterance": "そうです",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:47:47",
      "utterance": "あきらめてるとこもある？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:48:54",
      "utterance": "そういわれるとそうかもしれない",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:51:27",
      "utterance": "直接は難しいし、伝えてくれそうな友達もいない。他に何かみくさんの気持ちを、伝える方法は何かないかしら。",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:52:05",
      "utterance": "それがわかんないです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:52:33",
      "utterance": "そうだよね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:54:27",
      "utterance": "私も同じようなことがあって、その時はお手紙を書いてみましたよ。すごくドキドキしたけど、正直にかいてみたの。",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:55:20",
      "utterance": "みくさんの件が、上手くいくかは分からないけど、そんな方法もありますよ",
      "tag": "Suggest"
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:56:22",
      "utterance": "どう思いますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:57:09",
      "utterance": "手紙ね。。自信ないけど考えてみます",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:57:41",
      "utterance": "ドキドキしますよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-07-06T10:58:08",
      "utterance": "バカみたいって思われないかな",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-07-06T10:58:19",
      "utterance": "うざいとか",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:58:24",
      "utterance": "みくさんの気持ち、きっと伝わりますよ",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:58:52",
      "utterance": "みくさんは、友達思いなんだなあと感じます",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2021-07-06T10:59:34",
      "utterance": "正直な気持ち、きっと伝わると思いますよ！",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2021-07-06T11:00:30",
      "utterance": "今日の相談は、他にはよかったですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-06T11:00:48",
      "utterance": "あ、はい大丈夫です",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-07-06T11:01:55",
      "utterance": "もし、また何かありましたら、また連絡くださいね、上手くいくこと祈ってます。応援してますよ！",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2021-07-06T11:02:36",
      "utterance": "はい、わかりました",
      "distress_level": 1,
