{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2021-11-12T20:00:14",
      "utterance": "こんばんは。本日はロールプレイよろしくお願いします。",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:00:31",
      "utterance": "よろしくお願いします",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:00:54",
      "utterance": "では早速ロールプレイをお願い致します。",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:01:21",
      "utterance": "お願いします",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:01:25",
      "utterance": "こんばんは。相談員です。本日はどういった相談でしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:01:40",
      "utterance": "こんばんは",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-11-12T20:01:50",
      "utterance": "今日は友人との関係についてです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:01:50",
      "utterance": "こんばんは。",
      "tag": "Greeting"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:02:10",
      "utterance": "そうなのですね。友人関係でお悩みなのですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:02:15",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-11-12T20:02:19",
      "utterance": "喧嘩をしました",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:03:10",
      "utterance": "どういったところでしんどさを感じておられるのか伺ってもよろしいでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:03:46",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-11-12T20:03:55",
      "utterance": "先週なのですが",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:04:07",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:04:10",
      "utterance": "友人とカフェでお話しをしておりまして",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:04:19",
      "utterance": "えぇ",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:04:44",
      "utterance": "お互いの仕事への価値観の話をしていました",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:05:11",
      "utterance": "そうでしたか",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:05:21",
      "utterance": "その友人は少し手を抜いてもいいという考えがあります",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:05:50",
      "utterance": "そうなのですね",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:06:13",
      "utterance": "私は仕事をしっかりしないといけないとおもい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-11-12T20:06:22",
      "utterance": "そこで意見の言い合いがはじまりました",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:06:25",
      "utterance": "えぇ",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:07:08",
      "utterance": "そこまだ深く話すつもりじゃなかったのですがだんだんと喧嘩のような会話になってしまい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:07:22",
      "utterance": "なるほど",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:07:28",
      "utterance": "最終的にはもういいといい私が先に出て行ってしまいました",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-11-12T20:07:44",
      "utterance": "後からいいすぎたとはおもっていたのですが",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:07:54",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:08:02",
      "utterance": "連絡が取りづらい状態です",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:08:14",
      "utterance": "なるほど",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:08:44",
      "utterance": "どうしていいのかわかりません",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:08:55",
      "utterance": "そうですよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:09:23",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:09:35",
      "utterance": "友達とはいえお互いの価値観の違いから生じた喧嘩ですから気まづい状態ですよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:09:43",
      "utterance": "そうですね",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:10:02",
      "utterance": "今日はあなたのありのままのお気持ちをお話しいただければと思います。",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:10:32",
      "utterance": "ありがとうございます",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:10:44",
      "utterance": "もちろんです。",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:11:08",
      "utterance": "そのご友人の方とはどういう風に付き合っていきたいとお考えですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:11:33",
      "utterance": "このまま切磋琢磨し、友人としても楽しめる関係を望んでいます",
      "distress_level": 0,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:11:45",
      "utterance": "なるほど。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:12:11",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:12:24",
      "utterance": "このまま、ということは以前から切磋琢磨し合う関係だったのですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:12:42",
      "utterance": "そうですねお互い職種が同じなので",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:12:58",
      "utterance": "なるほど。そうでしたか。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:13:04",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:13:26",
      "utterance": "あなたにとっても大切な存在だったのですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:13:45",
      "utterance": "そうですね",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-11-12T20:14:02",
      "utterance": "価値観以外は仲の良い関係だったと私はおもいます",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:14:09",
      "utterance": "なるほど。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:14:33",
      "utterance": "交友関係も深いお付き合いだったのですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:14:55",
      "utterance": "学校で一番仲がよかったとおもいます",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:15:34",
      "utterance": "そうでしたか。それは大切な存在ですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:15:39",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:16:11",
      "utterance": "以前に今回の喧嘩のようなものはありましたか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:16:29",
      "utterance": "いえ、仕事の愚痴はありましたが喧嘩にはなりませんでした",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:16:39",
      "utterance": "そうでしたか。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:16:48",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:17:03",
      "utterance": "それでは今回がお二人にとって初めての喧嘩ということなのですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:17:19",
      "utterance": "大きな喧嘩はそうですね",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-11-12T20:17:30",
      "utterance": "プライベートもここまではなかったです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:17:45",
      "utterance": "そうでしたか。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:18:01",
      "utterance": "それは心苦しい思いをされましたね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:18:26",
      "utterance": "いいすぎましたが一番心に残ってます",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:18:46",
      "utterance": "なるほど。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:19:03",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:19:10",
      "utterance": "言いすぎたというのはどういうことを言ってしまったのか教えていただけますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:19:29",
      "utterance": "その考え方ではだめだ",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-11-12T20:19:30",
      "utterance": "とか",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:19:36",
      "utterance": "えぇ",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:19:37",
      "utterance": "変えたほうがよいとか",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:19:47",
      "utterance": "なるほど",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:19:52",
      "utterance": "それだと周りに迷惑がかける",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-11-12T20:19:55",
      "utterance": "などでしょうか",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:20:11",
      "utterance": "そうなのですね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:20:24",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:21:15",
      "utterance": "何に対して迷惑だとおっしゃられたのですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:21:31",
      "utterance": "その考えでは",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:21:37",
      "utterance": "えぇ",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:21:52",
      "utterance": "適当な考えというか仕事はどれだけサボれるか",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-11-12T20:21:55",
      "utterance": "というかです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:22:04",
      "utterance": "なるほど",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:22:08",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:22:28",
      "utterance": "仕事に対する責任感についておっしゃられたのですね",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:22:45",
      "utterance": "そうですね",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:22:58",
      "utterance": "言ってみて相手の反応はいかがでしたか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:23:30",
      "utterance": "なんでそんなに怒るの？と",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-11-12T20:23:37",
      "utterance": "軽い反応でした",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:23:39",
      "utterance": "そうでしたか",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:23:45",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:23:51",
      "utterance": "その反応を見てどう感じましたか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:24:13",
      "utterance": "あ、そんな感じなんだと",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-11-12T20:24:16",
      "utterance": "思いました",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:24:20",
      "utterance": "なるほど。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:24:26",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:24:37",
      "utterance": "諦めに近いような感覚でしょうか？",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:24:59",
      "utterance": "怒りから諦めに変わった感じでしょうか",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:25:07",
      "utterance": "なるほど。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:25:23",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:25:51",
      "utterance": "仕事に対して責任感が無いような発言は聞いていてもしんどいですよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:25:59",
      "utterance": "そうですね",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-11-12T20:26:11",
      "utterance": "真面目にやってきた人への侮辱と思いました",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:26:28",
      "utterance": "そうでしたか。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:26:40",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:27:03",
      "utterance": "友人の方を思って言っておられたのに伝わっていないなと感じるのは心苦しいですよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:27:19",
      "utterance": "そうですね、、",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-11-12T20:27:27",
      "utterance": "しっかりしてほしかったなと",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:27:43",
      "utterance": "なるほど。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
