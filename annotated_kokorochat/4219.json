{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2022-11-11T14:51:42",
      "utterance": "こんにちは、15時からよろしくお願いいたします。",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2022-11-11T14:51:56",
      "utterance": "よろしくお願いいたします",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:00:02",
      "utterance": "（それでは始めます）",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:00:18",
      "utterance": "こんにちは、相談員です。",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:00:42",
      "utterance": "こんにちは",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:00:50",
      "utterance": "はじめに、あなたの年齢と性別を教えていただけますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:01:10",
      "utterance": "20代。女です",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:01:20",
      "utterance": "教えていただきありがとうございます。",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:01:36",
      "utterance": "今日はどのようなご相談でしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:02:44",
      "utterance": "生きている意味が分かりません。処方された薬を大量服薬することも考えますが、その気力もありません。",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:04:31",
      "utterance": "そのように感じていらっしゃるのですね。何か辛いこととかおありでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:05:44",
      "utterance": "すべてが、重たく感じて生きていたくありません。仕事も毎日行くのが難しい感じがします。",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:06:53",
      "utterance": "そうなんですか。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:08:38",
      "utterance": "全てが重たい・・・とてもしんどい状況なのですね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:09:52",
      "utterance": "その中でも、一番重たいと感じているのはどんなことでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:10:45",
      "utterance": "仕事のことでしょうか？それとも、人間関係とかでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:10:53",
      "utterance": "働かないとお金やばいのに、毎日働くのが、きびしいこと。",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-11-11T15:11:22",
      "utterance": "みんな、毎日よく働けるな、と思います",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-11-11T15:12:10",
      "utterance": "いっそ死んでしまいたい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:12:31",
      "utterance": "生活していくにはお金が必要ですよね。でも、そのために働かなくてはならないと思うと、気持ちが重たくなってしまうのですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:12:50",
      "utterance": "はい…",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:13:22",
      "utterance": "そう思うくらい、重たい気持ちなのですね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:13:31",
      "utterance": "はい…",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:14:49",
      "utterance": "２０代とのことですが、お勤めされてから何年くらい経つのでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:15:31",
      "utterance": "5年です。最近、転職しました。",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:15:53",
      "utterance": "そうだったのですね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:16:33",
      "utterance": "転職されたきっかけは、どんなことがあったのでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:17:30",
      "utterance": "もっと勤務を軽くしたかったので",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:17:53",
      "utterance": "そうでしたか。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:18:06",
      "utterance": "今の方が楽なはずなのに、欠勤もあります",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:19:16",
      "utterance": "欠勤されるのはどんな時でしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:20:20",
      "utterance": "朝体が重たくて、起きられない時です。たくさん寝すぎています。",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:21:43",
      "utterance": "そういう時があるのですね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:22:42",
      "utterance": "そうですね。稼がないと生活していけない",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-11-11T15:23:05",
      "utterance": "でも、何もやる気がおきません",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:24:27",
      "utterance": "何もやる気がしないので、朝起きる気にもならない、という感じでしょうか？",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:24:51",
      "utterance": "そうですね…",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:25:46",
      "utterance": "それはやるせないですね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:26:16",
      "utterance": "そんな風に感じるようになったのは、転職されてからですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:26:21",
      "utterance": "やるせないっていうか…",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:26:31",
      "utterance": "ええ。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:26:49",
      "utterance": "働き始めてからのような気もします",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:28:07",
      "utterance": "５年前からずっとそう感じていらしたのですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:28:31",
      "utterance": "まあ、そうかもしれません",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:30:47",
      "utterance": "そうでしたか。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:31:43",
      "utterance": "はい…",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:31:54",
      "utterance": "ちなみに、あなたは今はお一人で住んでいらっしゃるのですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:32:08",
      "utterance": "はい。",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:32:44",
      "utterance": "仕事以外のときは、どのように過ごされているのでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:33:21",
      "utterance": "だいたい寝ています。過眠ぎみだと思います",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:33:53",
      "utterance": "そうなんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:33:53",
      "utterance": "何もやる気が起きないので。楽に死ねないかな。",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:35:11",
      "utterance": "そんな風に思っていらっしゃるのですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:35:31",
      "utterance": "もう、何のために生きているのか分かりません。生きる意味ってなんですか？",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:37:34",
      "utterance": "生きる意味って何でしょうね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:39:36",
      "utterance": "私にははっきりとしたことは言えませんが、",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:40:08",
      "utterance": "あなたはそれが必要だと感じているのでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:41:28",
      "utterance": "そうですね。すべてむなしく、何で生きているのか、分からないです。",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-11-11T15:41:45",
      "utterance": "やっぱり病気でしょうかね？",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-11-11T15:42:04",
      "utterance": "私は、やっぱり病院に行くべきでしょうか？",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-11-11T15:42:31",
      "utterance": "私みたいな人間は、社会の荷物ですよね。",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:42:58",
      "utterance": "そんなことはないと思いますよ。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:44:21",
      "utterance": "以前、心療内科に行きましたか、金銭的に心配になりやめました",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:44:44",
      "utterance": "そうだったのですね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:45:08",
      "utterance": "そこでは、薬はもらいましたが、診断名は特にありませんでした",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:46:29",
      "utterance": "診断名が無くてもお薬がもらえたのですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:46:44",
      "utterance": "そうですね",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:49:18",
      "utterance": "診断を下してもらえないと、スッキリしなかったのではないでしょうか？",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:49:52",
      "utterance": "特に何も思わなかったです。そうなんだなーとしか。",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:50:15",
      "utterance": "そうだったのですね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:51:20",
      "utterance": "ここまでのお話をまとめさせていただいてもよろしいでしょうか？",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:51:32",
      "utterance": "はい。お願いします",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:54:06",
      "utterance": "あなたは、働き始めて５年になる。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:54:18",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:55:46",
      "utterance": "その当初から、何ごとにつけやる気がしなかった。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:56:22",
      "utterance": "何ごとにつけやる気が出なかった訳ではありません",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:57:00",
      "utterance": "そうだったんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:57:06",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:57:56",
      "utterance": "今は何もやる気がしないけれど、以前はやる気がすることがあったということでしょうか？",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2022-11-11T15:58:40",
      "utterance": "仕事に対しては、やる気があまりなかった、ということです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-11-11T15:58:56",
      "utterance": "以前は",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:59:38",
      "utterance": "以前は、仕事以外についてはいかがでしたか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2022-11-11T15:59:59",
      "utterance": "やる気という意味でですが。",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-11-11T16:00:06",
      "utterance": "これから話すのですか？",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "client",
      "time": "2022-11-11T16:00:46",
      "utterance": "(終わりの時間ですが…",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-11-11T16:01:43",
      "utterance": "よろしければ、そのことについて、またお話に来ていただけたらと思います。",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2022-11-11T16:01:59",
      "utterance": "はい。分かりました。",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-11-11T16:02:20",
      "utterance": "今日は相談しにきて来てくださりありがとうございました。",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2022-11-11T16:02:30",
      "utterance": "ありがとうございました",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-11-11T16:02:47",
      "utterance": "それでは、今日のご相談を終わらせていただきます。",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2022-11-11T16:03:05",
      "utterance": "はい。ありがとうございました",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-11-11T16:03:30",
      "utterance": "（お疲れ様でした。ありがとうございました。辛口のコメントをお待ちしています。）",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2022-11-11T16:03:47",
      "utterance": "(ありがとうございました。了解しました)",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-11-11T16:04:00",
      "utterance": "（それではロールプレイを終了してもよろしいですね。）",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2022-11-11T16:04:59",
      "utterance": "（終了します。）",
      "tag": "Other"
    }
  ],
