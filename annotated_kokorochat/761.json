      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-20T15:53:58",
      "utterance": "少し早いですが、始めてもよろしいでしょうか勿論、時間どうりでも、構いません",
