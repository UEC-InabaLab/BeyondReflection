    },
    {
      "role": "client",
      "time": "2020-11-20T16:15:54",
      "utterance": "呆れますね",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-11-20T16:16:33",
      "utterance": "そうなんですね…呆れるほど、ひどいのですね",
