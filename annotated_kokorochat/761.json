      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-11-20T16:08:10",
      "utterance": "要するに",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-11-20T16:08:27",
      "utterance": "そうなんですね・・",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-11-20T16:08:32",
      "utterance": "優柔不断なんですよね",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-11-20T16:09:00",
      "utterance": "そうなんですね・・それは、戸惑われますよね",
