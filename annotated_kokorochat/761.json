      "role": "client",
      "time": "2020-11-20T16:40:20",
      "utterance": "そうですね考えてみれば",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-11-20T16:40:30",
      "utterance": "ええ、",
