    },
    {
      "role": "client",
      "time": "2020-11-20T16:09:38",
      "utterance": "まー呆れるかな",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-11-20T16:10:18",
      "utterance": "決められない人、",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-11-20T16:10:49",
      "utterance": "そうなんですね・・一緒にいると、お辛いですよね",
