    },
    {
      "role": "client",
      "time": "2020-11-20T15:54:12",
      "utterance": "はい、大丈夫です",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-20T15:54:35",
      "utterance": "それでは、始めます",
