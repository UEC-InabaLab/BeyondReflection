    },
    {
      "role": "client",
      "time": "2020-11-20T16:14:23",
      "utterance": "まずは、片付ける事はずっと先送り、小さい事も全部そう。",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-11-20T16:15:19",
      "utterance": "自分の事も、みんな",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-11-20T16:15:41",
      "utterance": "そうなんですか・・すべてを、先送りしてしまうのですね困ってしまいますよね",
