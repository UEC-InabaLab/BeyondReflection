    },
    {
      "role": "client",
      "time": "2020-11-20T16:11:15",
      "utterance": "家出て、独立しようかと思います",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-11-20T16:12:08",
      "utterance": "そっか・・そこまで、切羽詰まっているのですね",
