      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-20T15:55:21",
      "utterance": "こんにちは相談員です今日は、ご相談に来ていただき、ありがとうございますよろしくお願いします",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2020-11-20T15:55:29",
      "utterance": "お願いします",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-20T15:55:55",
      "utterance": "今日は、どのようなご相談で、お越しいただきましたか",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-11-20T15:56:07",
      "utterance": "父親とのことで悩んでいます",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-11-20T15:56:17",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-11-20T15:56:22",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-11-20T15:56:58",
      "utterance": "始めに、年齢、性別、何とお呼びしたらよいか、教えていただきますか",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-11-20T15:57:39",
      "utterance": "40代　女性　くる、です",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-11-20T15:58:36",
      "utterance": "教えていただき、ありがとうございますくるさんですね",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2020-11-20T15:58:43",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-11-20T15:59:38",
      "utterance": "お悩みのことについて、もう少し、教えていただけますか",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-11-20T16:00:37",
      "utterance": "最近、父と私の関係について、考える事が多くなりました",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-11-20T16:01:04",
      "utterance": "そうなんですねどのようなことを、考えるのですか",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-11-20T16:02:16",
      "utterance": "父とは、合わない、いい加減なとこが、嫌いだな、って気づきました",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-11-20T16:03:43",
      "utterance": "そうなんですね・・・くるさんとは、合わないと思われたのですね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-11-20T16:04:23",
      "utterance": "毎日毎日いろいろあって、",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-11-20T16:04:47",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-11-20T16:05:01",
      "utterance": "どのようなことが、あるのですか",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-11-20T16:05:51",
      "utterance": "いっぱいありすぎて、、、まー",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-11-20T16:06:19",
      "utterance": "そうなんですね・・・お困りなんですね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-11-20T16:06:49",
      "utterance": "困ってるってのとはちと、違うかも",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-11-20T16:07:01",
      "utterance": "いっぱいありすぎるのも、嫌ですよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-11-20T16:07:17",
      "utterance": "とにかく",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-11-20T16:07:25",
      "utterance": "はい、",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-11-20T16:07:54",
      "utterance": "片付けられないとか、指摘しても、先送りばかり",
