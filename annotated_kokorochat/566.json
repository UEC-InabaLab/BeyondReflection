      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:21:11",
      "utterance": "そうですよね",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-10-14T17:21:15",
      "utterance": "もう自信も無くなってしまって…",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:21:51",
      "utterance": "そうなんですね・・・自信がなくなると、悲しくなりますよね",
