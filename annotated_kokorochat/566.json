    },
    {
      "role": "client",
      "time": "2020-10-14T17:23:45",
      "utterance": "もう消えてしまいたいと思う時もあります",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:24:20",
      "utterance": "もう消えてしまいたいと思ってしまうほど、お辛いのですね",
