    },
    {
      "role": "client",
      "time": "2020-10-14T16:57:13",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-10-14T16:57:22",
      "utterance": "どのような様子なのですか",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-10-14T16:58:07",
      "utterance": "年配の社員さんがとても怖い人で",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-10-14T16:58:31",
      "utterance": "そうなんですね",
