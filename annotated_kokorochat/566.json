    },
    {
      "role": "client",
      "time": "2020-10-14T17:09:20",
      "utterance": "はいお願いします",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:09:56",
      "utterance": "最初に、怒られたのは、どのようなきっかけからですか",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-10-14T17:11:07",
      "utterance": "工場内で業者相手に見積もりを依頼する仕事をしているのですが、",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:11:21",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-10-14T17:11:55",
      "utterance": "業者に送る仕様内容を間違って古い内容を送ってしまったのです…",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:12:19",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-10-14T17:12:36",
      "utterance": "そしたらカンカンに怒られて…",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:12:55",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:13:02",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-10-14T17:13:19",
      "utterance": "「お前何やっとんじゃ」",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:13:33",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-10-14T17:13:45",
      "utterance": "「アホか！」",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-10-14T17:13:53",
      "utterance": "と言われました",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:13:53",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-10-14T17:14:25",
      "utterance": "これでも軽い方です",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:14:25",
      "utterance": "そうなんですね・・・言葉も、悪いのですね",
