    },
    {
      "role": "client",
      "time": "2020-10-14T17:00:08",
      "utterance": "はい、もう会社に行きたくなくなります",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:00:56",
      "utterance": "そうなんですね・・・嫌ですよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-10-14T17:01:20",
      "utterance": "はい、もう嫌で嫌で仕方ないです",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:02:16",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-10-14T17:02:33",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:02:58",
      "utterance": "いつ頃からですか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-10-14T17:04:16",
      "utterance": "実は私は派遣社員で半年前に入社したのですが、",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:04:29",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-10-14T17:04:42",
      "utterance": "最初はまだそんなに感じていなかったのですが",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:04:53",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-10-14T17:05:21",
      "utterance": "徐々に怒られる回数が増えてきてしまって…",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:06:05",
      "utterance": "そうなんですね・・・それは、悔しいですよね",
