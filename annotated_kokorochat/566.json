    },
    {
      "role": "client",
      "time": "2020-10-14T17:06:42",
      "utterance": "とにかく怖いです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:07:32",
      "utterance": "そうなんですね・・・不安なのですね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-10-14T17:08:07",
      "utterance": "はい、これからどうしていったらいいのか、とても不安です",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:08:59",
      "utterance": "そうなんですねこれからどうしていったらよいか、一緒に考えていきましょう",
