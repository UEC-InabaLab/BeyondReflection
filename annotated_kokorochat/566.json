    },
    {
      "role": "client",
      "time": "2020-10-14T17:25:06",
      "utterance": "はい、どうしたら楽になれるなかなって",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-10-14T17:25:38",
      "utterance": "もう楽になりたいです",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:26:04",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-10-14T17:26:29",
      "utterance": "私は働くのは向いてないのかなって思います",
