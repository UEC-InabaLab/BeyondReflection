      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:33:25",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:33:33",
      "utterance": "でも、",
