    },
    {
      "role": "client",
      "time": "2020-10-14T16:56:36",
      "utterance": "職場でパワハラを受けていて悩んでます",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-10-14T16:57:03",
      "utterance": "そうなんですねそれは、苦しいですよね",
