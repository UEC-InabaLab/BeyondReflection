{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2020-10-14T16:55:21",
      "utterance": "こんにちは相談員です。相談に来ていただきまして、ありがとうございます",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2020-10-14T16:55:41",
      "utterance": "はい、よろしくお願いします",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-10-14T16:55:44",
      "utterance": "よろしくお願いします",
      "tag": "Greeting"
    },
    {
      "role": "counselor",
      "time": "2020-10-14T16:56:11",
      "utterance": "今日は、どのようなご相談ですか",
