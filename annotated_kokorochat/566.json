    },
    {
      "role": "client",
      "time": "2020-10-14T16:58:33",
      "utterance": "ことあるごとに怒られるんです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-10-14T16:58:55",
      "utterance": "言葉が汚いとうか",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-10-14T16:59:09",
      "utterance": "とにかく怖くて仕方ありません",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-10-14T16:59:41",
      "utterance": "そうなんですね落ち着く暇もないですよね",
