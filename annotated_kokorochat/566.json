      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-10-14T17:33:10",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-10-14T17:33:10",
      "utterance": "私はダメな人間だと思って生きてきた気がします",
