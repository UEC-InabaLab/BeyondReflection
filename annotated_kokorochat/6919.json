      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2024-05-24T19:00:02",
      "utterance": "こんばんは、相談員です。よろしくお願いします。はじめに年齢、性別、相談内容を教えてください。",
      "tag": "ClosedQuestion"
    },
    {
