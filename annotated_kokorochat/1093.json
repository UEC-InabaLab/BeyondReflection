    },
    {
      "role": "client",
      "time": "2020-12-31T13:58:23",
      "utterance": "今、外お兄ちゃんもお姉ちゃんも両親が希望した大学いったの",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-31T13:58:48",
      "utterance": "そうなんですね。希望した大学に行った…",
