      "time": "2020-12-31T13:50:24",
      "utterance": "うん",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-31T13:50:46",
      "utterance": "教えてくれてありがとうございますどんなことがあったのか…詳しく聞いてもいいですか？",
