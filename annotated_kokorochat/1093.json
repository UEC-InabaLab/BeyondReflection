      "role": "client",
      "time": "2020-12-31T13:49:46",
      "utterance": "もう死にたい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-31T13:50:12",
      "utterance": "なるほど…そう思われるほど、お辛く思われれているのですね、",
