      "time": "2020-12-31T13:42:34",
      "utterance": "わかりました。よろしくお願いします。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T13:49:26",
      "utterance": "こんにちは 相談員です。よろしくお願いします。",
