    },
    {
      "role": "client",
      "time": "2021-07-12T10:05:30",
      "utterance": "一緒に居るのはいいんだけど、いつもはどうかな…って",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-07-12T10:06:16",
      "utterance": "そうなんですね。いつも一緒は窮屈にかんじるのですね",
