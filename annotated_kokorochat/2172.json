    },
    {
      "role": "client",
      "time": "2021-07-12T10:28:45",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-07-12T10:29:08",
      "utterance": "うんうん、嬉しく思いますよね。",
