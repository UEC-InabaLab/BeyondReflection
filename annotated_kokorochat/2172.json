      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-07-12T10:23:33",
      "utterance": "ええ",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-07-12T10:25:07",
      "utterance": "最近は、LINEでも即レスしないと怒ってくるそれが嫌",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-07-12T10:25:53",
      "utterance": "それは窮屈ですね。気持ちとしては、もっと自由がいいなぁとか、思います？",
