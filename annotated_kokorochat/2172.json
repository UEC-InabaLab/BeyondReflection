{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2021-07-12T09:51:17",
      "utterance": "こんにちは。本日はよろしくお願い致します。",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2021-07-12T09:55:40",
      "utterance": "こちらこそ、よろしくお願いいたします。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-07-12T09:57:42",
      "utterance": "少し早いですが、始めさせていいただいても、大丈夫ですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-12T09:58:05",
      "utterance": "はい。大丈夫です。お願いいたします。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-07-12T09:58:09",
      "utterance": "では始めさせていただきますね。",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2021-07-12T09:58:43",
      "utterance": "こんにちは、相談員です。本日はお越しいただき、ありがとうございます。",
      "tag": "Greeting"
    },
    {
      "role": "counselor",
      "time": "2021-07-12T09:59:09",
      "utterance": "本日は、どのようなご相談でしょうか？",
      "tag": "OpenQuestion"
    },
