    },
    {
      "role": "client",
      "time": "2021-07-12T10:19:49",
      "utterance": "他にも友達いたから、みんなで帰ろうって言いました",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-07-12T10:22:02",
      "utterance": "そうねんですね、いつも一緒に帰らないとダメって感じなんて、ちょっと大変ですよね。そんなときの、のんさんはどんな気持ちでした？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-07-12T10:23:26",
      "utterance": "何回かはそれでかわしてきたんだけど、、、、",
