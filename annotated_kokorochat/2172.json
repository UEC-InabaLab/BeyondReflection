      "role": "counselor",
      "time": "2021-07-12T10:40:44",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-07-12T10:41:06",
      "utterance": "まだ返事で来てなくって、",
