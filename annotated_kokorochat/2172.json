    },
    {
      "role": "client",
      "time": "2021-07-12T10:16:38",
      "utterance": "時々ありました",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-07-12T10:17:01",
      "utterance": "はい、どんな感じでした？",
