    },
    {
      "role": "client",
      "time": "2024-05-06T19:34:12",
      "utterance": "そう",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:34:28",
      "utterance": "あなたは、そんなことない！って思うよね。",
