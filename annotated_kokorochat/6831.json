{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2024-05-06T18:54:21",
      "utterance": "（こんばんは、本日はよろしくお願いいたします。）",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2024-05-06T18:54:48",
      "utterance": "（こんばんはこちらこそ宜しくお願い致します）",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2024-05-06T18:57:05",
      "utterance": "（リクエストなのですが、中学、高校生あたりの方のお悩みでお願いできたらありがたいのですが、いかがでしょうか？）",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-06T18:58:37",
      "utterance": "（中学・高校生って事ですかね）",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2024-05-06T18:59:07",
      "utterance": "（はい、そうです）",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2024-05-06T18:59:28",
      "utterance": "（わかりました）",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:00:00",
      "utterance": "（ありがとうございます、よろしくおねがいいたします。）",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:00:29",
      "utterance": "こんばんは、相談員です。よろしくお願いいたします。",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2024-05-06T19:00:41",
      "utterance": "こんばんは",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "client",
      "time": "2024-05-06T19:00:59",
      "utterance": "宜しくお願いします",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:01:00",
      "utterance": "始めに、性別、年齢、相談内容を教えてください。",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-06T19:02:42",
      "utterance": "15歳　女性　学校に行きたないんです",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:03:04",
      "utterance": "お返事ありがとうございます。",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:03:29",
      "utterance": "学校のことで悩んでいるんですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2024-05-06T19:03:35",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:04:07",
      "utterance": "どんなことがあったのかな？",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:04:50",
      "utterance": "話せるところからで、大丈夫ですよ。",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2024-05-06T19:05:10",
      "utterance": "はい特に何も無いけど学校がつまらないし高校受験とか不安だし",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:05:34",
      "utterance": "うんうん、そうなんだね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2024-05-06T19:05:41",
      "utterance": "そう",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:06:26",
      "utterance": "学校受験、、今年受験生かな？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:07:33",
      "utterance": "中学3年生ですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-06T19:07:34",
      "utterance": "そう三年生になって先生とかみんな言ってるけどまだまだなのにって思うし　よくわかんないし",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:08:01",
      "utterance": "うんうん、どうなんだね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2024-05-06T19:08:12",
      "utterance": "うん",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:08:15",
      "utterance": "受験は、不安だよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2024-05-06T19:08:27",
      "utterance": "そー頭悪いし",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:08:59",
      "utterance": "そう、自分で感じてしまっているんですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2024-05-06T19:09:12",
      "utterance": "そう",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:09:18",
      "utterance": "勉強は、苦手？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-06T19:09:52",
      "utterance": "うん面白くないしテストとかダルいし",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:10:31",
      "utterance": "なるほど、テストがだるいんだね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2024-05-06T19:10:40",
      "utterance": "そう",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:11:18",
      "utterance": "学校がつまらないと言ってたけど、主に勉強が嫌でつまらない感じですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-06T19:12:12",
      "utterance": "そうかな…",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2024-05-06T19:12:40",
      "utterance": "友達とかもまだ出来でないし",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:13:00",
      "utterance": "そうなんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:13:20",
      "utterance": "まだ、クラス替えしてまもないのかな？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-06T19:14:11",
      "utterance": "そう三年生になって１ヶ月くらいだけど周りはグループできちゃったけど　なんか馴染めなくて",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:14:51",
      "utterance": "そっか、そっか、、そうすると学校がつまらないよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2024-05-06T19:14:57",
      "utterance": "そう",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:15:37",
      "utterance": "うんうん、お昼ご飯とかはどうしてるの？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-06T19:16:05",
      "utterance": "お昼ご飯は自分の席で食べてる",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:16:40",
      "utterance": "そうなんだね、もしかして一人で食べているのかな？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-06T19:17:05",
      "utterance": "あーでもまだみんなも席で食べてるから",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:17:44",
      "utterance": "そうなんだね、それならまだ寂しくないかな？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:17:58",
      "utterance": "でも、お友達と食べたいよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2024-05-06T19:19:17",
      "utterance": "あーでもコロナがあってからうちの学校は席でってなったからそお昼ご飯は大丈夫",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:20:03",
      "utterance": "そっか、そっか、ちゃんとコロナ対策ができてる学校なんだね。",
