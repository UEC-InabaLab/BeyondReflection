    {
      "role": "client",
      "time": "2024-05-06T19:29:55",
      "utterance": "そうそう",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:30:19",
      "utterance": "ちなみに、受験したい学校はあるの？",
