    },
    {
      "role": "client",
      "time": "2024-05-06T19:21:36",
      "utterance": "そうかな",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2024-05-06T19:21:44",
      "utterance": "よくわかんない",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:22:16",
      "utterance": "そっか。でも、そんな学校がつまらないのは、",
