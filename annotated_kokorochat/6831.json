    },
    {
      "role": "client",
      "time": "2024-05-06T19:20:49",
      "utterance": "まぁ…そうかな",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:21:24",
      "utterance": "うん、相談員はそう思いましたよ。",
