      "role": "client",
      "time": "2024-05-06T19:24:06",
      "utterance": "うん…",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:24:48",
      "utterance": "一緒に考えたいので、少しこちらから質問しても良いですか？",
