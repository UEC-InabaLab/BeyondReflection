    },
    {
      "role": "client",
      "time": "2024-05-06T19:44:04",
      "utterance": "そうゆうのあるのかな…",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:44:45",
      "utterance": "うん、、そうだね。探して見ないと分からないね。",
      "tag": "Inform"
    },
