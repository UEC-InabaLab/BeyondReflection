    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:38:18",
      "utterance": "好きなことや、科目って何かあるかな？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2024-05-06T19:38:59",
      "utterance": "漫画とか絵をかくのは好きだけど",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:39:17",
      "utterance": "うんうん、",
