    },
    {
      "role": "client",
      "time": "2024-05-06T19:26:12",
      "utterance": "受験かな…",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:26:32",
      "utterance": "そうなんですね。",
