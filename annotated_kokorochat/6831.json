      "role": "client",
      "time": "2024-05-06T19:27:18",
      "utterance": "そうよくわかんないし",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:28:10",
      "utterance": "うんうん、一番不安なことって、受験についてわからないことがあるからなのかな？",
