    },
    {
      "role": "client",
      "time": "2024-05-06T19:33:34",
      "utterance": "そう嫌になる",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:33:58",
      "utterance": "そうだよね、嫌な気分になるよね。",
