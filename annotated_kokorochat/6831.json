    },
    {
      "role": "client",
      "time": "2024-05-06T19:20:11",
      "utterance": "一応ね",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:20:29",
      "utterance": "うんうん、とっても良い学校だね。",
