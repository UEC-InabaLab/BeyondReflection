    },
    {
      "role": "client",
      "time": "2024-05-06T19:24:55",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:25:06",
      "utterance": "ありがとうございます。",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:25:51",
      "utterance": "一番嫌なのは、受験のこと？それともお友達がまだできていないことかな？",
