    },
    {
      "role": "client",
      "time": "2024-05-06T19:34:38",
      "utterance": "そうかな",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2024-05-06T19:35:01",
      "utterance": "でも頭悪いのは確か",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:35:27",
      "utterance": "そんなことないと私は思いますよ。",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:35:41",
      "utterance": "誰だって",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2024-05-06T19:35:41",
      "utterance": "なんで？",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:35:57",
      "utterance": "得意、不得意があるもの。",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2024-05-06T19:36:10",
      "utterance": "まーそうだけど",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:36:30",
      "utterance": "うんうん、そうだよね。",
