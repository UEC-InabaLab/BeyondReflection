    },
    {
      "role": "client",
      "time": "2022-01-18T13:18:53",
      "utterance": "どうなんでしょうか？一度、急に大声をだしたので",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:19:15",
      "utterance": "大声ですか",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:19:18",
      "utterance": "そんな事したら嫌われるよって、",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:19:26",
      "utterance": "ええ",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:19:32",
      "utterance": "勇気を出して",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2022-01-18T13:19:44",
      "utterance": "言ったんですが",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:19:46",
      "utterance": "言ってあげたんですか",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:19:50",
      "utterance": "は？",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-01-18T13:19:57",
      "utterance": "みたいな感じで",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:20:20",
      "utterance": "反応がちょっと怖いですよね",
