    },
    {
      "role": "client",
      "time": "2022-01-18T13:28:04",
      "utterance": "他には特にないです",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:28:21",
      "utterance": "そうなんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:29:03",
      "utterance": "その子の親御さんはどんなかたかは知りませんか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:29:41",
      "utterance": "わかりません。。。",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:29:51",
      "utterance": "そうなんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:30:06",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:30:46",
      "utterance": "急に怒って来るのは、どんな話の時がおおいでしょうか",
