    },
    {
      "role": "client",
      "time": "2022-01-18T13:17:07",
      "utterance": "でも",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:17:15",
      "utterance": "誰かしらとはいるんですね",
