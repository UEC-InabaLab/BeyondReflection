    },
    {
      "role": "client",
      "time": "2022-01-18T13:20:24",
      "utterance": "わかってなさそうでした",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:20:38",
      "utterance": "周りのお友達大丈夫でしたか",
