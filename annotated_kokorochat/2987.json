    },
    {
      "role": "client",
      "time": "2022-01-18T13:21:02",
      "utterance": "他の人が、先生にも言ったみたいなんですが",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:21:20",
      "utterance": "わかってないのが一番迷惑ですよね",
