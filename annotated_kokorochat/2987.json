      "role": "client",
      "time": "2022-01-18T13:35:49",
      "utterance": "そうなんです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:35:57",
      "utterance": "クラスでどうしようもないみたいですし",
      "tag": "Reflection"
    },
    {
