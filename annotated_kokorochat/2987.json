    },
    {
      "role": "client",
      "time": "2022-01-18T13:17:16",
      "utterance": "やっぱり他の人も",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:17:23",
      "utterance": "ええ",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:17:25",
      "utterance": "嫌そうです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:17:36",
      "utterance": "そうなんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:18:10",
      "utterance": "その人嫌われてるの自分で気づいてはいない感じですか",
