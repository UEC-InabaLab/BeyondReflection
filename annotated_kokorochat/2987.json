{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2022-01-18T12:53:51",
      "utterance": "「本日よろしくお願いいたします。」",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2022-01-18T12:55:56",
      "utterance": "よろしくお願いします。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-01-18T12:56:48",
      "utterance": "何かリクエスト希望あれば気軽に相談してくださいね宜しくお願い致します。",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2022-01-18T12:57:31",
      "utterance": "「時間になりましたら始めますね宜しくお願い致します。」",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2022-01-18T12:57:49",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "client",
      "time": "2022-01-18T12:57:53",
      "utterance": "よろしくお願いします。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-01-18T12:58:12",
      "utterance": "こちらこそよろしくお願いします",
      "tag": "Greeting"
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:00:30",
      "utterance": "本日は相談に来てくれてありがとうございます。はじめに年齢、性別、宜しくお願い致します。",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:00:50",
      "utterance": "１６歳　男です",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:01:35",
      "utterance": "ありがとうございます。本日の相談内容と呼んでも大丈夫なお名前も宜しくお願い致します。",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:02:40",
      "utterance": "山田です。学校ですぐ感情的になる人がいて悩んでます。",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:03:14",
      "utterance": "山田さん相談ありがとうございます。",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:04:21",
      "utterance": "学校で感情的になる人がいてその人のことで相談に来られたんですね",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:04:33",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:05:07",
      "utterance": "その方についてもう少し詳しく聴いても大丈夫ですか",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:06:10",
      "utterance": "はい！急に怒りだしたり、話もしていないのに話しに割り込んできたりします",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:06:23",
      "utterance": "ええ",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:07:04",
      "utterance": "急に話に割り込んできてしまう人がいるんですね",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:07:32",
      "utterance": "はい、周りの人も変なやつだと言っていて",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:07:38",
      "utterance": "急に怒り出されるとビックリしませんでしたか",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:07:50",
      "utterance": "ビックリします",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:08:35",
      "utterance": "そうですよね急にだとよりビックリしたりすると思うので",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:09:05",
      "utterance": "その人は同じクラスの人ですか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:09:19",
      "utterance": "同じクラスです",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:09:32",
      "utterance": "そうなんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:09:58",
      "utterance": "今まで話したりすることはありましたか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:10:46",
      "utterance": "クラスメイトなので、話しかけられたらするくらいです。仲が凄いいいわけでもないです、、、",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:10:58",
      "utterance": "そうなんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:11:39",
      "utterance": "急に怒ったり、大きな声を",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-01-18T13:11:44",
      "utterance": "出されると",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:11:53",
      "utterance": "その人は普段からよく人の話に入ってくる人ですか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:11:54",
      "utterance": "ビクビクしちゃうんです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-01-18T13:12:04",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-01-18T13:12:24",
      "utterance": "他の人と話してる時に",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:12:32",
      "utterance": "ビクビクしちゃいますよね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:12:37",
      "utterance": "ええ",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:12:41",
      "utterance": "自分の話をしてきます",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:12:51",
      "utterance": "そうなんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:13:15",
      "utterance": "誰の話でも入ってきちゃうんですか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:13:17",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-01-18T13:13:24",
      "utterance": "みてると",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:13:33",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:13:39",
      "utterance": "その時感心を持った人に",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:13:46",
      "utterance": "ええ",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:13:53",
      "utterance": "行ってる感じがします",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:14:03",
      "utterance": "そうなんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:14:33",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:14:44",
      "utterance": "その人はクラスに友達や仲良くしてる人はいますか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:15:48",
      "utterance": "よく、1人でいるのをみますが、、、多分。自分から無理やり、話しにいくので",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:16:13",
      "utterance": "ええ",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:16:15",
      "utterance": "誰かしらとはいるのは、みます",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:16:22",
      "utterance": "そうな",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:16:41",
      "utterance": "そうなんですね。失礼いたしました。",
