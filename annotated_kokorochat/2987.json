    },
    {
      "role": "client",
      "time": "2022-01-18T13:21:20",
      "utterance": "その子は、変わらないです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:21:29",
      "utterance": "そうなんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:21:44",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:21:58",
      "utterance": "注意されても変わらないのは困りますよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:22:22",
      "utterance": "はい、困るし、ちょっと",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-01-18T13:22:27",
      "utterance": "怖いです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:23:13",
      "utterance": "ちょっと、いやだいぶ変わっていますし怖いですよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:23:34",
      "utterance": "そうなんです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:23:55",
      "utterance": "頻繫にあるなら余計にそうだと思うので",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:24:37",
      "utterance": "クラスでそのことについて話し合いとかは難しそうですか",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:25:27",
      "utterance": "そうですね。先生に言ってもなにもしてくれないですし。無視してる人達も多い",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-01-18T13:25:30",
      "utterance": "ので",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:25:41",
      "utterance": "ええ",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:25:43",
      "utterance": "難しいと思います。。。",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:26:09",
      "utterance": "それは、とても困りましたね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-01-18T13:26:22",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-01-18T13:26:54",
      "utterance": "他にクラスで困ったことはありますか",
