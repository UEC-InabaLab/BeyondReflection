    },
    {
      "role": "client",
      "time": "2022-03-22T21:33:43",
      "utterance": "あんまり話したくない",
      "distress_level": 3,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:34:53",
      "utterance": "たしかに、パワハラとか、つらいとかは、なかなか両親であっても相談しづらいですよね。",
