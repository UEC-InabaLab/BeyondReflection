      "role": "client",
      "time": "2022-03-22T21:22:04",
      "utterance": "よくわからないから",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-03-22T21:22:08",
      "utterance": "いろいろと",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:22:40",
      "utterance": "色々とよくわからない感じなんですね。",
