      "role": "client",
      "time": "2022-03-22T21:44:07",
      "utterance": "だからわからない",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:44:41",
      "utterance": "そうですか、わからないんですね。。。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-03-22T21:45:04",
      "utterance": "コロナ禍で先が見えないし",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-03-22T21:45:16",
      "utterance": "会社もどうなるかわからないし",
