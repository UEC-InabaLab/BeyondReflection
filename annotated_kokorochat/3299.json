    },
    {
      "role": "client",
      "time": "2022-03-22T21:49:21",
      "utterance": "消えたい",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:49:50",
      "utterance": "ええ、そんな限界な感じなんですね。病院には、もう通院されましたか？",
