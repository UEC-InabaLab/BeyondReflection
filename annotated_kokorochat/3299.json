      "role": "client",
      "time": "2022-03-22T21:13:09",
      "utterance": "はい、、",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:13:43",
      "utterance": "2ヶ月ぐらい前から、とのことですが、なにかきっかけでもあったのでしょうか。",
