    },
    {
      "role": "client",
      "time": "2022-03-22T21:39:46",
      "utterance": "私の話を聞いてくれるところではないんですか？",
      "distress_level": 3,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:40:56",
      "utterance": "もちろん、あなたのことが中心です。今のは、例として話をさせていただきました。不快にさせてしまい、申し訳ないです。",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2022-03-22T21:41:37",
      "utterance": "先が見えないし",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-03-22T21:42:12",
      "utterance": "眠れないし",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-03-22T21:42:33",
      "utterance": "限界です",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:42:34",
      "utterance": "あなたは、そんな先が見えない、つらい状況でもこれまで頑張ってこられたんですよね。",
