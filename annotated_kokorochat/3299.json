    },
    {
      "role": "client",
      "time": "2022-03-22T21:24:02",
      "utterance": "ときどき思います",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:24:36",
      "utterance": "そうでしたか、おつらい状況の中、これまで頑張ってこられたんですね。",
