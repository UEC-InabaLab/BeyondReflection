      "role": "client",
      "time": "2022-03-22T21:25:48",
      "utterance": "生きている意味がわからない",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:26:25",
      "utterance": "生きている意味がわからない、そのようにお考えになっているんですね",
