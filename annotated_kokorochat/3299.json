      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2022-03-22T21:03:02",
      "utterance": "気が抜けない",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:03:17",
      "utterance": "職場がきつくて、おつらいんですね。",
