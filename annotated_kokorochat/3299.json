    {
      "role": "client",
      "time": "2022-03-22T21:10:05",
      "utterance": "良くないです",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:10:40",
      "utterance": "そうですよね。食欲とか、睡眠は、いかがでしょう。",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-03-22T21:10:58",
      "utterance": "食べるけど美味しくないし",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2022-03-22T21:11:03",
      "utterance": "眠れない",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:11:53",
      "utterance": "ええ、そうでしたか。。それが、長く続くと身体も心もきつくなりますよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2022-03-22T21:12:07",
      "utterance": "はい、、",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:12:22",
      "utterance": "いつ頃から、体調が悪くなってきたのでしょうか。",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2022-03-22T21:12:40",
      "utterance": "2ヶ月ぐらい前から",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:13:03",
      "utterance": "そうなんですね。教えていただき、ありがとうございます。",
