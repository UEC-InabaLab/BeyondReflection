      "time": "2022-03-22T21:00:55",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:01:18",
      "utterance": "本日ご相談になりたいことについて、教えていただけますか？",
