    },
    {
      "role": "client",
      "time": "2022-03-22T21:38:18",
      "utterance": "それって私以外の人のことだけ言ってますよね？",
      "distress_level": 3,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:39:16",
      "utterance": "そうですね。ここは、あなた以外のことを話しています。",
