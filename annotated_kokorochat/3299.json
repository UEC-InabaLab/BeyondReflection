    },
    {
      "role": "client",
      "time": "2022-03-22T21:07:52",
      "utterance": "はい、、",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:08:24",
      "utterance": "パワハラを行うのは、上司でしょうか？それとも同僚、部下でしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2022-03-22T21:08:43",
      "utterance": "職場全体かな",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:09:05",
      "utterance": "職場全体なんですね。。。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:09:29",
      "utterance": "先程、心身の不調とのことでしたが、",
