    },
    {
      "role": "client",
      "time": "2022-03-22T21:04:30",
      "utterance": "両方",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:05:02",
      "utterance": "両方なんですね。それは、しんどいですよね。",
