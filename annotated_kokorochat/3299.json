      "role": "client",
      "time": "2022-03-22T21:22:49",
      "utterance": "消えたくなる",
      "distress_level": 3,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:23:42",
      "utterance": "はい、消えたくなるとは、死んでしまいたいというお気持ちがあるのでしょうか？",
