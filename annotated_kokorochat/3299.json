      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:47:13",
      "utterance": "はい、",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2022-03-22T21:47:33",
      "utterance": "いつも頭が働かない",
      "distress_level": 3,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:48:02",
      "utterance": "そうなんですね。",
