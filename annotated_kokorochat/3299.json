      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2022-03-22T21:20:00",
      "utterance": "もうどうしていいかわからない",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:20:21",
      "utterance": "ええ、そうなんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:21:27",
      "utterance": "本日のご相談内容は、パワハラが怖くて、でもせっかく就職できたから頑張ってきたけど報われない、それをどうすればいいか、ということで合っていますでしょうか？",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2022-03-22T21:21:50",
      "utterance": "というか",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:21:58",
      "utterance": "はい、",
      "tag": "Backchannel"
    },
