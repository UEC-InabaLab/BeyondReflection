      "role": "client",
      "time": "2022-03-22T21:01:43",
      "utterance": "きついです",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:02:18",
      "utterance": "心身の不調ですね。具体的に、もう少し教えていただけますか。",
