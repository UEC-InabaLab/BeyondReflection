    },
    {
      "role": "client",
      "time": "2022-03-22T21:05:08",
      "utterance": "はい、、",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2022-03-22T21:05:42",
      "utterance": "お仕事で、どんな時にきついと感じられるのでしょうか。",
