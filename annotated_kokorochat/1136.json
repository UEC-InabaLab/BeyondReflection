    },
    {
      "role": "client",
      "time": "2021-01-08T14:35:31",
      "utterance": "もいろんです",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-01-08T14:35:40",
      "utterance": "もちろん",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:35:52",
      "utterance": "ここまでのお話をまとめさせていただいても、よろしいですか",
