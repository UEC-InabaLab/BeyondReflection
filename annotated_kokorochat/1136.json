      "time": "2021-01-08T13:59:45",
      "utterance": "はい、お願いします",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:00:33",
      "utterance": "こんにちは相談員です本日は、ご相談にお越しいただきまして、ありがとうございますよろしくお願いします",
      "tag": "Greeting"
    },
