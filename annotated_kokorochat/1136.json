      "role": "client",
      "time": "2021-01-08T14:26:55",
      "utterance": "まだしていません",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-01-08T14:27:02",
      "utterance": "口もきいていないので",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:27:06",
      "utterance": "そうなんですね",
