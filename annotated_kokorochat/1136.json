    },
    {
      "role": "client",
      "time": "2021-01-08T14:07:57",
      "utterance": "元々自営業なので、接待とかでクラブやキャバクラに行くのは、よくあったんです",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:08:20",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:09:32",
      "utterance": "それが原因だと、思われていますか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-08T14:09:57",
      "utterance": "はい、そこの女性となので",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:11:38",
      "utterance": "そうなんですね・・・それは、いまいましいですよね",
