      "role": "client",
      "time": "2021-01-08T14:05:27",
      "utterance": "10年くらいだと思います",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:05:40",
      "utterance": "そうなんですね・・・それは、腹が立ちますよね",
