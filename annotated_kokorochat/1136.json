      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-01-08T14:31:10",
      "utterance": "登用してくれません",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:31:12",
      "utterance": "ええ、",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:31:28",
      "utterance": "そうなんですか・・・",
