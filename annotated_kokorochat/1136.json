      "role": "client",
      "time": "2021-01-08T14:40:12",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:40:41",
      "utterance": "京子さんは、家族のために、一生懸命でした",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:41:36",
      "utterance": "京子さんは、決して悪くはないと思います",
