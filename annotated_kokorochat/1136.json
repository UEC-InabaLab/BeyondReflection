    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:38:50",
      "utterance": "夫は、亭主関白で、周りの人の話を聴かず、また、京子さんは、夫さんに対して拒否反応を起こしている",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2021-01-08T14:39:01",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:39:54",
      "utterance": "就職もしたい、仕事がないので、離婚できない、大学生のために家も出ていけなくて、困っている",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:40:03",
      "utterance": "いかがでしょうか？",
      "tag": "ClosedQuestion"
    },
