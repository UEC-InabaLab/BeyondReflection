    },
    {
      "role": "client",
      "time": "2021-01-08T14:24:14",
      "utterance": "女の子は当然だめです",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-01-08T14:24:43",
      "utterance": "19才と21才なので",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:25:08",
      "utterance": "それは、嫌だということでしょうか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-08T14:25:20",
      "utterance": "17才の男の子は学校の寮に入っているので知らせていません",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:25:34",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
