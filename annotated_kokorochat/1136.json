    },
    {
      "role": "client",
      "time": "2021-01-08T14:04:05",
      "utterance": "夫の浮気がわかったんです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:04:19",
      "utterance": "そうなんですね",
