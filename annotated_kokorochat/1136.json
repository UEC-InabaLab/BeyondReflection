    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:46:08",
      "utterance": "夫さんが、離婚に対して、はい、と言わなくても、家庭裁判所に申し出れば、離婚調停が出来ます。",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2021-01-08T14:46:20",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:46:49",
      "utterance": "そこでは、夫さんから慰謝料を請求することが出来ます",
