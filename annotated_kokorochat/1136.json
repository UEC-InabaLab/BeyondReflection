      "role": "client",
      "time": "2021-01-08T14:25:35",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:26:30",
      "utterance": "京子さんは、夫さんに、離婚したいというお話は、されましたか",
