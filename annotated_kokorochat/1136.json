    },
    {
      "role": "client",
      "time": "2021-01-08T14:47:39",
      "utterance": "いくらもらえるんですか？",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:47:42",
      "utterance": "それで、当分の間は、仕事が見つからなくても、食べていくことが出来ると思いますが、いかがでしょうか",
      "tag": "Suggest"
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:48:18",
      "utterance": "いくらもらえるかは、裁判所が状況を聞いて、決まります",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:48:46",
      "utterance": "なるべく、証拠になるものを持って行った方が、良いと思います",
      "tag": "Suggest"
    },
    {
