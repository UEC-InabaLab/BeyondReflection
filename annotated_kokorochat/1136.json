      "role": "client",
      "time": "2021-01-08T14:02:01",
      "utterance": "はい、離婚したいんです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:02:23",
      "utterance": "そうなんですか。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:02:48",
      "utterance": "もう少し詳しく教えていただいてもよろしいでしょうか",
