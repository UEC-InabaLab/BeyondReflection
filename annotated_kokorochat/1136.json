    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:19:44",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-01-08T14:20:18",
      "utterance": "声も聴きたくないし、一緒の空気も吸いたくないです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:21:01",
      "utterance": "そうなんですね・・嫌ですよねお子様たちは、夫さんを、どのように思っていらっしゃるようですか",
