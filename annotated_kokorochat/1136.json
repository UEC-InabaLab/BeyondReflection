    },
    {
      "role": "client",
      "time": "2021-01-08T14:14:47",
      "utterance": "手前味噌ですが、私は良く尽くす主婦だと言われてきました。子育ても夫が独立して自営業になるまでは、共働きで3人を育ててきました",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-01-08T14:15:22",
      "utterance": "42才、女性、京子です",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:15:28",
      "utterance": "そうなんですね・・・今まで、頑張ってこられたのですね",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:15:52",
      "utterance": "京子さん、教えていただいて、ありがとうございます",
