    },
    {
      "role": "client",
      "time": "2021-01-08T14:16:44",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:18:22",
      "utterance": "そんなに一生懸命だったのに、裏切られてしまったような気がして、腹が立ちますよね",
