    },
    {
      "role": "client",
      "time": "2021-01-08T14:13:00",
      "utterance": "こうすると言ったら周りの言葉は聞きません",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:13:31",
      "utterance": "そうなんですね・・・それは、お困りですよね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:14:46",
      "utterance": "ちなみに、もしよろしければ、ご年齢、性別、なんとおよびしたらよろしいでしょうか",
