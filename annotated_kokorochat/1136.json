      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:33:56",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-01-08T14:34:03",
      "utterance": "八方ふさがりです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-01-08T14:34:13",
      "utterance": "私は悪くないのに",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-01-08T14:34:21",
      "utterance": "それは、お困りですよね",
