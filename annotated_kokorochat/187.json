{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2020-07-15T20:00:02",
      "utterance": "こんばんわ相談員です。宜しくお願いいたします。",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:00:24",
      "utterance": "こんばんは。よろしくお願いいたします",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:00:47",
      "utterance": "よろしくお願いします。今日はどのようなご相談でしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:01:26",
      "utterance": "会社の上司のことで困っています",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:01:51",
      "utterance": "そうですか、、上司のどのような内容でしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:02:31",
      "utterance": "突然、切れて怒りだすんです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:02:57",
      "utterance": "そうなんですね、、それは困っちゃいますね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:03:19",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:03:27",
      "utterance": "例えば、どんな時にそうなることが多かったりしますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:04:13",
      "utterance": "仕事上の話をしていて、自分の思うようにならないと怒ります",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:04:51",
      "utterance": "そうなんですか、、大切な仕事中に、仕事が進まなくなっちゃいますね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:05:15",
      "utterance": "それはいつもですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:05:52",
      "utterance": "いつもではないですね。",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-07-15T20:05:58",
      "utterance": "いつ切れるかわからないんです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-07-15T20:06:14",
      "utterance": "怒りスイッチがいつ入るかわからなくて…",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:06:25",
      "utterance": "そうなんですね、、突然だと怖い気もしますね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:06:34",
      "utterance": "怒りスイッチですか・・・",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:06:41",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-07-15T20:06:58",
      "utterance": "見えないけど、スイッチが入った瞬間がわかります(笑)",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:07:05",
      "utterance": "それはいつ頃からですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:07:39",
      "utterance": "そうですね…",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-07-15T20:07:58",
      "utterance": "時期というか異動されてしばらく慣れたときからでしょうか？",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:08:18",
      "utterance": "そうなんですね、、",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:08:35",
      "utterance": "ちなみに異動されたのはいつごろでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:09:22",
      "utterance": "1年半前くらいです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:09:56",
      "utterance": "そうですか、、じゃあ1年以上は怒りスイッチに困ってらっしゃるわけですね",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:10:11",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-07-15T20:10:25",
      "utterance": "最初は怒っていることきづかなかったんです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:10:36",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:10:48",
      "utterance": "話しているうちに、ん？って思うことが増えていました",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:10:57",
      "utterance": "そうですか",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:11:10",
      "utterance": "同僚と話したら怒っているんだよ、と言われ気付いたかんじです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:11:36",
      "utterance": "そうですか、、怒ってることが感じ取れないって感じですか？",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:12:58",
      "utterance": "私が鈍感なんだとおもいます。",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-07-15T20:13:16",
      "utterance": "同僚たちはみんな早々気付いていたようです…",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:13:34",
      "utterance": "そうなんですか？ちなみに、どんな感じの起こり方なんですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:14:47",
      "utterance": "口調が変わるんです。突然",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-07-15T20:14:58",
      "utterance": "顔も険しくなって",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-07-15T20:15:07",
      "utterance": "手も震えていました。",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:15:36",
      "utterance": "そうですか、、怒り心頭って感じに思われます。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:16:03",
      "utterance": "そうなんですね",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:16:14",
      "utterance": "その怒りスイッチが入った時、相談者さまはどう感じますか？＿",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:16:58",
      "utterance": "以前は気づかなかったのでなんとも思わなかったんですが",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-07-15T20:17:21",
      "utterance": "今は、私、何か怒らせるようなこと言いました？しました？って気持ちにはなります",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:18:41",
      "utterance": "なるほどですね、相談者さまは怒られて凹むって感じではなく、何怒ってんの？って感じで受けてるんでしょうか",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:19:19",
      "utterance": "凹むときもありますよ。だけど、あとから上司が謝ってくることがおおくて",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-07-15T20:19:33",
      "utterance": "だから、謝るなら最初から怒らないでとおもいます。",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:19:48",
      "utterance": "そうなんですね、、おっしゃるとおりですよね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:20:03",
      "utterance": "私は気づきませんでしたが、本人は怒ってること気づいてるみたいですね",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:20:18",
      "utterance": "そうですかー",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:20:51",
      "utterance": "例えば、どんなことで怒るんでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:21:07",
      "utterance": "それがわかったら、私も楽なんですけどね〰️",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-07-15T20:21:13",
      "utterance": "私が知りたいです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:21:25",
      "utterance": "そうでした、失礼しました",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:21:49",
      "utterance": "怒りスイッチはどこなんですかね？",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:22:03",
      "utterance": "ちなみに、上司の方が怒るのは、同僚の方々全員に対してですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:22:18",
      "utterance": "それもいろいろなんですよ。",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-07-15T20:22:35",
      "utterance": "いる人みんなのときもあれば、特定の人のときもあって",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:22:36",
      "utterance": "そうなんですね、、いろいろなんですね",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:23:03",
      "utterance": "機嫌の浮き沈みが激しすぎてよくわかりません",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:23:16",
      "utterance": "この件で、同僚の方々とはどんな話をされてますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:23:54",
      "utterance": "怒りスイッチはどこ？みたいな感じです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-07-15T20:23:59",
      "utterance": "ネタみたいになってます",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:24:17",
      "utterance": "なるほどですね、、皆さん困ってらっしゃるわけですね",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:24:23",
      "utterance": "そうですね。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:24:50",
      "utterance": "お話し聞いてるだけで、仕事上悪影響がでてそうな気がします",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:24:52",
      "utterance": "私みたいな鈍感が余計に火に油を注いでいるとみんないいます",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:25:19",
      "utterance": "そうなんですか、それはまた困りましたね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:25:27",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-07-15T20:25:42",
      "utterance": "イラっとするんでしょうね、きっと",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:25:43",
      "utterance": "上司の方はどんな方なのでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:25:52",
      "utterance": "どんな方とは？",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-07-15T20:26:19",
      "utterance": "普通のおじさんです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:26:40",
      "utterance": "切れやすい普通のおっさんでしょうか？",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:26:55",
      "utterance": "なるほどですね、、",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:26:57",
      "utterance": "そうですね。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:27:20",
      "utterance": "皆さんがお困りであれば、会社の業績にも影響あるかんじですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:28:01",
      "utterance": "みんな、仕事ができる人ばかりなので今は特に影響ないんです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:28:36",
      "utterance": "なるほど、、上司がそんな感じでも、仕事に影響はないんですね、いいですね",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:29:05",
      "utterance": "そうですね。だけど、顔色を伺いながらの仕事なので、疲れますよ",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:29:39",
      "utterance": "なるほど、、そこが困ってるポイントですかね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:29:50",
      "utterance": "そうですね。",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:30:12",
      "utterance": "お話し聞いてて、少し気になったのですが、、",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:30:19",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:30:49",
      "utterance": "その上司の方は、普段は上司らしいところはあるかんじですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:31:17",
      "utterance": "他にも気になるところとかございますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:31:44",
      "utterance": "仕事はできる方なんです。効率よくこなしていますし、部下をさばくのもじょうずというか",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-07-15T20:32:00",
      "utterance": "怒りスイッチをなんとかしてほしいくらいですかね",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:32:12",
      "utterance": "なるほど、、",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:32:33",
      "utterance": "いろいろとお話しお聞かせいただき、有難うございました。",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:32:42",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:33:08",
      "utterance": "これまでのお話を要約させて頂いて宜しいでしょうか？",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:33:15",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:34:14",
      "utterance": "1年半ほど異動があってから、今の上司が理由がはっきりせず怒りスイッチが入ることがある",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:34:57",
      "utterance": "怒ってるといっても、怒ってるのか気づかない起こり方ではあるが、本人はおこってることに気づいてる模様",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:35:36",
      "utterance": "困ってるのは、いつなんで怒るかわからず、顔色を伺ってるのが困る",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:35:52",
      "utterance": "怒りスイッチがいつ入るのかで困ってる。",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:36:04",
      "utterance": "ということで宜しかったでしょうか？",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:36:15",
      "utterance": "そうですね。",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:36:25",
      "utterance": "有難うございます。",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:37:29",
      "utterance": "このような事が続けば、会社の業績にもなんらかの影響が出てくると思います。",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2020-07-15T20:37:41",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-07-15T20:37:54",
      "utterance": "相談者だけでなく、同僚の方々でも困ってる方は多いのではないでしょうか？",
      "tag": "OpenQuestion"
    },
    {
