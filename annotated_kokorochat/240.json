      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-07-23T17:26:08",
      "utterance": "つまらないのですね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T17:27:38",
      "utterance": "そのつまらなさから、悲しくて、寂しくて、心細くて、何にもやる気がしないのと思います",
