    },
    {
      "role": "client",
      "time": "2020-07-23T17:01:31",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-23T17:01:55",
      "utterance": "どんな時に、やる気が出ないですか",
