    },
    {
      "role": "client",
      "time": "2020-07-23T17:00:50",
      "utterance": "やる気が起きない",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-23T17:01:18",
      "utterance": "そうなんですねお辛いですね",
