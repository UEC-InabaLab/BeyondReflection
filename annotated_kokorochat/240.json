    {
      "role": "client",
      "time": "2020-07-23T17:39:15",
      "utterance": "よくわかりません",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-23T17:39:28",
      "utterance": "どうしてですか",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-07-23T17:39:53",
      "utterance": "勉強は好きではないです",
