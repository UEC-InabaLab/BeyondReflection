    },
    {
      "role": "client",
      "time": "2020-07-23T17:34:54",
      "utterance": "一生懸命って感じでもないです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-23T17:35:37",
      "utterance": "家に帰ってからの楽しみは、何かありませんか",
