      "role": "client",
      "time": "2020-07-23T16:59:54",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-23T17:00:24",
      "utterance": "最近、行きたくないと思われたきっかけは、心当たりありますか",
