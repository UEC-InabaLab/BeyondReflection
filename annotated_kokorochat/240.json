    },
    {
      "role": "client",
      "time": "2020-07-23T17:02:20",
      "utterance": "何をやってもやる気がでないです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-23T17:03:00",
      "utterance": "そうなんですねお困りですよね",
