      "role": "client",
      "time": "2020-07-23T17:13:01",
      "utterance": "はい。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-07-23T17:13:18",
      "utterance": "すると、今は、ずっと家にいるのですかそれとも、外には出ておられるんですか",
