    },
    {
      "role": "client",
      "time": "2020-07-23T17:10:58",
      "utterance": "部活休みなんです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-07-23T17:11:25",
      "utterance": "そうなんですね寂しいですね",
