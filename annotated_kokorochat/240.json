    },
    {
      "role": "client",
      "time": "2020-07-23T17:13:49",
      "utterance": "学校には週3回行ってますそれ以外は家です",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-07-23T17:14:05",
      "utterance": "そうなんですね",
