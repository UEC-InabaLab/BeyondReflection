    },
    {
      "role": "client",
      "time": "2020-07-23T17:15:06",
      "utterance": "授業受けるだけです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-07-23T17:15:37",
      "utterance": "そうなんですね座ってばかりだと、息が詰まりますよね",
