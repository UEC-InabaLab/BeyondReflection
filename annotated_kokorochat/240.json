    },
    {
      "role": "client",
      "time": "2020-07-23T17:03:24",
      "utterance": "自分でも何でかわからない",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-23T17:03:41",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T17:04:05",
      "utterance": "食事や睡眠は、きちんととれていますか",
