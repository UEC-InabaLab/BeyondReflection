    },
    {
      "role": "counselor",
      "time": "2020-07-23T17:25:29",
      "utterance": "とても、悲しいことと思います",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-07-23T17:25:40",
      "utterance": "悔しくはないかな",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-23T17:25:54",
      "utterance": "そうなんですね",
