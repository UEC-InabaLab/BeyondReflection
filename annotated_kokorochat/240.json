    },
    {
      "role": "client",
      "time": "2020-07-23T17:04:36",
      "utterance": "夜更かしが多くなった気がする食事はちゃんととれてます",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-07-23T17:05:18",
      "utterance": "何時に寝て、何時ごろ、起きますか",
