    },
    {
      "role": "client",
      "time": "2020-07-23T17:27:57",
      "utterance": "そうなんですかね",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-23T17:28:45",
      "utterance": "ゲームをやったり、友達と、ラインをやるのも、その心を埋める気持ちなのかもしれません",
