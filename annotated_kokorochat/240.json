      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-07-23T16:58:51",
      "utterance": "こんにちは相談員です。本日は、いかがされましたか",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-07-23T16:59:17",
      "utterance": "こんにちは最近学校行きたくないんです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-23T16:59:39",
      "utterance": "そうなんですねそれはお辛いですね",
