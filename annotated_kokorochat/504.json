{
  "dialogue": [
    {
      "role": "client",
      "time": "2020-09-30T18:50:45",
      "utterance": "宜しくお願い致します。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-09-30T18:55:48",
      "utterance": "本日はよろしくお願いします。",
      "tag": "Greeting"
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:00:09",
      "utterance": "こんばんは、相談員です。本日は相談ありがとうございます。本日はどのような相談内容になりますでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:01:42",
      "utterance": "はい、20代、男性です。リクと呼んで下さい。社会人になったのに、こんな調子でいいのかと、悩んでいます。",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-09-30T19:02:43",
      "utterance": "就職活動を一生懸命に頑張った結果",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-09-30T19:03:20",
      "utterance": "見事内定を獲得することが出来ました。",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-09-30T19:03:30",
      "utterance": "しかしながら",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:03:42",
      "utterance": "はい。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:04:18",
      "utterance": "入社して約一月がたった頃",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:04:40",
      "utterance": "うんうん。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:04:47",
      "utterance": "急にやる気が無くなってしまいました。",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:05:08",
      "utterance": "そうだったんですね。やる気がなくなってしまったんですね。。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:05:34",
      "utterance": "そして将来、なにをしていきたいのか",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:05:44",
      "utterance": "ええ。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:06:12",
      "utterance": "考えれば考えるほど、焦ってしまい",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:06:22",
      "utterance": "うんうん",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:06:36",
      "utterance": "訳が分からなくなってしまいます",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-09-30T19:06:52",
      "utterance": "入社当初は",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:07:03",
      "utterance": "相当お悩みになられているのですね。。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:07:17",
      "utterance": "社会人になったこと",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:08:03",
      "utterance": "はい。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:08:11",
      "utterance": "そして念願のこの会社で働けることの喜びから",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-09-30T19:08:34",
      "utterance": "やる気にみちていたのですが",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:08:41",
      "utterance": "うんうん",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:09:55",
      "utterance": "5月の連休明けから、コロナの影響もあり、気分がふさぎ込みがちになり",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:10:22",
      "utterance": "なるほど。。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:10:41",
      "utterance": "あれこれと考えこんで、しまうようになってしまいました。",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-09-30T19:11:16",
      "utterance": "かろうじて、出社出来ている状態です。",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:11:44",
      "utterance": "そうだったんですね。塞ぎ込んでしまうとやる気もなくなってしまいますよね。。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:11:51",
      "utterance": "はい、",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-09-30T19:12:16",
      "utterance": "せっかく会社に入れたのですが",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:12:35",
      "utterance": "うんうん。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:15:00",
      "utterance": "病院に行って、何か元気の出る薬でももらって来ようと思っていますが？なかなか足が向きません",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-09-30T19:15:42",
      "utterance": "もう、半年もやもやしています。",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:16:57",
      "utterance": "そうだったんですね。今の苦しい現状をお伝えしてくれてありがとうございます。半年間、モヤモヤと付き合い、そして耐えられてきたんですね。今日は話したいことをなんでも聞きますので、安心してくださいね。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:17:42",
      "utterance": "はい、お願いします。5月を過ぎた頃からあんなに、喜びでいっぱいだったのに",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:18:16",
      "utterance": "うんうん、気持ちのギャップがあるとモヤモヤしますよね。。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:18:35",
      "utterance": "将来の夢も、無くなってしまいました。",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:19:19",
      "utterance": "そうだったんですね。。よろしければ将来の夢を聞かせていただいても良いですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:21:56",
      "utterance": "車のセールをしていますが、自分で、お店を持ちたいと、考えていました。5月の連休明けからおかしくなりだしたので、長い休みのせいか？",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-09-30T19:22:52",
      "utterance": "考えれば考えるほど、焦ってしまいました。",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:23:31",
      "utterance": "そうだったんですね。将来は今のお仕事から独立したいと考えていたんですね。素晴らしいことだと思います。何を考えている時が、焦ってしまいますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:25:01",
      "utterance": "やる気に充ちていたのですが？これからなにをして行きたいのか？",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:26:23",
      "utterance": "なるほどですね。。先のことを考えると焦ってしまいますよね。。何をしていきたいかというのは、独立するためへの道筋ということでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:27:55",
      "utterance": "いまは、かろうじて出社できていますが、気が重く、最近は頭痛がして気分がすぐれませんので、何も考えられなくなってしまいました。",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:28:53",
      "utterance": "うんうん。心も身体も苦しい状態なのですね。。。その中でかろうじで出社できている要因とかはありますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:30:17",
      "utterance": "お給料をもらうためだけに通っています",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:31:29",
      "utterance": "なるほどですね。お金は大事ですもんね、、大事な理由だと思いますよ。今の会社に入ろうと思った理由はなんですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:34:40",
      "utterance": "車が好きで、子のかいしゃのまえを、とおっいたので、中で仕事をしているかたも、皆やさしそうで、笑顔がが素敵だたので、憧れていました。いま、辞めても、なかなか働く所かないし、",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:36:16",
      "utterance": "そうだったんですね、憧れがあったんですね。その会社に入れたというのはとても素晴らしいですよね。実際に働いて見てどうでしたか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:38:15",
      "utterance": "最初はやる気で、頑張っていましたが、連休明けからこんなにふさぎこんで、いるので、お客様から見たら暗いでしょね。暗い人からは買いたくないですよね",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:39:14",
      "utterance": "そうお思いなのですね。実際に暗いと言われたことはありますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:41:12",
      "utterance": "直接はありませが、お客様が自分より、別のセールスマンの所へ行き、たのし、そうに説明を聞いています。",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-09-30T19:42:04",
      "utterance": "お客様が近寄らなくなって来ています。",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:42:17",
      "utterance": "うんうん。そうなると辛いですよね。。。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:42:56",
      "utterance": "はい、",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-09-30T19:43:42",
      "utterance": "辞めたい気持ちが膨らんで来ています。",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-09-30T19:44:11",
      "utterance": "セールスに向かないのかな？",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:44:39",
      "utterance": "そうなると辞めたくもなりますよね。。逆に仕事をしていて嬉しい時はありますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:45:03",
      "utterance": "いまは、ありません",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:45:27",
      "utterance": "うんうん、そうですよね。。過去はどうでしたか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:46:28",
      "utterance": "お客様が、よって来て下さった時は嬉しかったです。",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:47:40",
      "utterance": "なるほどですね。そうなると嬉しくなりますよね。そのお店ではどのような人にお客様が寄ってくるとかありますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:50:02",
      "utterance": "明るく、挨拶も丁寧で、お客様の要望を良く聞いてあげている所には、自然とよって着ますね",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-09-30T19:52:12",
      "utterance": "私は、暗い顔にうつってしまうのでしょうね",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:52:18",
      "utterance": "なるほど、確かにそういう人に接客されるとお客様も嬉しいですよね。りくさんはその中で明るさ、挨拶、丁寧さ、要望を聞く。この４つを得意な順番に順位付けするとどのようになりますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:52:57",
      "utterance": "なかなか、難しいですよね。明るい人も心から明るくしているかわからないですもんね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:55:20",
      "utterance": "私にはなかなか出来ない、明るさだと思います。",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-09-30T19:56:47",
      "utterance": "そうお思いなんですね。大丈夫ですよ。明るい人が全てではないと思いますよ。でも、どうしてできないとお思いなんですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-09-30T19:59:35",
      "utterance": "5月の連休明けからこんな風になってしまって、身体がだるかたり、頭痛が、ひどいので、顔に少し出てしまっているのでしょう",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-09-30T20:01:59",
      "utterance": "なるほどですね。連休明けにいろいろ感じることがあったんですもんね。。。その状態がずっと続くと、苦しい状態が続いてしまいますもんね。。。すみません、そろそろお時間がきてしまったのですが、本日はお話してみていかがでしたでしょうか？",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2020-09-30T20:03:41",
      "utterance": "はい、まだもやもやが残っている感じですがまた、後で来てみます。",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-09-30T20:04:28",
      "utterance": "本日は相談ありがとうございました。これで相談を終了させていただきます。",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2020-09-30T20:04:42",
      "utterance": "はい、ありがとうございました。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-09-30T20:04:45",
      "utterance": "（至らない点多かったですが、本日はありがとうございました。）",
      "tag": "Other"
    }
