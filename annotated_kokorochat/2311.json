{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2021-08-07T15:58:17",
      "utterance": "（１６時～よろしくお願いいたします）",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2021-08-07T15:58:31",
      "utterance": "（よろしくおねがいします！）",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:01:11",
      "utterance": "こんにちは、相談員です。今日はどのようなご相談でしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:01:51",
      "utterance": "子どもが可愛いと思えないんです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:02:21",
      "utterance": "そうなんですね、お悩みなんですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:02:27",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:02:47",
      "utterance": "もう少し、状況とかお聞かせいただけますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:03:00",
      "utterance": "どうお話ししたらいいですか？",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:03:56",
      "utterance": "お話したいところからで大丈夫です。お子さんが可愛いと思えない、その状況とか、思いとか。",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:04:53",
      "utterance": "子どもが可愛く思えなくて、私は悪い母親です",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:06:16",
      "utterance": "そんな風にお感じなのですね・・・。いつぐらいから、そのように思われてるのでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:07:26",
      "utterance": "2年くらい前からです",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:07:59",
      "utterance": "そんなに前からだったんですね、長い間、悩まれてきたのですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:08:08",
      "utterance": "はい...",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:08:27",
      "utterance": "ちなみに、ご家族構成とか、お聞きしてもよろしいでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:09:20",
      "utterance": "私はシングルマザーで子どもと私の母親と3人で暮らしています",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:09:50",
      "utterance": "お応えいただきありがとうございます。そうだったんですね。",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:09:57",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:10:19",
      "utterance": "ちなみに、お子さんは今何歳くらいでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:10:32",
      "utterance": "5歳です",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:11:13",
      "utterance": "はい、ありがとうございます。５歳ですと、目が離せないことも多い時期ですよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:11:21",
      "utterance": "そうですね",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:12:10",
      "utterance": "状況を理解したいので、もう少しいくつか質問させてください。",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:12:15",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:13:15",
      "utterance": "２年くらい前から、今のお悩みの感情をお持ちとのことですが、その頃とか、何かキッカケとか、環境の変化とか、何かございましたか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:14:44",
      "utterance": "その頃は離婚して少したって、仕事も始めた頃でした",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:15:30",
      "utterance": "そうだったんですね、大きな環境の変化があったんですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:15:54",
      "utterance": "慣れない仕事と家事でイライラすることが多くて、でも子どもはイヤイヤ期で言う事聞かなくて",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-08-07T16:16:27",
      "utterance": "怒鳴ったりしちゃうこともあって、何度も子ども泣かせてしまうことがあって",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:16:46",
      "utterance": "ええ（聞いています）",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:17:51",
      "utterance": "母からも、もっと優しくしてあげてと言われるし子どもも、ママは嫌とか言われて、母親失格なんだって思ってきちゃって",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:18:10",
      "utterance": "うん、うん",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:18:35",
      "utterance": "そのあたりから、ずっと子どもが愛せないんです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:18:49",
      "utterance": "つらかったんですね・・・",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:18:53",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:19:45",
      "utterance": "これだけいろんな事が重なってしまってたら、イライラしちゃうのも無理ないことです。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:20:29",
      "utterance": "そうなんですかね",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:20:53",
      "utterance": "はい、そう感じました。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:21:06",
      "utterance": "ありがとうございます",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:21:16",
      "utterance": "あなたは、かなりがんばって来られたこと、感じます。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:21:31",
      "utterance": "ありがとうございます...",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:22:13",
      "utterance": "それから２年間、ずっとそんな感じが続いてるのでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:23:43",
      "utterance": "それからは虐待してはいけないと思って、母に子どもを任せて少し距離を置いたりしてます",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:24:14",
      "utterance": "なるほど、そのような対応もされてたんですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:25:08",
      "utterance": "子育てもちゃんとしないで、好き勝手してるなと自分で思います",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:26:25",
      "utterance": "そのようにお感じなのですね、少し気にされたりもしてるんですね・・・",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:26:41",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:27:08",
      "utterance": "好き勝手とは、、どのような感じなのでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:28:06",
      "utterance": "子どもを置いて、ご飯を食べに行ったり、趣味の時間を過ごしたりしてます",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-08-07T16:28:20",
      "utterance": "母に全て任せてしまってます",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-08-07T16:29:10",
      "utterance": "無責任ですよね...",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:29:44",
      "utterance": "そのように感じてるんですね・・・趣味の時間とか、ご飯食べに行ったりとか、、いいんじゃないですか。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:30:54",
      "utterance": "子どもはもっと私と過ごしたそうにしていますが、どうしても避けてしまうんです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-08-07T16:31:16",
      "utterance": "寂しそうにしてるのがわかります",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:31:26",
      "utterance": "しんどいですね・・・",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:32:19",
      "utterance": "でも、寂しそうにされてもイライラしてしまうんです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-08-07T16:32:37",
      "utterance": "私は悪い母親です",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:32:44",
      "utterance": "そうなんですね、辛いですね・・・",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:33:00",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:33:29",
      "utterance": "母親であると同時に、一人の人間ですから、ご飯食べにも行きたいでしょうし、趣味の時間を作っても、いいと思います。でも、、",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:34:25",
      "utterance": "２年も、お子さんの事で悩まれてて、それはかなりつらいことですよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:34:54",
      "utterance": "そうですね",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:35:19",
      "utterance": "以前は、どんな生活（ご家庭）だったのでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:35:57",
      "utterance": "離婚前ということですか？",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:36:23",
      "utterance": "はい、お子さんに今の感情を持つ前とかです。",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:37:19",
      "utterance": "子どもが赤ちゃんの頃はかわいかったです",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:37:30",
      "utterance": "ええ",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:38:15",
      "utterance": "でももうあの頃には戻れないですから",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:38:31",
      "utterance": "そうなんですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:38:44",
      "utterance": "もう離婚しましたし",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:38:56",
      "utterance": "ええ",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:40:57",
      "utterance": "あんまり離婚前のことは話したくないです",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:40:58",
      "utterance": "そうなんですね、離婚されて、その後、元ご主人との関係性は、どんな感じだったでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:41:12",
      "utterance": "あっ、ごめんなさい。",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:41:34",
      "utterance": "離婚の件、話さなくて大丈夫です。",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:41:40",
      "utterance": "別れた元夫とは、もう会ってないです",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:42:11",
      "utterance": "わかりました、辛い話をさせてしまい、ごめんなさい。",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:42:24",
      "utterance": "すみません...聞いていただいてるのに",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:43:09",
      "utterance": "いいえ、大丈夫です。",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:43:22",
      "utterance": "今、どんな感情をお持ちですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:43:35",
      "utterance": "何に関してですか？",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:44:49",
      "utterance": "生活全般やお子さんのことについて、寂しいとか、不安とか、、いかがでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:45:21",
      "utterance": "うーん、難しいですね...",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:45:58",
      "utterance": "わかりました。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:46:12",
      "utterance": "いろいろとお話しいただきありがとうございます。",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:46:32",
      "utterance": "すみません...聞いていただきありがとうございます",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:46:50",
      "utterance": "ここまでお聞きしたこと、少し整理させて頂いてもよろしいでしょうか。",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:46:59",
      "utterance": "お願いします",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:48:48",
      "utterance": "２年くらい前から、お子さんが可愛く思えなくなってしまった。その頃、離婚や新しい仕事と、子育てが重なり、イライラする事も多かった。",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:49:30",
      "utterance": "それから、お母さんにお子さんをあずけ、少し距離をおいたりもした。",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:50:31",
      "utterance": "お子さんはあなたと一緒に過ごしたそうにしている、寂しそうにしてるが、でもイライラしてします。",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:50:53",
      "utterance": "といった感じでしょうか。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:50:58",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:51:16",
      "utterance": "はい、ありがとうございます。",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:51:43",
      "utterance": "それで、これからですが、",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:51:50",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:51:53",
      "utterance": "どうなるのが、あなたにとって気持ちが楽になれそうですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:52:14",
      "utterance": "子どもを愛せたらいいと思います",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:52:42",
      "utterance": "いいですね！　そうなれたら、いいですよね。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2021-08-07T16:52:53",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-07T16:53:25",
      "utterance": "これまで、この件、誰かに相談とかされた事ありますか？",
      "tag": "ClosedQuestion"
