    {
      "role": "client",
      "time": "2021-12-09T20:12:26",
      "utterance": "そうなんですね",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-12-09T20:12:29",
      "utterance": "よくわかります",
