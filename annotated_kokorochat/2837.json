    {
      "role": "client",
      "time": "2021-12-09T20:16:51",
      "utterance": "そうですか…",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-12-09T20:18:04",
