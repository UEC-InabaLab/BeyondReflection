    },
    {
      "role": "client",
      "time": "2021-12-09T20:11:20",
      "utterance": "相談員さんも痛くなりますか?",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-12-09T20:11:33",
      "utterance": "それは、辛いですね",
