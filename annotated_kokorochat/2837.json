{
  "dialogue": [
    {
      "role": "client",
      "time": "2021-12-09T19:51:45",
      "utterance": "こんばんは。今日はよろしくおねがいします。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-12-09T19:52:21",
      "utterance": "こんばんは。こちらこそよろしくお願いします",
      "tag": "Greeting"
    },
    {
      "role": "counselor",
      "time": "2021-12-09T19:54:00",
      "utterance": "お名前はなんと呼んだらいいでしょうか❔予定時間に始めますね宜しくお願い致します。",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-12-09T19:54:57",
      "utterance": "はい。",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-12-09T19:55:29",
      "utterance": "名前はみさきで、お願いします。",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-12-09T19:55:56",
      "utterance": "承知いたしました。宜しくお願い致します。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-12-09T20:01:19",
      "utterance": "今日は相談に来てくれてありがとうございます。はじめに年齢、性別を宜しくお願い致します。",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-12-09T20:01:48",
      "utterance": "高2 女子です",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-12-09T20:02:39",
      "utterance": "ありがとうございます。高校２年生なんですね。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2021-12-09T20:02:43",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-12-09T20:03:24",
      "utterance": "今日の相談したいことを宜しくお願い致します。",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-12-09T20:03:30",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-12-09T20:03:56",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-12-09T20:05:23",
      "utterance": "結構前から頭痛がひどくて、マラソン大会の練習の為に、持久走をしているんだけど、頭痛の事を先生に言えないんです。",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-12-09T20:05:49",
      "utterance": "体育の先生は担任で、怖くて。",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-12-09T20:06:03",
      "utterance": "そうなんですね。話してくれてありがとうございます。",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2021-12-09T20:06:13",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-12-09T20:07:09",
      "utterance": "体育の先生は怖くて言いにくいんですね。それは、お辛いですね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-12-09T20:07:17",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-12-09T20:08:07",
      "utterance": "体育の後はしんどくて、授業中半分寝てます",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-12-09T20:08:11",
      "utterance": "頭痛がひどいのはいつ頃くらいですか❔",
      "tag": "ClosedQuestion"
    },
    {
      "role": "counselor",
      "time": "2021-12-09T20:08:29",
      "utterance": "そうなんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-12-09T20:08:33",
      "utterance": "去年の7月くらいからかなー",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-12-09T20:08:55",
      "utterance": "雨の日は特にひどいです。",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-12-09T20:09:09",
      "utterance": "頭痛のことは周りの人には言えてますか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-12-09T20:09:25",
      "utterance": "言えてないです。",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-12-09T20:10:14",
      "utterance": "それは、より、しんどいですね",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-12-09T20:10:51",
      "utterance": "1回言った事あるけど「元気じゃん」って嘘ついた様に言われた事があって。",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-12-09T20:10:59",
      "utterance": "だから言いにくいです。",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-12-09T20:11:01",
      "utterance": "雨の日は特に頭痛ひどくなるの、よくわかります",
