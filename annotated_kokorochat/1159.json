{
  "dialogue": [
    {
      "role": "client",
      "time": "2021-01-12T10:22:01",
      "utterance": "こんにちは",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:22:40",
      "utterance": "こんにちはカウンセラー役ですどうぞよろしくお願いいたします",
      "tag": "Greeting"
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:25:29",
      "utterance": "お時間前ですが、よろしければ始めさせていただきます。お声掛けください。",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:27:33",
      "utterance": "はい、大丈夫です！",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:27:51",
      "utterance": "ありがとうございます。それでは、はじめさせていただきますね。",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:28:08",
      "utterance": "宜しくお願いします",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:28:13",
      "utterance": "よろしくお願いいたします。",
      "tag": "Greeting"
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:28:35",
      "utterance": "こんにちは、相談員です。",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:28:46",
      "utterance": "こんにちは",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:29:05",
      "utterance": "こちらにお越しいただきありがとうございます。今日は、どういったご相談ですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:29:42",
      "utterance": "職場で浮いてるみたいで",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:30:00",
      "utterance": "そうなんですね。それはお困りですよね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:30:14",
      "utterance": "よろしければ、詳しくお話しいただけますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:30:21",
      "utterance": "私ともう一人の人だけ無視されてて",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:30:34",
      "utterance": "ええ。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:31:06",
      "utterance": "仕事の伝達とかもされないことがあります",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:31:54",
      "utterance": "なるほど、そんな状況なんですね。おつらいですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:32:03",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:32:38",
      "utterance": "よろしければ、相談者さんの呼び名と、性別、年代を教えていただけますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:32:57",
      "utterance": "まき、33才、じょせいです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:33:08",
      "utterance": "まきさん、ありがとうございます。",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:33:16",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:34:01",
      "utterance": "まきさんが無視と感じていらっしゃるのは、いつごろからでしたか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:34:39",
      "utterance": "4月からです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:35:31",
      "utterance": "そうだったんですね。長い間、つらい思いを抱えていらしたんですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:36:07",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:36:57",
      "utterance": "今日、こうしてお話に来てくださってありがとうございます。４月から、とのことでしたが、何かきっかけはあったんですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:37:52",
      "utterance": "その相手が転勤してきてからだんだんって感じです。きっかけって事はないんです",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:38:46",
      "utterance": "そうねんですね。相手、というのは、じゅみさんに無視するような態度を向けてくる方のことでしたか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:39:05",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:40:00",
      "utterance": "そうなんですね。その人が職場に加わったことで、状況が変わってきたんですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:40:26",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:40:48",
      "utterance": "その、“相手”の方は、どんな方なのか、教えていただけますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:41:36",
      "utterance": "チームリーダーで私を入れて6人のチームです",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:42:06",
      "utterance": "うんうん。（お話しこのまま続けてくださいね）",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:42:13",
      "utterance": "なので、仕事の指示をしたりします",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:42:42",
      "utterance": "なるほど。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:42:45",
      "utterance": "仕事はすごく出来ると思います",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:43:11",
      "utterance": "そうなんですね。。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:43:23",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:44:10",
      "utterance": "その“相手”が仕事のできるリーダーで、６人チームでお仕事をしているんですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:44:20",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:44:52",
      "utterance": "もう一人、無視されているとお話しいただきましたが、その方も同じチームでしたでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:45:23",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:46:26",
      "utterance": "なるほど、そうなんですね。同じチームのリーダーが無視してきて、仕事の伝達もされない状態だと、お困りのこともとても多いですよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:46:46",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:47:28",
      "utterance": "まきさんは、今の状況で、一番、どういったことがつらいとお感じですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:48:31",
      "utterance": "無視です",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:49:02",
      "utterance": "そうなんですね。無視されると、精神的にも参ってしまいますよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:49:07",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:50:09",
      "utterance": "今日、こうしてお話に来ていただきましたので、どうしたらこの無視という状況を少しでも良く変化させられるか、一緒に考えていきたいと思いましたが、いかがですか？",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:50:24",
      "utterance": "はい、お願いします",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:50:48",
      "utterance": "はい、ありがとうございます。それでは、一緒に考えてみましょう。",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:51:36",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:52:38",
      "utterance": "ここまでまきさんから状況を教えていただいたのですが、無視されていない、同じチームの３人とリーダーとはどのような関係に見えますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:53:00",
      "utterance": "とても仲良くやっていると思います",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:53:45",
      "utterance": "そうなんですね。それを感じながらお仕事をしなくてはいけないのも、苦しいですよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:53:57",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:54:54",
      "utterance": "このお悩みをどなたかにお話になったことはありましたか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:55:03",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-01-12T10:55:10",
      "utterance": "先輩に",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-01-12T10:55:34",
      "utterance": "気にしすぎじゃない？って言われました",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:56:05",
      "utterance": "そうだったんですね。そう言われて、まきさんはどうお感じになりましたか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-12T10:56:42",
      "utterance": "わかってもらえない・・・って",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:57:50",
      "utterance": "そうだったんですね。状況を知っていても、わかってもらえず、悲しかったですね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-01-12T10:59:29",
      "utterance": "チーム内では、そういった話になったことはありますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-12T11:01:02",
      "utterance": "いえ、ならないです",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-12T11:01:31",
      "utterance": "そうだったんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-01-12T11:02:35",
      "utterance": "もしかして、お話しが行き違いになってしまったかな？私の質問と行違っても構いませんので、お話あれば、送信してくださいね！",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2021-01-12T11:02:52",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-01-12T11:02:56",
      "utterance": "大丈夫です",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-12T11:03:05",
      "utterance": "わかりました。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-01-12T11:03:25",
      "utterance": "では、お話し戻りますが、、",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2021-01-12T11:03:34",
      "utterance": "相談とかしても気にしすぎって言われるし、それ以上周りと話すことないです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-01-12T11:05:04",
      "utterance": "そうだったんですね。無視されて気にしないなんて、できる事じゃないですよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-01-12T11:05:31",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-01-12T11:06:54",
      "utterance": "リーダーが無視する人と仲良くする人をどんな違いで区別しているのか、感じることはありますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-12T11:07:22",
      "utterance": "正直言ってわかりません",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-01-12T11:08:03",
      "utterance": "そうなんですね。理由の想像すらできない状況では、理不尽にも感じてしまいますね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-01-12T11:08:18",
      "utterance": "私ともう一人の人もみんなとおんなじに仕事してるし、どちらかと言うと無口な方なので、嫌なことをいったりもしてないです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-01-12T11:08:36",
      "utterance": "うんうん。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-01-12T11:10:47",
      "utterance": "心辺りもないのに。。仕事中は、始まりからずっと無視されるような状況ですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-12T11:10:54",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-01-12T11:11:27",
      "utterance": "どうしても話さないといけない事はメールできます",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-01-12T11:12:27",
      "utterance": "メールですか。。直接会って話せる環境ではあるんですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-12T11:12:35",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-12T11:13:08",
      "utterance": "そっか。。それは、つらいですよね。。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-01-12T11:13:38",
      "utterance": "ちなみに挨拶はチームメンバー間で、できていますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-12T11:13:43",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-12T11:14:30",
      "utterance": "挨拶のみ。っていう状況なのでしょうか。",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-01-12T11:16:38",
      "utterance": "他の人とは話してます",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-01-12T11:16:55",
      "utterance": "無視はりーだーだけです",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-01-12T11:18:00",
      "utterance": "そうなんですね。他のメンバーとは話しているけど、リーダーとは必要なことをメールでやりとりするんですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2021-01-12T11:19:47",
      "utterance": "まきさんは、リーダーから無視はやめて欲しいと思っていますよね。もし、できるとしたら、どんな関係で仕事をしていきたいと思っていますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2021-01-12T11:26:00",
      "utterance": "まきさん、お返事入力中でしたか？もう少し、お返事お待ちしていたいなと思っています。",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2021-01-12T11:29:34",
      "utterance": "はい、そうですね。。。",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-01-12T11:29:45",
      "utterance": "和あらないって感じです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-01-12T11:29:49",
      "utterance": "わからない",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-01-12T11:29:53",
      "utterance": "どうしていいか",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-01-12T11:30:35",
      "utterance": "そっか、リーダーとどういう関係になりたいのかも想像がつかないほど、今の状況がおつらいんですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-01-12T11:30:40",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
