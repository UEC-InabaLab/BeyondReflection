    {
      "role": "client",
      "time": "2023-05-11T10:01:59",
      "utterance": "うん",
      "distress_level": 1,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2023-05-11T10:02:54",
      "utterance": "もう少し詳しく聞かせたいただきたいのですが、宜しければ、どう言った理由でつまらないのか聞かせていただけませんでしょうか？",
      "tag": "OpenQuestion"
