{
  "dialogue": [
    {
      "role": "client",
      "time": "2020-12-16T19:23:45",
      "utterance": "入りました",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:27:33",
      "utterance": "宜しくお願い致します。30分になったらスタートしますね。",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:27:58",
      "utterance": "はい、承知しました",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:30:24",
      "utterance": "こんばんは。相談員です。今日は相談に来てくださってありがとうございます。",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:30:35",
      "utterance": "お願いします",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:30:48",
      "utterance": "最初に性別と年代を教えていただけますか?",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:31:14",
      "utterance": "２０代　女性です",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:31:34",
      "utterance": "ありがとうございます。",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:31:46",
      "utterance": "今日はどのようなご相談ですか?",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:32:13",
      "utterance": "ずっと、頑固な便秘に苦しんでます",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:32:42",
      "utterance": "そうなんですね。それは、辛いですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:32:50",
      "utterance": "そうなんです",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:32:57",
      "utterance": "いつ頃からですか?",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:33:40",
      "utterance": "もう何年も、覚えてないくらい前からです",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:34:23",
      "utterance": "長年、すっきりしない状態が続いていると、やりきれないですよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:34:48",
      "utterance": "もう、ホント毎日苦しんでます",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:35:03",
      "utterance": "そうだと思います。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:35:25",
      "utterance": "ちなみに、受診されたことはありますか?",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:36:10",
      "utterance": "はい、アドバイスも受けてはいるんですが、どうも自分には合わないと思うんです",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:36:24",
      "utterance": "そうだったんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:36:53",
      "utterance": "アドバイスを受けているのに・・・となると、なんだか希望が見えないですよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:37:05",
      "utterance": "まさに、そうなんです",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:37:19",
      "utterance": "おつらいですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:37:32",
      "utterance": "しんどいです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:38:30",
      "utterance": "便秘が原因で生活に支障は出ていないですか?",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:38:47",
      "utterance": "たくさんあります",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:39:06",
      "utterance": "例えば、何が一番大変ですか?",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:39:35",
      "utterance": "こんなんじゃ、就職もままならないし、",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:39:54",
      "utterance": "はい（聴いています）",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:40:43",
      "utterance": "現在は、学生さんですか?",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:41:28",
      "utterance": "いえ、そのこともあってなかなか仕事も長続きしないんです",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:42:02",
      "utterance": "そうだったんですね。ご苦労されてきましたね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:42:39",
      "utterance": "私なんか、どこに行ってもつとまらない、って家族に言われるし、",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-12-16T19:43:15",
      "utterance": "恥ずかしいからいい加減に就職しろ、って言われます",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:43:25",
      "utterance": "そうなんですね。悲しいですね。自分のせいではないのに・・・",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:44:00",
      "utterance": "いいえ、私が悪いんですよ",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-12-16T19:44:35",
      "utterance": "みんなに言われるのも、仕方ないって思ってます",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:44:43",
      "utterance": "そんな風に思われているんですね。なかなか便秘はコントロールしにくいものだと思いますが・・・。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:45:02",
      "utterance": "医師の指示通りに",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:45:13",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:46:05",
      "utterance": "もやしやキノコを毎日山程食べて、いいと信じ込むとハマって.…",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:46:49",
      "utterance": "はまっておられるんですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:46:59",
      "utterance": "そのこともいい加減にしろと言われ、ダメな私なんです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:47:40",
      "utterance": "そうだったんですね。何とか治したくて必死なのに…辛いですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:48:07",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:48:10",
      "utterance": "ちなみに、ご家族はどのような構成ですか?",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:49:04",
      "utterance": "両親と、兄、おばあちゃん、妹は今、お産で長く居座ってます",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:49:40",
      "utterance": "では、あなたを入れて、6人ですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:49:46",
      "utterance": "はい",
      "distress_level": 2,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:50:10",
      "utterance": "皆さん、体調のことはご存じなんですか?",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:50:41",
      "utterance": "はい、みんなに呆れられてます",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:51:05",
      "utterance": "呆れられるとは?・・・はまっているから?",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:51:52",
      "utterance": "いつまで経っても、一人前に仕事にもつけないし…",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:52:38",
      "utterance": "お仕事のことが、ずいぶん気になっておられるんですね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:52:56",
      "utterance": "焦ってしまいますね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:53:47",
      "utterance": "焦ってるけど、自分は融通がきかないのて、何でもできるわけではないんです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-12-16T19:54:06",
      "utterance": "だから、ひどいわがまま者なんです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:54:55",
      "utterance": "そうなんですか?例えばどのような事でわがままだと思われますか?",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:56:02",
      "utterance": "私は調理するのとか好きなんですけど、まず、味見が出来ないんです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-12-16T19:57:03",
      "utterance": "だから、就職しても続かないんです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:57:41",
      "utterance": "好きなことがあるのに、続けられないのは、本当に悔しいですね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:58:07",
      "utterance": "味見ができないのは?どうしてですか?",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:58:31",
      "utterance": "太るのが怖い…",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:59:07",
      "utterance": "味覚、というのではなく、太るということなんですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2020-12-16T19:59:27",
      "utterance": "それは、便秘と関係していますか?",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-16T19:59:55",
      "utterance": "はい、太ってしまうと思うと、たとえ先輩に指導されても、きけないんです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-12-16T20:00:27",
      "utterance": "だから繊維質ならきっと大丈夫って、信じてるんです",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-16T20:01:01",
      "utterance": "そんなんですね。そんなことがあったんですね。だから、繊維質なんですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2020-12-16T20:01:36",
      "utterance": "そればっかり毎日買うのは恥ずかしいから、兄に頼んでます",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-16T20:01:53",
      "utterance": "うんうん。",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-12-16T20:01:53",
      "utterance": "でも、もういい加減にしろって…",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-16T20:02:24",
      "utterance": "必死な思いが伝わらなくて、もどかしいですね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-12-16T20:02:35",
      "utterance": "ところで・・・",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2020-12-16T20:02:54",
      "utterance": "悪いのは私ですから仕方ありませんよね",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-16T20:03:14",
      "utterance": "繊維質のものを食べ続けて、効果のほどは如何ですか?",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-16T20:04:21",
      "utterance": "全然ダメだから、方法は今まで散々試したけど私には私だけの方法しかない、って思うんです",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-16T20:04:52",
      "utterance": "がっかりしましたね。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-12-16T20:05:13",
      "utterance": "他にどのような方法を試されたんですか?",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-16T20:05:32",
      "utterance": "人もいろいろアドバイスしてくれるけど、",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-16T20:05:41",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-12-16T20:05:58",
      "utterance": "水たくさん飲んだり、",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-16T20:06:09",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-12-16T20:07:06",
      "utterance": "動くのは好きなので畑をしたりです",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-16T20:07:24",
      "utterance": "すごいですね。",
      "tag": "Affirmation"
    },
    {
      "role": "counselor",
      "time": "2020-12-16T20:07:38",
      "utterance": "畑までされているんですね。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2020-12-16T20:08:31",
      "utterance": "それくらいしとかないと、親もうるさいんで、",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-12-16T20:08:50",
      "utterance": "いろいろ言われて出て行きたい",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-16T20:09:09",
      "utterance": "そうですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-16T20:09:41",
      "utterance": "だけど長続きしない、の繰り返し",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-16T20:10:02",
      "utterance": "あなた自身、辛くて苦しい体調を何とかしたくて、あれこれ試しているのに・・・",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-12-16T20:10:22",
      "utterance": "そんな気持ちになるのは自然なことだと感じますよ。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-16T20:10:31",
      "utterance": "そうかな",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-12-16T20:10:52",
      "utterance": "特におばあちゃんには酷く言われる",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-16T20:11:13",
      "utterance": "そうだったんですね。あなたは、どのように感じておられますか?",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-16T20:13:15",
      "utterance": "いつも小さい頃から、普通の子のように勤められないなんて言われ続けてきたから、やっぱり自分が悪いんだと思います",
      "distress_level": 2,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-12-16T20:14:09",
      "utterance": "小さい頃から、ずいぶん言われ続けて苦しんでこられたんですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-16T20:14:19",
      "utterance": "おばあちゃん嫌い",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-12-16T20:14:50",
      "utterance": "妹も赤ちゃんも早く帰ればいいのに",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-16T20:15:11",
      "utterance": "おばあちゃんはどんな人ですか?",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-16T20:16:07",
      "utterance": "古い頭、カチコチお母さんもなんにも言えないくらい、強いんです",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-16T20:16:23",
      "utterance": "そうなんですね。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-12-16T20:16:43",
      "utterance": "堅苦しくて、お母さんも苦労されてきたんですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-16T20:16:55",
      "utterance": "お母さんも",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-16T20:17:03",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-12-16T20:17:43",
      "utterance": "教員だから、私が仕事してないのは、いい顔しないし出て行きたい",
      "distress_level": 2,
      "disclosure_depth": 3
