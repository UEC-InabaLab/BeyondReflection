      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:57:43",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:58:03",
      "utterance": "あまり事務所には無理して配置しない方が良いのはみんなわかっているんです。",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:58:12",
      "utterance": "なるほど",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:58:57",
      "utterance": "私も最初そうでした。だから新人にはこれは仕方ないことなんですよ、、、とよーく説明したのですが、、、",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:59:05",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:59:41",
      "utterance": "奥様を注意しない私にまでとばっちりがきてしまい、、、",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:59:56",
      "utterance": "なるほど",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-07-23T13:00:31",
      "utterance": "他の男性スタッフもその新人に仕方ないことだよと教えてくれているのに、、、",
      "distress_level": 2,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-07-23T13:00:39",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-07-23T13:01:27",
      "utterance": "知的障害をお持ちの方は見た目には普通に写るかも知れませんが",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-23T13:01:48",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-07-23T13:01:58",
      "utterance": "悪気があって居眠りとかしている訳ではないんですよね、、、",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-23T13:02:05",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T13:02:11",
      "utterance": "そう思います",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T13:02:29",
      "utterance": "但し、、",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T13:02:39",
      "utterance": "（宜しいでしょうか？）",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-07-23T13:02:46",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-07-23T13:03:53",
      "utterance": "新人さんが言ってる事は、健常者であれば、やってはいけない居眠りですよね",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2020-07-23T13:04:02",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-07-23T13:04:17",
      "utterance": "周りの男性スタッフさんも新人さんに教えてるようならば、、",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2020-07-23T13:04:32",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-07-23T13:04:53",
      "utterance": "本当はこの件は、社長に一度ご相談頂くもの一つかと思いますが、いかがでしょうか？",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2020-07-23T13:05:11",
      "utterance": "あっ、なるほど！",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-07-23T13:05:16",
      "utterance": "障害者だから、居眠りを許される職場か、、",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T13:05:40",
      "utterance": "それで給料でるようなら",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T13:05:59",
      "utterance": "納得できない人もいらっしゃるかもですね",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T13:06:04",
      "utterance": "それと、、",
