      "role": "client",
      "time": "2020-07-23T13:06:24",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-07-23T13:07:00",
      "utterance": "ムーさんは非常に真面目で、気配りもあり、会社の事、同僚の事、いっぱいいろんな事を，、",
