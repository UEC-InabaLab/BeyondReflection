{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2020-08-17T17:59:42",
      "utterance": "こんにちは　相談員です。ご相談にお越しいただきありがとうございます。今日はどのようなご相談でしょうか。",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:00:45",
      "utterance": "よろしくお願いいたします。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:00:59",
      "utterance": "こちらこそ。宜しくおねがいします。",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:01:37",
      "utterance": "実家のことで頭を悩ませています。",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:01:56",
      "utterance": "家事のことで悩んでいらっしゃるのですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:02:02",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:02:31",
      "utterance": "お話しやすいところからで構わないので、どのような点でお悩みでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:03:15",
      "utterance": "兄が家を継ぐ予定だったのですが",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:03:39",
      "utterance": "お兄様が継ぐ予定だったのに？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:04:05",
      "utterance": "はい 兄が体調を崩し思うようにからだが動かず",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-08-17T18:04:31",
      "utterance": "両親に負担をかけているのが心苦しく",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-08-17T18:04:46",
      "utterance": "私は何ができるのだろうと",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:04:55",
      "utterance": "お兄様の体調が、ご両親に負担をかけてしまうのですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:05:02",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-08-17T18:05:09",
      "utterance": "本来であれば",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:05:26",
      "utterance": "本来であれば？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:05:26",
      "utterance": "兄が継いでいたので",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-08-17T18:05:34",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:05:48",
      "utterance": "そういうことですね。もしよろしければ、ご年齢と性別教えていただけないでしょうか",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:05:58",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-08-17T18:06:25",
      "utterance": "私は30代後半 女です。",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-08-17T18:06:51",
      "utterance": "兄が元気であれば",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-08-17T18:07:10",
      "utterance": "両親に楽をさせてあげられるのに",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:07:25",
      "utterance": "お兄様はそんなによろしくないのですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:07:35",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:07:47",
      "utterance": "ご心配ですよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:08:22",
      "utterance": "心配ではあります",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:08:37",
      "utterance": "一方で、ご両親に楽をさせてあげたかったんですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:08:47",
      "utterance": "そうですね",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-08-17T18:08:58",
      "utterance": "ずっと働きっぱなしで",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-08-17T18:09:17",
      "utterance": "お休みもほとんどなかったので",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:09:19",
      "utterance": "ああ、ご両親様はずっと働きっぱなしでいらっしゃったのですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:09:26",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:09:42",
      "utterance": "そんなご両親を、楽にさせてあげたい気持ちなんですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:09:55",
      "utterance": "兄が継げばゆっくりできると思っていました",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:10:30",
      "utterance": "そうなんですね。お兄様は継ぐことが出来ないご病状なのでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:10:49",
      "utterance": "できないことはないのですが",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-08-17T18:11:03",
      "utterance": "体調に変動があります",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:11:23",
      "utterance": "ご心配ですね。体調に変動があるのですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:11:35",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:11:52",
      "utterance": "お兄様とは、家を継ぐことについてご相談されているのでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:12:40",
      "utterance": "兄は小さい頃から家を継ぐ人として育っていました",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-08-17T18:12:56",
      "utterance": "周りもそう見ていました",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:13:14",
      "utterance": "ああ、そういうことですね。家を継ぐことは　大変なことなのですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:14:03",
      "utterance": "大変といえば大変ですが簡単ではないですね",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:14:17",
      "utterance": "そうなんですね。なにか稼業をされているのでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:14:24",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-08-17T18:14:57",
      "utterance": "提灯をつくっています",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:15:49",
      "utterance": "そうなんですね。お父様は後継者として、お兄様に技術をお伝えになっていたということでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:16:05",
      "utterance": "はいそうです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-08-17T18:16:22",
      "utterance": "時間の掛かることですので",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:16:46",
      "utterance": "そうですよね。日本の伝統ですよね。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:16:53",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-08-17T18:16:58",
      "utterance": "もし兄ができないのであれば",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-08-17T18:17:08",
      "utterance": "私がしなくては",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2020-08-17T18:17:18",
      "utterance": "という思いもあるのですが",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:17:33",
      "utterance": "あなたがやる　という思いなんですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:17:51",
      "utterance": "現実問題厳しいです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:18:17",
      "utterance": "厳しいのですね。それは技術の伝承ということでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:18:42",
      "utterance": "私は自分の仕事がありますし",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:19:01",
      "utterance": "そうなんですね。お仕事を持っていらっしゃるのですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:19:06",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-08-17T18:19:25",
      "utterance": "兄は辞めたわけではないので",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-08-17T18:19:49",
      "utterance": "私が出ていく状況ではないのですが",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:20:07",
      "utterance": "出ていく状況ではないけれども、ご心配なのですね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:20:28",
      "utterance": "はい 両親の負担が大きくて",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-08-17T18:20:43",
      "utterance": "この先が心配です",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:21:07",
      "utterance": "ご両親様はおいくつでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:21:32",
      "utterance": "70歳です",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:21:52",
      "utterance": "ありがとうございます。ご心配ですよね。同居されているのでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:22:23",
      "utterance": "両親と兄は同居しています",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:22:52",
      "utterance": "あなたは別に生活していらっしゃるのですね。失礼ですが、ご家族はいらっしゃいますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:23:05",
      "utterance": "はいおります。",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-08-17T18:23:20",
      "utterance": "夫と子供が1人です",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:23:43",
      "utterance": "そうなんですね。お子様もいらっしゃるのですね。ご家族とはこのことはお話されていますか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:23:52",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:24:05",
      "utterance": "旦那様は、なんておっしゃっていますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:24:12",
      "utterance": "夫とはよく話します",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-08-17T18:24:20",
      "utterance": "いつも",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-08-17T18:24:38",
      "utterance": "大変だなっと言っています",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:25:08",
      "utterance": "そうなんですね。ご相談にのってくださる旦那様、素敵ですね。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:25:16",
      "utterance": "ありがとうございます",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-08-17T18:25:35",
      "utterance": "色々理解してくれます",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:25:57",
      "utterance": "いろいろと理解して下さるのですね。では、あなたのお仕事のことも？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:26:10",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-08-17T18:26:24",
      "utterance": "家事育児協力的です",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:27:16",
      "utterance": "わぁ、すごいですね。家事育児を協力してくださるのですね。失礼ながらそのお年で、やってくださる旦那様は少ないのでは？",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:27:37",
      "utterance": "そうですかね",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-08-17T18:27:58",
      "utterance": "私よりも家事が得意です",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-08-17T18:28:08",
      "utterance": "好きなんだと思います",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:28:13",
      "utterance": "え？ますますスゴイですね。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:28:24",
      "utterance": "ありがとうございます",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:29:03",
      "utterance": "ご実家のことですが、提灯制作は、他に従業員はいらっしゃらないのでしょうか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:29:16",
      "utterance": "おります",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-08-17T18:29:35",
      "utterance": "ベテランさんもいますが",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-08-17T18:29:40",
      "utterance": "やはり",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-08-17T18:30:05",
      "utterance": "父のあとは兄が継ぐとなっていまして",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-08-17T18:30:27",
      "utterance": "大事なところは兄が引き継ぐようです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:30:40",
      "utterance": "大事なところとは？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:31:03",
      "utterance": "提灯づくりの工程で",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-08-17T18:31:11",
      "utterance": "大事なところです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-08-17T18:31:16",
      "utterance": "失礼しました",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:31:35",
      "utterance": "工程のすべてではなくて、カナメのようなところがあるんですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2020-08-17T18:31:49",
      "utterance": "失礼ですが、お兄様にはお子様は？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-08-17T18:31:51",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-08-17T18:32:05",
      "utterance": "兄は独身です",
      "distress_level": 0,
