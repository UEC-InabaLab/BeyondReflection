{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2020-12-31T10:56:06",
      "utterance": "こんにちは、相談員です。ご相談にお越しくださりありがとうございます。",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2020-12-31T10:56:17",
      "utterance": "こんにちは",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T10:56:23",
      "utterance": "今日はどのようなご相談でしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T10:56:54",
      "utterance": "恋愛相談なのですが",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "client",
      "time": "2020-12-31T10:56:58",
      "utterance": "いいですか？",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T10:57:20",
      "utterance": "はい、大丈夫ですよ。",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T10:57:47",
      "utterance": "どういったことなのか、お聞かせいただけますか…",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T10:57:48",
      "utterance": "好きな人がいるんです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-31T10:57:58",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-12-31T10:58:13",
      "utterance": "告白しなきゃと",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-12-31T10:58:22",
      "utterance": "思うんですけど",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-12-31T10:58:33",
      "utterance": "できなくて、どうしたらいいですか？",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T10:58:33",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T10:59:08",
      "utterance": "そうなんですね…勇気がいりますよね…",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T10:59:57",
      "utterance": "お力になれればと思います。まずは、あなたのことから教えていただけますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T11:00:33",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:00:49",
      "utterance": "年齢、性別とか教えていただけますか…",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T11:01:26",
      "utterance": "13歳",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-12-31T11:01:34",
      "utterance": "女子",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:01:54",
      "utterance": "教えてくれてありがとう。",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:02:25",
      "utterance": "好きな人は、どんな人なんですか…",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T11:02:56",
      "utterance": "塾が同じなんです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:05:45",
      "utterance": "そうなんですね…ちなみに、あなたが告白できないって思うのは、どんな理由からなのか教えてもらえますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T11:06:05",
      "utterance": "とても恥ずかしくて",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-12-31T11:06:10",
      "utterance": "言えないです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:07:00",
      "utterance": "うんうん、そう思うのも自然な気持ちですよね…",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-31T11:07:16",
      "utterance": "そうなんです",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "client",
      "time": "2020-12-31T11:07:30",
      "utterance": "どうしたらいいですか？",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:09:42",
      "utterance": "うんうん、悩むと思います。",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:09:47",
      "utterance": "あなたが今日ここに来られたのは、どうしたら告白できる勇気をもてるのか、知りたいという理解で合っていますか？",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2020-12-31T11:09:59",
      "utterance": "そうです",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:11:03",
      "utterance": "そうか…一緒に考えていきましょうね",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2020-12-31T11:11:14",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:12:18",
      "utterance": "さっき、恥ずかしいって言っていたけど、どんなことからそんな風に感じるのか、教えてもらえますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T11:13:15",
      "utterance": "彼が思わせぶりなことするし",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:13:28",
      "utterance": "うんうん",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-12-31T11:14:12",
      "utterance": "びっくりします。どうしたらいいか",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:14:49",
      "utterance": "そうか…思わせぶりというと、どんなことなのかしら…",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T11:15:40",
      "utterance": "おまえかわいいなとか",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-12-31T11:15:49",
      "utterance": "キスするぞとか",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2020-12-31T11:16:25",
      "utterance": "隣に座ってきたり",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:17:50",
      "utterance": "うん、そうなんですね…驚いちゃうよね…",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:17:54",
      "utterance": "彼からそんな風にされて、あなたはどう思ったりするのか、教えてもらえますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T11:18:02",
      "utterance": "恥ずかしくて",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-12-31T11:18:08",
      "utterance": "そうなんです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-12-31T11:18:47",
      "utterance": "赤くなっているかもと心配です",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:19:25",
      "utterance": "それを、彼に見られたくない、って感じなのかしら…",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-31T11:20:36",
      "utterance": "見らたらどうしよう",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:21:19",
      "utterance": "うんうん、そう思うと心配になったりするんですね…",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:22:10",
      "utterance": "今日こうしてお話しして、相談者の感じたことをお伝えしてもいいですか…",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2020-12-31T11:22:23",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:23:40",
      "utterance": "お話をうかがっていると、私には、相手の子はあなたに好意があるように感じるんですが、",
      "tag": "Inform"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:23:52",
      "utterance": "あなたはどう思われますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T11:24:17",
      "utterance": "周りにもラブラブだと言われます",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:24:54",
      "utterance": "うん、そんな風に感じましたよ。",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2020-12-31T11:25:05",
      "utterance": "ありがとうございます",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:25:34",
      "utterance": "告白しなきゃって、あなたが思っているのは、どんな理由からなのかしら…",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-12-31T11:26:23",
      "utterance": "彼と帰り道が一緒の",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-12-31T11:26:33",
      "utterance": "私の幼なじみと",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-12-31T11:26:39",
      "utterance": "彼が最近",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-12-31T11:26:45",
      "utterance": "仲がいいんです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:27:06",
      "utterance": "うわぁ…それは不安になるよね…",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-31T11:27:18",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:27:39",
      "utterance": "とられちゃうんじゃないかって、心配になりますよね…",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-12-31T11:27:50",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "client",
      "time": "2020-12-31T11:28:08",
      "utterance": "どうしたら",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:28:38",
      "utterance": "そうか…だからちゃんと告白して、自分が彼女だって認識したいんだよね…",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T11:31:45",
      "utterance": "お時間になりましたので、ここで終了させていただきます。今日は、ありがとうございました。",
      "tag": "Other"
    }
