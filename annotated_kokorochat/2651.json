      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-04T15:25:09",
      "utterance": "確かに今のままのほうがずっと一緒にいられるとおもいます",
