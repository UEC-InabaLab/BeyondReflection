      "role": "client",
      "time": "2021-11-04T15:09:19",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-04T15:10:12",
      "utterance": "もしお付き合い出来たら彼女さんとはどうするか考えてますか？",
