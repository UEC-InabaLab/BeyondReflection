    {
      "role": "client",
      "time": "2021-11-04T15:08:53",
      "utterance": "そうですね",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-04T15:09:13",
      "utterance": "友達のままではなｊく",
