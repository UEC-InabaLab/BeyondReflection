    },
    {
      "role": "client",
      "time": "2021-11-04T15:11:24",
      "utterance": "いえ、誰にも言ってません",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-04T15:12:00",
      "utterance": "なかなか相談できないですよね",
