    },
    {
      "role": "client",
      "time": "2021-11-04T15:05:20",
      "utterance": "だいたい遊ぶのは話してます",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-04T15:05:37",
      "utterance": "そうなんですね",
