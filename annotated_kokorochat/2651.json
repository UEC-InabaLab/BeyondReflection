    {
      "role": "client",
      "time": "2021-11-04T15:14:48",
      "utterance": "実名？",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-04T15:15:06",
      "utterance": "勇気がいると思うので告白は",
