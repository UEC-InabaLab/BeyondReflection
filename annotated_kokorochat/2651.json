      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-04T15:03:42",
      "utterance": "楽しそうですね。よくカラオケ行くんですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-04T15:03:53",
      "utterance": "よくではないです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-11-04T15:03:55",
      "utterance": "たまに",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-11-04T15:04:13",
      "utterance": "最近はコロナだからあまりしない",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-04T15:04:38",
      "utterance": "普段はただ話すだけが多いんでしょうか？",
