    },
    {
      "role": "client",
      "time": "2021-11-04T15:00:48",
      "utterance": "はい、同じグループです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-04T15:01:19",
      "utterance": "よく一緒に遊ぶんですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-04T15:01:42",
      "utterance": "同じグループなんで、いつも一緒にいる感じです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-04T15:02:03",
      "utterance": "どんなことして遊ぶことが多いでしょうか？",
