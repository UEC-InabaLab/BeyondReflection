    },
    {
      "role": "client",
      "time": "2021-11-04T15:07:30",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-04T15:08:32",
      "utterance": "お互い彼女もいるけど告白してお付き合いしたいということですか？",
