    },
    {
      "role": "client",
      "time": "2021-11-04T15:06:33",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-04T15:06:47",
      "utterance": "彼女同士？というと",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-11-04T15:07:10",
      "utterance": "彼女同士です。相手にも、俺にも彼女がいます",
