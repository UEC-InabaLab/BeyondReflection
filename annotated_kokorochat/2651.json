    },
    {
      "role": "client",
      "time": "2021-11-04T15:14:33",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-04T15:14:39",
      "utterance": "実名でですか",
