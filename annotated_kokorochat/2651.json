      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-04T15:17:13",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2021-11-04T15:17:16",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-04T15:18:16",
      "utterance": "ずっと友達でいたらとか色々考えてしまいますよね",
