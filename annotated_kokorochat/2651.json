    },
    {
      "role": "counselor",
      "time": "2021-11-04T14:55:49",
      "utterance": "本日よろしくお願いいたします。",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2021-11-04T14:56:10",
      "utterance": "もう初めていただいて大丈夫です。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "client",
      "time": "2021-11-04T14:56:20",
      "utterance": "よろしければ、ですが＾＾",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-11-04T14:56:32",
      "utterance": "はじめに年齢性別今日の相談したいことよろしくお願いいたします。",
      "tag": "OpenQuestion"
    },
    {
      "role": "counselor",
      "time": "2021-11-04T14:56:41",
      "utterance": "ありがとうございます",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2021-11-04T14:57:02",
      "utterance": "14、男です。",
