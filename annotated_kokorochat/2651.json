    },
    {
      "role": "client",
      "time": "2021-11-04T15:10:28",
      "utterance": "別れます",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-11-04T15:10:38",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-11-04T15:11:10",
      "utterance": "周りの友達に相談されましたか",
