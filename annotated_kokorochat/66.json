{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2020-06-22T20:22:10",
      "utterance": "こんばんは、相談員です。よろしくお願いします。",
      "tag": "Greeting"
    },
    {
      "role": "client",
      "time": "2020-06-22T20:22:21",
      "utterance": "お願いします。",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-06-22T20:22:33",
      "utterance": "今日はどういったご相談でしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-06-22T20:22:54",
      "utterance": "友人たちのことで悩んでいます。",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-06-22T20:23:28",
      "utterance": "大切なお友達のことですね。どのようなご関係でしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-06-22T20:23:53",
      "utterance": "友人とは幼なじみです。",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-06-22T20:24:33",
      "utterance": "そうなんですね。関係を大事にしたいですよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-06-22T20:24:39",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-06-22T20:25:03",
      "utterance": "何かきっかけがあったのでしょうか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-06-22T20:25:32",
      "utterance": "きっかけは",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-06-22T20:25:41",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-06-22T20:26:10",
      "utterance": "良い話を聞かなくなって",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-06-22T20:26:28",
      "utterance": "これまでは仲が良かったのですが",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-06-22T20:26:39",
      "utterance": "ええ",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-06-22T20:27:01",
      "utterance": "何かあるごとに",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-06-22T20:27:09",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-06-22T20:27:40",
      "utterance": "相手の悪口と言うか、文句なのかな、何せ良い話を言わなくて。",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-06-22T20:28:47",
      "utterance": "これまで3人で仲が良かったんです。",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-06-22T20:31:07",
      "utterance": "はい、3人で仲良くされていたのですね。",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2020-06-22T20:31:15",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-06-22T20:32:00",
      "utterance": "3人はどんな関係性ですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-06-22T20:32:08",
      "utterance": "幼なじみです。",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2020-06-22T20:32:45",
      "utterance": "それは大切にしたいですよね。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-06-22T20:32:52",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-06-22T20:33:45",
      "utterance": "お二人のうち、どなたが悪い話をされるのですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2020-06-22T20:34:03",
      "utterance": "2人ともです。",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-06-22T20:34:28",
      "utterance": "2人とも相手のことを良く言わなくて",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-06-22T20:34:39",
      "utterance": "二人とも！それを聞かされるのは辛いですよね。。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-06-22T20:34:45",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-06-22T20:34:58",
      "utterance": "これまで仲が良かったのですが",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-06-22T20:35:10",
      "utterance": "どのようなことを仰るのですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2020-06-22T20:35:43",
      "utterance": "いつもみんなで集まっていたのですが",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-06-22T20:35:53",
      "utterance": "はい",
      "tag": "Backchannel"
    },
    {
      "role": "client",
      "time": "2020-06-22T20:36:51",
      "utterance": "お互いに、1人には声を掛けないようにしたいらしく",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-06-22T20:37:11",
      "utterance": "会いたくないようで",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-06-22T20:37:45",
      "utterance": "そうなんですね。それは板挟みになってとても辛いですよね。。",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2020-06-22T20:37:54",
      "utterance": "そうなんです",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-06-22T20:38:21",
      "utterance": "裏切ったとか裏切られたとか言っていました。",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-06-22T20:38:51",
      "utterance": "自分にとっては2人とも大切で",
      "distress_level": 2,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-06-22T20:39:36",
      "utterance": "そうですよね。大切な幼馴染ですからとても心配になりますよね。。",
