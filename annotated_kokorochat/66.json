    },
    {
      "role": "client",
      "time": "2020-06-22T20:42:21",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-06-22T20:43:13",
      "utterance": "お互いに裏切られた　ということですが、何かきっかけみたいなものはあったのでしょうか？",
