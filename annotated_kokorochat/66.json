    {
      "role": "client",
      "time": "2020-06-22T20:39:47",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2020-06-22T20:40:15",
      "utterance": "どれくらい前からそのような状態になったのでしょうか？",
