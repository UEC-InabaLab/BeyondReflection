      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2020-06-22T20:46:08",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2020-06-22T20:46:45",
      "utterance": "それはますますどうしていいか分からなくなりますよね。。",
