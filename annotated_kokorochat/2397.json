{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2021-08-27T14:00:40",
      "utterance": "時間になりましたので、ロールプレイを始めさせていただきます。よろしくお願いいたします。",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:00:49",
      "utterance": "よろしくお願いいたします",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:01:05",
      "utterance": "こんにちは、相談員です。",
      "tag": "Greeting"
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:01:53",
      "utterance": "本日のご相談内容と、差し支えなければ、年齢と性別をお聞かせください。",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:02:14",
      "utterance": "休み明けに学校に行きたくありません",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-08-27T14:02:19",
      "utterance": "16 男",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:02:46",
      "utterance": "夏休み明けで、学校に行きたくないのですね",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:03:30",
      "utterance": "学校に行きたくない理由は思い当たりますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:04:16",
      "utterance": "授業が面倒くさいです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:04:56",
      "utterance": "そうなんですね。授業のどんなところが面倒くさいのですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:05:12",
      "utterance": "面白くありません",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:05:53",
      "utterance": "学校の授業が面白くないんですね",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:06:31",
      "utterance": "学校の授業、全部が面白くないのかな？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:06:38",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:07:31",
      "utterance": "例えば、特に面白くないものはありますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:08:14",
      "utterance": "多すぎて答えられません",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:10:01",
      "utterance": "体育とかはどうですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:10:28",
      "utterance": "なぜ体育なのですか",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:11:17",
      "utterance": "体を動かすのは好きな人もいるので、聞いてみたんです。",
      "tag": "Inform"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:11:34",
      "utterance": "私は好きではないのですが",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:13:13",
      "utterance": "そうでしたか。授業が面白くないのは、なぜでしょう。例えば、先生がきらいとか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:13:53",
      "utterance": "なぜと言われても、、",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:15:51",
      "utterance": "答えにくい質問でしたね",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:16:41",
      "utterance": "じゃあ、学校に行きたくないのが、授業が面白くないからと言われてましたね",
      "tag": "Paraphrase"
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:17:26",
      "utterance": "学校を面白いと感じたことはないですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:17:38",
      "utterance": "あんまりないです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:18:03",
      "utterance": "今、16歳でしたね",
      "tag": "ClosedQuestion"
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:18:15",
      "utterance": "高校1年生？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:18:18",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:18:56",
      "utterance": "学校に行きたくないと思ったのは、今が初めてですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:19:08",
      "utterance": "いいえ",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:19:18",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:19:42",
      "utterance": "いつ頃に思ったのか聞かせてもらえますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:19:52",
      "utterance": "小学生くらいからです",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:20:08",
      "utterance": "そんなころからなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:20:28",
      "utterance": "その時は、なにか気になることがあったのですか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:20:45",
      "utterance": "はっきりとは覚えていません",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:21:33",
      "utterance": "小学生の時には、学校に行くことはできていたんですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:21:47",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:22:29",
      "utterance": "なんか、もやもやして行きたくなかったけど、なんとか行っていた感じなのかな？",
      "tag": "Reflection"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:22:50",
      "utterance": "そんなところです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:23:16",
      "utterance": "中学生のころも、同じようなかんじですか？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:23:20",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:23:51",
      "utterance": "やっぱり、授業が面白くなかったから？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:24:15",
      "utterance": "そうですね",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:25:09",
      "utterance": "授業が嫌い、面白くないと思ったきっかけは、何か思い当たることがあるのかな？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:25:50",
      "utterance": "きっかけも何もそのまま感じたことですよ",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:28:08",
      "utterance": "面白い授業って、今まで経験したことがなかったということかな？",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:28:18",
      "utterance": "はい",
      "distress_level": 1,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:31:24",
      "utterance": "学校では、授業の他にもいろんな行事があると思うけれど",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:32:10",
      "utterance": "そういうのは、どうでしたか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:32:22",
      "utterance": "それも同じです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:32:39",
      "utterance": "そうなんですね",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:34:11",
      "utterance": "学校に行きたくない理由は、授業が面白くないだけでなく、学校そのものが面白くないということなのかな？",
      "tag": "Paraphrase"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:34:33",
      "utterance": "それもあるかもしれませんね",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:35:11",
      "utterance": "いま、何をしている時が楽しいのかな？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:35:34",
      "utterance": "家でゲームしてる時です",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:37:33",
      "utterance": "夏休み中は、ほとんどゲームしてすごしてたの？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:37:59",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:38:05",
      "utterance": "どんなゲームが好きなのかな？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:38:11",
      "utterance": "課題もやってましたが",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "client",
      "time": "2021-08-27T14:38:51",
      "utterance": "rpgです",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:38:55",
      "utterance": "夏休みの課題は、しっかりやってたんですね？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:39:06",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:39:53",
      "utterance": "ちなみに、課題は全部できたの？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:39:58",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:41:02",
      "utterance": "すごいね、勉強は、得意なのかな？",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:41:19",
      "utterance": "それはわかりません",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:41:40",
      "utterance": "塾とかは、行ってるの？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:41:47",
      "utterance": "行ってません",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:47:42",
      "utterance": "学校に行きたくないということ、",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:48:02",
      "utterance": "だったんですが、",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:49:27",
      "utterance": "高校にいこうと思ったのは、何か目標とかあったのかな？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:49:35",
      "utterance": "いいえ",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:50:07",
      "utterance": "将来、こんなことがしたいとかは？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:50:14",
      "utterance": "わかりません",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:52:00",
      "utterance": "好きなものは、ゲームのほかにもありますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:52:06",
      "utterance": "ありません",
      "distress_level": 0,
      "disclosure_depth": 1
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:53:34",
      "utterance": "ゲームがすきなんですね？そういう方面は興味あるのかな？",
      "tag": "ClosedQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:54:09",
      "utterance": "その方面は興味ありません",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-08-27T14:54:23",
      "utterance": "というかこれ何の話してるんです？",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:57:08",
      "utterance": "学校に行きたくないということは、逆に行かないと何か困ることがありますか？",
      "tag": "OpenQuestion"
    },
    {
      "role": "client",
      "time": "2021-08-27T14:57:57",
      "utterance": "行かない理由がないからです",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-08-27T14:58:54",
      "utterance": "用事があるので失礼します",
      "distress_level": 1,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-08-27T14:59:28",
      "utterance": "分かりました。",
      "tag": "Backchannel"
    },
    {
      "role": "counselor",
      "time": "2021-08-27T15:01:19",
      "utterance": "今日は、お時間もないようですので、これで終了いたします。また、お時間のある時に、お話を聞かせてください。ご相談ありがとうございました。",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2021-08-27T15:02:52",
      "utterance": "クライアント役、ありがとうございました。",
      "tag": "Thanking"
    },
    {
      "role": "client",
      "time": "2021-08-27T15:02:58",
      "utterance": "ありがとうございました",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-08-27T15:03:35",
      "utterance": "いろいろと勉強になりました。これから、もっと精進していきます。",
      "tag": "Other"
    },
    {
      "role": "counselor",
      "time": "2021-08-27T15:04:44",
      "utterance": "これで終了いたします",
      "tag": "Other"
    },
