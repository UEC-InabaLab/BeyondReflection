    },
    {
      "role": "client",
      "time": "2021-01-22T14:01:49",
      "utterance": "それなら話せそうです。",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-01-22T14:01:53",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "client",
      "time": "2021-01-22T14:01:58",
      "utterance": "ありがとうございました",
      "distress_level": 0,
      "disclosure_depth": 2
    },
    {
      "role": "counselor",
      "time": "2021-01-22T14:02:53",
      "utterance": "お母さんは、娘の世界で一番の理解者だからね！怖がらずに、つらいよーって話してみて♪",
      "tag": "Suggest"
    },
    {
      "role": "client",
      "time": "2021-01-22T14:03:19",
      "utterance": "つらいよーは、まだ話せないと思います",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "client",
      "time": "2021-01-22T14:03:36",
      "utterance": "けど、私の素の話なら聞けそうです",
      "distress_level": 1,
      "disclosure_depth": 3
    },
    {
      "role": "counselor",
      "time": "2021-01-22T14:03:47",
      "utterance": "そっかそっか、ゆっくりで大丈夫よ！",
      "tag": "Reflection"
    },
    {
      "role": "counselor",
      "time": "2021-01-22T14:04:17",
      "utterance": "さやさんのこと、応援しているね！つらいよーは、私にまた話てね！！",
      "tag": "Affirmation"
    },
    {
      "role": "client",
      "time": "2021-01-22T14:04:28",
      "utterance": "はい",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-01-22T14:05:14",
      "utterance": "そうしたら、お時間過ぎちゃってごめんね！つらいよーって、いつでも来てね！",
      "tag": "Other"
    },
    {
      "role": "client",
      "time": "2021-01-22T14:05:23",
      "utterance": "ありがとうございました",
      "distress_level": 0,
      "disclosure_depth": 0
    },
    {
      "role": "counselor",
      "time": "2021-01-22T14:05:28",
      "utterance": "勇気持って話に来てくれて、ありがとう！！",
      "tag": "Thanking"
    },
    {
      "role": "counselor",
      "time": "2021-01-22T14:05:57",
      "utterance": "（時間押してしまいすみませんでした。これで終了してもよろしいですか？）",
